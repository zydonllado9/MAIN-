-- Which particle layers each material uses, with relative amounts.
local FX_RECIPES = {
	Wood = { { "Splinters", 1 }, { "Dust", 0.5 } },
	Stone = { { "Dust", 1 }, { "Sparks", 0.25 } },
	Snow = { { "Snow", 1.2 } },
	Glass = { { "Shards", 1.3 }, { "Sparkle", 0.3 } },
	Energy = { { "Energy", 1 }, { "Sparks", 0.5 } },
	Metal = { { "Sparks", 1.5 }, { "Shards", 0.3 } },
	Gold = { { "Sparkle", 1.2 }, { "Sparks", 0.4 } },
	Explosive = { { "Fire", 1 }, { "Sparks", 1 }, { "Dust", 0.8 } },
}
local TIER_COUNT = { 4, 8, 14, 22 }

local fxEmitters = {} -- [name] = { Part, Emitter }
local function fxEmitter(name: string)
	local existing = fxEmitters[name]
	if existing and existing.Part.Parent then
		return existing
	end
	local holder = fxPart({ Name = "SlingFx_" .. name, Size = Vector3.new(1, 1, 1), Transparency = 1 })
	local entry = { Part = holder, Emitter = emitter(holder, FX_DEFS[name]) }
	fxEmitters[name] = entry
	return entry
end

local function emitFx(name: string, cframe: CFrame, count: number)
	if count <= 0 then
		return
	end
	local entry = fxEmitter(name)
	entry.Part.CFrame = cframe
	entry.Emitter:Emit(count)
end

--------------------------------------------------------------------------------
-- Pooled rings, pulses and lightning
--------------------------------------------------------------------------------

local RING_SEGMENTS = 12
local rings = {} -- pool: { Parts, Active, Start, Duration, CFrame, R0, R1, Thickness }
local pulses = {} -- pool: { Part, Active, Start, Duration, S0, S1 }
local bolts = {} -- pool: { Parts, Active, Start, Duration }

local function ringPoolSize(): number
	local q = Quality.Current.Name
	return if q == "High" then 10 elseif q == "Medium" then 6 else 4
end

local function getRing()
	for _, ring in rings do
		if not ring.Active then
			return ring
		end
	end
	if #rings < ringPoolSize() then
		local ring = { Parts = {}, Active = false }
		for _ = 1, RING_SEGMENTS do
			table.insert(ring.Parts, fxPart({ Name = "RingFx", Size = Vector3.new(0.5, 1, 0.5), Transparency = 1 }))
		end
		table.insert(rings, ring)
		return ring
	end
	-- Reuse the oldest ring.
	local oldest = rings[1]
	for _, ring in rings do
		if ring.Start < oldest.Start then
			oldest = ring
		end
	end
	return oldest
end

-- An expanding, fading ring in the plane of `cframe` (its local X/Y).
function Effects.Ring(cframe: CFrame, color: Color3, startRadius: number, endRadius: number, duration: number, thickness: number?)
	local ring = getRing()
	ring.Active = true
	ring.Start = os.clock()
	ring.Duration = duration
	ring.CFrame = cframe
	ring.R0 = startRadius
	ring.R1 = endRadius
	ring.Thickness = thickness or 0.8
	for _, segment in ring.Parts do
		segment.Color = color
	end
end

-- Flat ring on the ground.
function Effects.GroundRing(position: Vector3, color: Color3, startRadius: number, endRadius: number, duration: number)
	Effects.Ring(CFrame.new(position) * CFrame.Angles(math.pi / 2, 0, 0), color, startRadius, endRadius, duration, 1)
end

-- An expanding energy bubble.
function Effects.Pulse(position: Vector3, color: Color3, startSize: number, endSize: number, duration: number)
	local pulse = nil
	for _, candidate in pulses do
		if not candidate.Active then
			pulse = candidate
			break
		end
	end
	if not pulse then
		if #pulses >= 4 then
			pulse = pulses[1]
		else
			pulse = {
				Part = fxPart({
					Name = "PulseFx",
					Shape = Enum.PartType.Ball,
					Material = Enum.Material.ForceField,
					Size = Vector3.new(1, 1, 1),
					Transparency = 1,
				}),
			}
			table.insert(pulses, pulse)
		end
	end
	pulse.Active = true
	pulse.Start = os.clock()
	pulse.Duration = duration
	pulse.S0 = startSize
	pulse.S1 = endSize
	pulse.Position = position
	pulse.Part.Color = color
	pulse.Part.Transparency = 0
end

-- A jagged lightning bolt between two points that flickers out.
function Effects.Lightning(from: Vector3, to: Vector3, color: Color3, duration: number?, segments: number?)
	if not Quality.Current.Lightning then
		return
	end
	local count = segments or 6
	local bolt = nil
	for _, candidate in bolts do
		if not candidate.Active and #candidate.Parts >= count then
			bolt = candidate
			break
		end
	end
	if not bolt then
		if #bolts >= 10 then
			return
		end
		bolt = { Parts = {}, Active = false }
		for _ = 1, count do
			table.insert(bolt.Parts, fxPart({ Name = "BoltFx", Size = Vector3.new(0.25, 0.25, 1), Transparency = 1 }))
		end
		table.insert(bolts, bolt)
	end
	local length = (to - from).Magnitude
	local jitter = length * 0.12
	local previous = from
	for i = 1, #bolt.Parts do
		local segment = bolt.Parts[i]
		if i > count then
			segment.Transparency = 1
			continue
		end
		local target = if i == count
			then to
			else from + (to - from) * (i / count) + Vector3.new(rng:NextNumber(-jitter, jitter), rng:NextNumber(-jitter, jitter), rng:NextNumber(-jitter, jitter))
		local span = (target - previous).Magnitude
		segment.Size = Vector3.new(0.22, 0.22, math.max(0.1, span))
		segment.CFrame = CFrame.lookAt((previous + target) / 2, target)
		segment.Color = color
		segment.Transparency = 0
		previous = target
	end
	bolt.Active = true
	bolt.Start = os.clock()
	bolt.Duration = duration or 0.12
	bolt.Count = count
end

local function updatePools()
	local now = os.clock()
	for _, ring in rings do
		if ring.Active then
			local alpha = (now - ring.Start) / ring.Duration
			if alpha >= 1 then
				ring.Active = false
				for _, segment in ring.Parts do
					segment.Transparency = 1
				end
			else
				local eased = 1 - (1 - alpha) ^ 3
				local radius = ring.R0 + (ring.R1 - ring.R0) * eased
				local chord = 2 * radius * math.sin(math.pi / RING_SEGMENTS) + ring.Thickness * 0.5
				local thickness = ring.Thickness * (1 - alpha * 0.5)
				for i, segment in ring.Parts do
					local angle = (i / RING_SEGMENTS) * math.pi * 2
					segment.Size = Vector3.new(thickness, chord, thickness)
					segment.CFrame = ring.CFrame * CFrame.new(math.cos(angle) * radius, math.sin(angle) * radius, 0) * CFrame.Angles(0, 0, angle)
					segment.Transparency = alpha ^ 1.5
				end
			end
		end
	end
	for _, pulse in pulses do
		if pulse.Active then
			local alpha = (now - pulse.Start) / pulse.Duration
			if alpha >= 1 then
				pulse.Active = false
				pulse.Part.Transparency = 1
			else
				local size = pulse.S0 + (pulse.S1 - pulse.S0) * (1 - (1 - alpha) ^ 2)
				pulse.Part.Size = Vector3.new(size, size, size)
				pulse.Part.CFrame = CFrame.new(pulse.Position)
				pulse.Part.Transparency = alpha
			end
		end
	end
	for _, bolt in bolts do
		if bolt.Active then
			local alpha = (now - bolt.Start) / bolt.Duration
			local transparency = if alpha >= 1 then 1 else alpha * 0.8 + (if rng:NextNumber() < 0.3 then 0.3 else 0)
			for i, segment in bolt.Parts do
				if i <= bolt.Count then
					segment.Transparency = math.min(1, transparency)
				end
			end
			if alpha >= 1 then
				bolt.Active = false
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Impacts, shockwaves, launches, explosions
--------------------------------------------------------------------------------

local lastImpactRing = 0

-- A material-specific impact. tier: 1 light, 2 heavy, 3 critical, 4 maximum.
function Effects.Impact(position: Vector3, fx: string, tier: number, color: Color3)
	local recipe = FX_RECIPES[fx] or FX_RECIPES.Stone
	local base = TIER_COUNT[math.clamp(tier, 1, 4)]
	local cframe = CFrame.new(position)
	for _, layer in recipe do
		emitFx(layer[1], cframe, Quality.Amount(base * layer[2], 0))
	end
	local now = os.clock()
	if tier >= 3 and Quality.Current.Name ~= "Low" and now - lastImpactRing > 0.12 then
		lastImpactRing = now
		Effects.Ring(CFrame.lookAt(position, position + Vector3.new(0, 0, 1)), color:Lerp(Color3.new(1, 1, 1), 0.4), 1, 5 + tier * 2, 0.3, 0.5)
	end
	if tier >= 4 then
		Effects.Pulse(position, color, 2, 14, 0.35)
	end
end

-- Layered rings, a bubble, dust and sparks: the Devastation look.
function Effects.Shockwave(position: Vector3, radius: number, color: Color3)
	local ground = Vector3.new(position.X, Config.GroundY + 0.5, position.Z)
	Effects.GroundRing(ground, color, 2, radius, 0.45)
	Effects.GroundRing(ground, Color3.new(1, 1, 1), 1, radius * 0.7, 0.35)
	task.delay(0.08, function()
		Effects.GroundRing(ground, color, 1, radius * 1.15, 0.55)
	end)
	Effects.Pulse(position, color, 3, radius * 1.6, 0.4)
	local cframe = CFrame.new(position)
	emitFx("Dust", CFrame.new(ground), Quality.Amount(26))
	emitFx("Sparks", cframe, Quality.Amount(30))
	emitFx("Energy", cframe, Quality.Amount(14))
	Effects.Flash(color, 0.35)
	Effects.Shake(2)
	Effects.Play("Shockwave", 1, 1, true)
end

-- Launch burst scaled by power: rings, sparks and speed streaks.
function Effects.Launch(position: Vector3, direction: Vector3, power: number)
	local facing = CFrame.lookAt(position, position + direction)
	local cyan = Color3.fromRGB(140, 240, 255)
	Effects.Ring(facing, cyan, 1, 5 + power * 9, 0.35, 0.9)
	Effects.GroundRing(Config.SlingshotPosition + Vector3.new(0, 0.9, 0), Color3.fromRGB(255, 226, 120), 3, 8 + power * 14, 0.5)
	emitFx("Sparks", CFrame.new(position), Quality.Amount(8 + power * 22))
	emitFx("Streaks", facing, Quality.Amount(10 + power * 30))
	if power >= 0.99 then
		task.delay(0.07, function()
			Effects.Ring(facing * CFrame.new(0, 0, -4), Color3.new(1, 1, 1), 1, 16, 0.4, 1.2)
		end)
		Effects.Pulse(position, cyan, 2, 14, 0.3)
		Effects.Flash(Color3.fromRGB(200, 250, 255), 0.45)
	else
		Effects.Flash(Color3.fromRGB(255, 255, 255), 0.12 + power * 0.18)
	end
	Effects.Shake(0.4 + power * 1.2)
end

-- Nitro activation: rings and a bubble along the direction of travel.
function Effects.NitroBurst(position: Vector3, direction: Vector3)
	local facing = CFrame.lookAt(position, position + direction)
	local cyan = Color3.fromRGB(80, 230, 255)
	Effects.Ring(facing, cyan, 2, 12, 0.35, 0.9)
	task.delay(0.06, function()
		Effects.Ring(facing * CFrame.new(0, 0, 5), Color3.new(1, 1, 1), 1.5, 9, 0.3, 0.6)
	end)
	Effects.Pulse(position, cyan, 2, 10, 0.25)
	emitFx("Energy", CFrame.new(position), Quality.Amount(18))
	emitFx("Streaks", facing, Quality.Amount(24))
	Effects.Flash(cyan, 0.25)
	Effects.Play("Nitro", 1, 1, true)
	Effects.Shake(1)
end

-- Client-side explosion: purely visual, never hurts anyone.
function Effects.Explosion(position: Vector3, radius: number)
	local explosion = Instance.new("Explosion")
	explosion.Position = position
	explosion.BlastRadius = radius
	explosion.BlastPressure = 0
	explosion.DestroyJointRadiusPercent = 0
	explosion.ExplosionType = Enum.ExplosionType.NoCraters
	explosion.Parent = Workspace
	Effects.Impact(position, "Explosive", 3, Color3.fromRGB(255, 140, 40))
	Effects.GroundRing(Vector3.new(position.X, Config.GroundY + 0.4, position.Z), Color3.fromRGB(255, 150, 50), 2, radius * 1.3, 0.4)
end

--------------------------------------------------------------------------------
-- Slingshot charge-up
--------------------------------------------------------------------------------

local charge = nil -- { Holder, Emitter, Light, Core, CoreLight, CoreSize, CoreColor }

local function slingCore(): (BasePart?, PointLight?)
	local map = Workspace:FindFirstChild("Map")
	local slingshot = map and map:FindFirstChild("Slingshot")
	local core = slingshot and slingshot:FindFirstChild("Core")
	if core and core:IsA("BasePart") then
		local light = core:FindFirstChildOfClass("PointLight")
		return core, light
	end
	return nil, nil
end

function Effects.StartCharge(position: Vector3)
	Effects.StopCharge()
	local holder = fxPart({ Name = "ChargeFx", Size = Vector3.new(7, 7, 7), Transparency = 1, CFrame = CFrame.new(position) })
	local swirl = emitter(holder, {
		Shape = Enum.ParticleEmitterShape.Sphere,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface,
		ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
		Lifetime = NumberRange.new(0.35, 0.55),
		Speed = NumberRange.new(6, 10),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) }),
		LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(120, 230, 255), Color3.fromRGB(255, 255, 255)),
	})
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(120, 230, 255)
	light.Range = 14
	light.Brightness = 0
	light.Parent = holder
	local core, coreLight = slingCore()
	charge = {
		Holder = holder,
		Emitter = swirl,
		Light = light,
		Core = core,
		CoreLight = coreLight,
		CoreSize = if core then core.Size else nil,
		CoreColor = if core then core.Color else nil,
		Overcharged = false,
	}
	if chargeHum and Effects.Settings.SFX then
		chargeHum.Volume = 0
		chargeHum:Play()
	end
end

-- power 0..1. Energy gathers faster and brighter as you pull back.
function Effects.UpdateCharge(position: Vector3, power: number)
	local c = charge
	if not c then
		return
	end
	local pulse = 0.5 + 0.5 * math.sin(os.clock() * (6 + power * 14))
	c.Holder.CFrame = CFrame.new(position)
	c.Emitter.Rate = Quality.Amount(10 + 110 * power * power, 0)
	local hot = Color3.fromRGB(120, 230, 255):Lerp(Color3.fromRGB(255, 240, 160), math.max(0, power - 0.7) / 0.3)
	c.Light.Color = hot
	c.Light.Brightness = power * 3 + pulse * power * 2
	if c.Core and c.CoreSize then
		local grow = 1 + power * 0.7 + pulse * 0.15 * power
		c.Core.Size = c.CoreSize * grow
		c.Core.Color = (c.CoreColor :: Color3):Lerp(hot, power)
		if c.CoreLight then
			c.CoreLight.Brightness = 1.2 + power * 4
		end
	end
	if chargeHum then
		chargeHum.PlaybackSpeed = 0.8 + power
		chargeHum.Volume = 0.15 + power * 0.35
	end
end

-- The burst at 100%: a ring, a bubble and a flash.
function Effects.Overcharge(position: Vector3)
	local gold = Color3.fromRGB(255, 230, 120)
	Effects.Ring(CFrame.lookAt(position, position + Config.Forward), gold, 1, 9, 0.35, 0.8)
	Effects.Pulse(position, gold, 2, 9, 0.3)
	emitFx("Sparkle", CFrame.new(position), Quality.Amount(20))
	Effects.Flash(gold, 0.2)
	Effects.Play("Victory", 1.3, 0.8, true)
	Effects.Shake(0.5)
end

function Effects.StopCharge()
	local c = charge
	if not c then
		return
	end
	charge = nil
	c.Emitter.Rate = 0
	Debris:AddItem(c.Holder, 1)
	if c.Core and c.CoreSize then
		c.Core.Size = c.CoreSize
		c.Core.Color = c.CoreColor :: Color3
		if c.CoreLight then
			c.CoreLight.Brightness = 1.2
		end
	end
	if chargeHum then
		chargeHum:Stop()
	end
end

--------------------------------------------------------------------------------
-- Power-up auras (Meteor / Rift / Phase) and Nitro thrust
--------------------------------------------------------------------------------

local aura = nil -- { Kind, Parts, Spin, Ghosts, Highlight, ... }
local nitroTrail: Trail? = nil
local nitroHolder: BasePart? = nil
local lastBolt = 0

-- Afterimage clones are built once per character and reused for every Phase.
local ghostCache = nil -- { Character, Count, Sets }

local function hideGhosts(sets)
	for _, set in sets do
		set.Born = -10
		for _, entry in set.Parts do
			entry.Ghost.Transparency = 1
		end
	end
end

local function destroyGhosts()
	if ghostCache then
		for _, set in ghostCache.Sets do
			for _, entry in set.Parts do
				entry.Ghost:Destroy()
			end
		end
		ghostCache = nil
	end
end

local function buildGhosts(character: Model, sets: number)
	local sources = {}
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency < 0.9 then
			table.insert(sources, d)
			if #sources >= 18 then
				break
			end
		end
	end
	local ghosts = {}
	for _ = 1, sets do
		local set = { Parts = {}, Born = -10 }
		for _, source in sources do
			local ok, ghost = pcall(function()
				return source:Clone()
			end)
			if ok and ghost then
				for _, child in ghost:GetChildren() do
					child:Destroy()
				end
				ghost.Anchored = true
				ghost.CanCollide = false
				ghost.CanQuery = false
				ghost.CanTouch = false
				ghost.CastShadow = false
				ghost.Material = Enum.Material.Neon
				ghost.Color = Color3.fromRGB(120, 255, 255)
				ghost.Transparency = 1
				if ghost:IsA("MeshPart") then
					ghost.TextureID = ""
				end
				ghost.Parent = folder()
				table.insert(set.Parts, { Ghost = ghost, Source = source })
			end
		end
		table.insert(ghosts, set)
	end
	return ghosts
end

function Effects.StopAura()
	local a = aura
	if not a then
		return
	end
	aura = nil
	for _, p in a.Parts do
		p:Destroy()
	end
	if a.Highlight then
		a.Highlight:Destroy()
	end
	if a.Ghosts then
		hideGhosts(a.Ghosts)
	end
	Effects.SetAbilityTint(nil)
	Effects.SetSpeedLineColor(Color3.new(1, 1, 1))
end

-- Starts the look for a power-up. kind: "Meteor" | "Rift" | "Phase".
function Effects.StartAura(kind: string, character: Model?)
	Effects.StopAura()
	local ability = Config.Abilities[kind]
	if not ability then
		return
	end
	local color = ability.Color
	local a = { Kind = kind, Parts = {}, Spin = 0, Ghosts = nil, NextGhost = 0, GhostIndex = 1 }
	aura = a

	local function add(p: BasePart): BasePart
		table.insert(a.Parts, p)
		return p
	end

	if kind == "Meteor" then
		local glow = add(fxPart({ Name = "MeteorGlow", Shape = Enum.PartType.Ball, Size = Vector3.new(3.6, 3.6, 3.6), Color = Color3.fromRGB(255, 170, 60), Transparency = 0.35 }))
		add(fxPart({ Name = "MeteorShell", Shape = Enum.PartType.Ball, Material = Enum.Material.ForceField, Size = Vector3.new(6.5, 6.5, 6.5), Color = color }))
		local fire = Instance.new("Fire")
		fire.Size = 7
		fire.Heat = 15
		fire.Color = Color3.fromRGB(255, 160, 40)
		fire.SecondaryColor = Color3.fromRGB(255, 50, 20)
		fire.Parent = glow
		local smoke = Instance.new("Smoke")
		smoke.Color = Color3.fromRGB(60, 50, 50)
		smoke.Opacity = 0.12
		smoke.RiseVelocity = 2
		smoke.Size = 3
		smoke.Parent = glow
		emitter(glow, {
			Rate = Quality.Amount(30, 0),
			Lifetime = NumberRange.new(0.5, 0.9),
			Speed = NumberRange.new(2, 6),
			SpreadAngle = Vector2.new(180, 180),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) }),
			LightEmission = 1,
			Color = ColorSequence.new(Color3.fromRGB(255, 230, 120), Color3.fromRGB(255, 80, 20)),
		})
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = 18
		light.Brightness = 3
		light.Parent = glow
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(-1.6, 0, 0)
		a0.Parent = glow
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(1.6, 0, 0)
		a1.Parent = glow
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Lifetime = 0.45
		trail.LightEmission = 1
		trail.FaceCamera = true
		trail.Color = ColorSequence.new(Color3.fromRGB(255, 220, 90), Color3.fromRGB(255, 40, 20))
		trail.Transparency = NumberSequence.new(0.1, 1)
		trail.WidthScale = NumberSequence.new(1, 0.1)
		trail.Parent = glow
		Effects.SetAbilityTint(Color3.fromRGB(255, 232, 214), 0.1)
		Effects.SetSpeedLineColor(Color3.fromRGB(255, 190, 120))
	elseif kind == "Rift" then
		add(fxPart({ Name = "RiftShell", Shape = Enum.PartType.Ball, Material = Enum.Material.ForceField, Size = Vector3.new(10, 10, 10), Color = color }))
		-- Glass refracts what's behind it: a cheap, real "warped space" look.
		add(fxPart({ Name = "RiftLens", Shape = Enum.PartType.Ball, Material = Enum.Material.Glass, Size = Vector3.new(7, 7, 7), Color = Color3.fromRGB(200, 170, 255), Transparency = 0.55 }))
		a.RingParts = {}
		for r = 1, 2 do
			for i = 1, RING_SEGMENTS do
				local segment = add(fxPart({ Name = "RiftRing", Size = Vector3.new(0.4, 1.6, 0.4), Color = if r == 1 then color else Color3.fromRGB(90, 160, 255) }))
				table.insert(a.RingParts, { Part = segment, Ring = r, Index = i })
			end
		end
		local well = add(fxPart({ Name = "RiftWell", Size = Vector3.new(22, 22, 22), Transparency = 1 }))
		emitter(well, {
			Rate = Quality.Amount(40, 0),
			Shape = Enum.ParticleEmitterShape.Sphere,
			ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface,
			ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
			Lifetime = NumberRange.new(0.8, 1.1),
			Speed = NumberRange.new(10, 14),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.5, 0.8), NumberSequenceKeypoint.new(1, 0) }),
			LightEmission = 1,
			Color = ColorSequence.new(Color3.fromRGB(220, 170, 255), color),
		})
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = 20
		light.Brightness = 2.5
		light.Parent = well
		Effects.SetAbilityTint(Color3.fromRGB(230, 214, 255), -0.1)
		Effects.SetSpeedLineColor(Color3.fromRGB(200, 160, 255))
	elseif kind == "Phase" then
		add(fxPart({ Name = "PhaseShell", Shape = Enum.PartType.Ball, Material = Enum.Material.ForceField, Size = Vector3.new(7.5, 7.5, 7.5), Color = color }))
		if character then
			local highlight = Instance.new("Highlight")
			highlight.Adornee = character
			highlight.FillColor = color
			highlight.FillTransparency = 0.7
			highlight.OutlineColor = Color3.fromRGB(230, 255, 255)
			highlight.OutlineTransparency = 0
			highlight.DepthMode = Enum.HighlightDepthMode.Occluded
			highlight.Parent = folder()
			a.Highlight = highlight
			local count = Quality.Current.Afterimages
			local cache = ghostCache
			if not cache or cache.Character ~= character or cache.Count ~= count or not character.Parent then
				destroyGhosts()
				cache = { Character = character, Count = count, Sets = buildGhosts(character, count) }
				ghostCache = cache
			end
			a.Ghosts = (cache :: any).Sets
		end
		Effects.SetAbilityTint(Color3.fromRGB(214, 250, 255), -0.15)
		Effects.SetSpeedLineColor(Color3.fromRGB(170, 255, 255))
	end
end

-- Called every frame while flying with the flyer's CFrame and velocity.
function Effects.UpdateFlight(cframe: CFrame, velocity: Vector3, dt: number, thrusting: boolean)
	local position = cframe.Position
	local now = os.clock()
	local a = aura
	if a then
		a.Spin += dt
		for _, p in a.Parts do
			if p.Name ~= "RiftRing" then
				p.CFrame = CFrame.new(position)
			end
		end
		if a.RingParts then
			for _, entry in a.RingParts do
				local tilt = if entry.Ring == 1 then CFrame.Angles(math.rad(70), a.Spin * 2.2, 0) else CFrame.Angles(math.rad(-50), -a.Spin * 3, math.rad(40))
				local angle = (entry.Index / RING_SEGMENTS) * math.pi * 2
				local radius = if entry.Ring == 1 then 6.5 else 5
				entry.Part.CFrame = CFrame.new(position) * tilt * CFrame.new(math.cos(angle) * radius, math.sin(angle) * radius, 0) * CFrame.Angles(0, 0, angle)
			end
		end
		if a.Ghosts and #a.Ghosts > 0 then
			if now >= a.NextGhost then
				a.NextGhost = now + 0.07
				local set = a.Ghosts[a.GhostIndex]
				a.GhostIndex = a.GhostIndex % #a.Ghosts + 1
				set.Born = now
				for _, entry in set.Parts do
					if entry.Source.Parent then
						entry.Ghost.Size = entry.Source.Size
						entry.Ghost.CFrame = entry.Source.CFrame
						entry.Ghost.Transparency = 0.45
					end
				end
			end
			for _, set in a.Ghosts do
				local alpha = (now - set.Born) / 0.35
				if alpha <= 1.05 then
					for _, entry in set.Parts do
						entry.Ghost.Transparency = math.min(1, 0.45 + 0.55 * alpha)
					end
				end
			end
		end
	end

	-- Nitro: a cyan trail and crackling bolts while thrusting.
	local holder = nitroHolder
	if not holder or not holder.Parent then
		holder = fxPart({ Name = "NitroFx", Size = Vector3.new(1, 1, 1), Transparency = 1 })
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(-1.4, 0, 0)
		a0.Parent = holder
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(1.4, 0, 0)
		a1.Parent = holder
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Lifetime = 0.35
		trail.LightEmission = 1
		trail.FaceCamera = true
		trail.Color = ColorSequence.new(Color3.fromRGB(220, 255, 255), Color3.fromRGB(40, 140, 255))
		trail.Transparency = NumberSequence.new(0, 1)
		trail.WidthScale = NumberSequence.new(1, 0.2)
		trail.Enabled = false
		trail.Parent = holder
		nitroHolder = holder
		nitroTrail = trail
	end
	holder.CFrame = cframe
	if nitroTrail then
		nitroTrail.Enabled = thrusting
	end
	if thrusting and now - lastBolt > 0.05 and velocity.Magnitude > 1 then
		lastBolt = now
		local back = -velocity.Unit
		local offset = Vector3.new(rng:NextNumber(-2, 2), rng:NextNumber(-2, 2), rng:NextNumber(-2, 2))
		Effects.Lightning(position + offset * 0.5, position + back * rng:NextNumber(6, 11) + offset, Color3.fromRGB(140, 240, 255), 0.1, 5)
	end
end

function Effects.EndFlight()
	Effects.StopAura()
	if nitroTrail then
		nitroTrail.Enabled = false
	end
end

--------------------------------------------------------------------------------
-- Setup
--------------------------------------------------------------------------------

function Effects.Init(playerGui: Instance)
	sfxGroup = Instance.new("SoundGroup")
	local group = sfxGroup :: SoundGroup
	group.Name = "SlingSFX"
	group.Volume = 0.9
	group.Parent = SoundService
	-- Gentle compression keeps big chains from clipping.
	local compressor = Instance.new("CompressorSoundEffect")
	compressor.Threshold = -14
	compressor.Ratio = 3
	compressor.Attack = 0.01
	compressor.Release = 0.15
	compressor.Parent = group

	local list = {}
	for name, id in Config.Sounds do
		if name ~= "Music" and name ~= "Wind" then
			local sound = makeSound(name, id, 0.5, false, group)
			if sound then
				templates[name] = sound
				table.insert(list, sound)
			end
		end
	end
	wind = makeSound("Wind", Config.Sounds.Wind, 0, true, group)
	music = makeSound("Music", Config.Sounds.Music, 0.35, true, nil)
	chargeHum = makeSound("ChargeHum", Config.Sounds.Charge, 0, true, group)
	for _, sound in { wind, chargeHum } do
		if sound then
			table.insert(list, sound)
		end
	end
	preloadSounds(list)

	local gui = Widgets.new("ScreenGui", {
		Name = "SlingEffects",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = -1,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Enabled = false,
		Parent = playerGui,
	})
	speedGui = gui
	for i = 1, Config.Quality.High.SpeedLines do
		local line = Widgets.new("Frame", {
			Name = "Line" .. i,
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(3, rng:NextInteger(70, 180)),
			BackgroundTransparency = 1,
			Parent = gui,
		})
		table.insert(speedLines, {
			Frame = line,
			Angle = rng:NextNumber(0, math.pi * 2),
			Radius = rng:NextNumber(0.2, 0.8),
			Speed = rng:NextNumber(0.9, 1.6),
			Color = Color3.new(1, 1, 1),
		})
	end

	local flashGui = Widgets.new("ScreenGui", {
		Name = "SlingFlash",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 50,
		Parent = playerGui,
	})
	flashFrame = Widgets.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = flashGui,
	})

	local tint = Instance.new("ColorCorrectionEffect")
	tint.Name = "SlingAbilityTint"
	tint.TintColor = Color3.new(1, 1, 1)
	tint.Parent = Lighting
	abilityTint = tint

	RunService.RenderStepped:Connect(updatePools)
	Effects.ApplySettings(Effects.Settings)
end

function Effects.ApplySettings(settings)
	for key, value in settings do
		Effects.Settings[key] = value
	end
	if music then
		if Effects.Settings.Music then
			if not music.IsPlaying then
				music:Play()
			end
		else
			music:Stop()
		end
	end
	if not Effects.Settings.SpeedLines and speedGui then
		speedGui.Enabled = false
	end
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">FlightEvents</string>
            <string name="Source"><![CDATA[--[[
	Turns RunSim events into visuals, sound, camera kicks and HUD pops.

	The flight script owns the state; this module just reacts. Kept separate so
	the smoke test can run whole flights through it outside Roblox.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Effects = require(script.Parent.Effects)
local Quality = require(script.Parent.Quality)
local UI = require(script.Parent.UI)

local FlightEvents = {}

local rng = Random.new()

--[[
	ctx = {
		Course: the client Course,
		GetRun: () -> RunSim?,
		GetFlight: () -> flight presentation state? (FovKick, SlowMo, HitStop...),
		GetCharacter: () -> Model?,
		CameraEffectsOn: () -> boolean,
	}
]]
function FlightEvents.new(ctx)
	local course = ctx.Course

	-- Adds a field-of-view kick to the current flight.
	local function kick(amount: number)
		local f = ctx.GetFlight()
		if f then
			f.FovKick = math.max(f.FovKick, amount)
		end
	end

	local FX_BY_KIND = { Gold = "Gold", Ice = "Glass", Armor = "Metal", TNT = "Explosive" }
	local POP_BY_ABILITY = { Meteor = "meteor", Rift = "rift", Phase = "phase", Shockwave = "shock" }

	local lastPop = 0
	-- Pop text, but never more than a few per second.
	local function pop(text: string, style: string, force: boolean?)
		local now = os.clock()
		if force or now - lastPop > 0.35 then
			lastPop = now
			UI.Pop(text, style)
		end
	end

	local function hitStop(duration: number)
		local f = ctx.GetFlight()
		if not f or not Quality.Current.HitStop or not ctx.CameraEffectsOn() then
			return
		end
		local now = os.clock()
		if now - f.LastHitStop > 0.8 then
			f.LastHitStop = now
			f.HitStop = math.max(f.HitStop, duration)
		end
	end

	local events = {}

	function events.OnSmash(block, info)
		local f = ctx.GetFlight()
		course:Smash(block, info.Velocity)
		local entry = course.Blocks[block.Id]
		local color = if entry then entry.Color else Color3.new(1, 1, 1)
		local zone = Config.Zones[block.Zone]
		local fx = FX_BY_KIND[block.Kind] or zone.BlockFx
		local tier = info.Tier
		Effects.Impact(block.Position, fx, tier, color)
		local chipKey = if block.Kind == "Block" then "Block:" .. block.Zone .. ":" .. block.ColorIndex else block.Kind
		Effects.Burst(block.Position, chipKey, color, 3 + tier * 2)

		if fx == "Glass" then
			Effects.Play("Shatter", rng:NextNumber(0.85, 1.2))
		elseif fx == "Metal" then
			Effects.Play("Clang", rng:NextNumber(0.9, 1.1))
		else
			Effects.Play("Smash", rng:NextNumber(0.85, 1.35) * (if tier >= 3 then 0.8 else 1), 0.8 + tier * 0.1)
		end

		local textColor = if info.Cause == "rift" then Color3.fromRGB(210, 170, 255) else Color3.fromRGB(220, 150, 255)
		if info.Crit then
			pop("CRITICAL!", "crit")
			Effects.FloatText(block.Position + Vector3.new(0, 3, 0), "+" .. Format.Short(info.Coins), Color3.fromRGB(255, 170, 40), 1.4)
		else
			Effects.FloatText(block.Position + Vector3.new(0, 2, 0), "+" .. Format.Short(info.Coins), textColor, 1)
		end

		if info.Cause == "hit" then
			if tier >= 4 then
				Effects.Shake(1.6)
				hitStop(0.05)
				if f and os.clock() - f.LastBigPop > 2 then
					f.LastBigPop = os.clock()
					pop("DEVASTATING!", "shock")
				end
			elseif tier >= 3 then
				Effects.Shake(0.9)
			else
				Effects.Shake(0.3)
			end
		end
		if block.Kind == "Armor" and info.Cause == "hit" then
			pop("🛡️ ARMOR BROKEN!", "crit", true)
		end
	end

	function events.OnBonk(block, _speed)
		course:FlashBlock(block, Color3.new(1, 1, 1))
		Effects.Impact(block.Position, "Metal", 3, Color3.fromRGB(170, 170, 190))
		Effects.Play("Clang", 0.8, 1, true)
		Effects.Shake(1.4)
		pop("🛡️ ARMORED! NEED SPEED", "zap", true)
		local f = ctx.GetFlight()
		if f and not f.BonkTipShown then
			f.BonkTipShown = true
			UI.Toast("Armor breaks at high speed, with ☄️ Meteor, TNT or 💥 shockwaves")
		end
	end

	function events.OnPhase(block)
		course:FlashBlock(block, Color3.fromRGB(120, 255, 255), 0.7)
		Effects.Burst(block.Position, "phase", Color3.fromRGB(120, 255, 255), 4)
	end

	function events.OnExplode(position: Vector3, chain: number)
		if chain <= 4 then
			Effects.Explosion(position, Config.Blocks.TNT.BlastRadius)
			Effects.Play("Boom", rng:NextNumber(0.9, 1.1), 1, chain == 1)
		end
		if chain == 1 then
			Effects.Shake(2.2)
			Effects.Flash(Color3.fromRGB(255, 170, 60), 0.35)
			pop("BOOM!", "crit", true)
			kick(10)
		end
	end

	function events.OnStar(star, coins: number)
		course:CollectStar(star.Id)
		Effects.Play("Coin", 1.25)
		Effects.Flash(Color3.fromRGB(255, 225, 90), 0.25)
		Effects.Impact(star.Position, "Gold", 2, Color3.fromRGB(255, 214, 40))
		Effects.FloatText(star.Position, "⭐ +" .. Format.Short(coins), Color3.fromRGB(255, 220, 60), 1.6)
	end

	function events.OnRing(ring)
		course:UseRing(ring.Id)
		local radius = if ring.Big then Config.BigRingRadius else Config.RingRadius
		kick(if ring.Big then 18 else 14)
		pop(if ring.Big then "⚡ ACCELERATE!" else "BOOST!", "boost", true)
		Effects.Ring(CFrame.lookAt(ring.Position, ring.Position + Config.Forward), Color3.fromRGB(120, 240, 255), radius, radius * 1.9, 0.35, 1)
		Effects.Flash(Color3.fromRGB(80, 230, 255), 0.3)
		Effects.Play("Launch", 1.55)
		Effects.Shake(0.8)
	end

	function events.OnPickup(pickup)
		course:TakePickup(pickup.Id)
		local ability = Config.Abilities[pickup.Kind]
		Effects.Play("Pickup", 1, 1, true)
		Effects.Pulse(pickup.Position, ability.Color, 3, 14, 0.35)
		Effects.Ring(CFrame.lookAt(pickup.Position, pickup.Position + Config.Forward), ability.Color, 2, 10, 0.35, 0.8)
		pop(ability.Icon .. " " .. ability.Name .. "!", POP_BY_ABILITY[pickup.Kind] or "boost", true)
	end

	function events.OnAbility(kind: string)
		Effects.StartAura(kind, ctx.GetCharacter())
		UI.SetAbility(kind, 1)
		kick(10)
	end

	function events.OnAbilityEnd(_kind: string)
		Effects.StopAura()
		UI.SetAbility(nil)
		Effects.Play("PowerDown")
	end

	function events.OnShockwave(position: Vector3, radius: number, cause: string)
		local color = if cause == "slam" then Color3.fromRGB(255, 170, 70) else Config.Abilities.Shockwave.Color
		Effects.Shockwave(position, radius, color)
		if cause == "slam" then
			pop("GROUND SLAM!", "crit", true)
		else
			pop("💥 DEVASTATION!", "shock", true)
		end
		hitStop(0.07)
		kick(12)
	end

	function events.OnBoost()
		local r = ctx.GetRun()
		if not r then
			return
		end
		local direction = if r.Velocity.Magnitude > 1 then r.Velocity.Unit else Config.Forward
		Effects.NitroBurst(r.Position, direction)
		UI.SetBoosts(r.Boosts)
		pop("⚡ NITRO!", "nitro", true)
		kick(14)
	end

	local lastBounceFx = 0
	function events.OnBounce(speed: number)
		local r = ctx.GetRun()
		local now = os.clock()
		if not r or now - lastBounceFx < 0.15 then
			return
		end
		lastBounceFx = now
		local zone = Config.Zones[r.Zone]
		local fx = if zone.Key == "Frozen" then "Snow" else "Stone"
		local tier = if speed > 60 then 3 elseif speed > 35 then 2 else 1
		Effects.Impact(Vector3.new(r.Position.X, Config.GroundY + 0.5, r.Position.Z), fx, tier, Color3.fromRGB(200, 190, 170))
		Effects.Play("Thud", math.clamp(1.2 - speed / 120, 0.6, 1.2))
		Effects.Shake(math.clamp(speed / 60, 0.3, 1.2))
	end

	function events.OnLava(position: Vector3)
		Effects.Impact(position, "Explosive", 2, Color3.fromRGB(255, 120, 30))
		Effects.Play("Eruption", 1.7, 0.4)
		pop("🔥 HOT FLOOR!", "meteor")
	end

	function events.OnPad(pad)
		course:BouncePad(pad.Id)
		Effects.GroundRing(pad.Position + Vector3.new(0, 0.8, 0), Color3.fromRGB(140, 255, 140), 2, 11, 0.35)
		Effects.Play("Pad")
		pop("BOING!", "max", true)
		kick(10)
	end

	function events.OnGeyser(geyser)
		Effects.Impact(geyser.Position + Vector3.new(0, 4, 0), "Explosive", 3, Color3.fromRGB(255, 130, 40))
		Effects.Play("Eruption", 1, 1, true)
		pop("🌋 ERUPTION!", "meteor", true)
		Effects.Shake(1.2)
		kick(14)
	end

	function events.OnUpdraft(_updraft)
		Effects.Play("Launch", 0.6, 0.5)
		pop("🌬️ UPDRAFT!", "boost")
	end

	function events.OnBarrier(barrier, phased: boolean)
		course:HitBarrier(barrier.Id, phased)
		local r = ctx.GetRun()
		if phased then
			pop("👻 PHASED!", "phase", true)
			Effects.Play("Zap", 1.8)
			if r then
				Effects.Ring(CFrame.lookAt(r.Position, r.Position + Config.Forward), Color3.fromRGB(120, 255, 255), 2, 10, 0.3, 0.6)
			end
		else
			pop("⚡ ZAPPED!", "zap", true)
			Effects.Play("Zap", 1, 1, true)
			Effects.Flash(Color3.fromRGB(255, 60, 80), 0.35)
			Effects.Shake(1.5)
			if r then
				for _ = 1, 3 do
					local offset = Vector3.new(rng:NextNumber(-4, 4), rng:NextNumber(-2, 4), rng:NextNumber(-2, 2))
					Effects.Lightning(r.Position + offset, r.Position - offset, Color3.fromRGB(255, 120, 140), 0.15, 4)
				end
			end
		end
	end

	function events.OnLog(log, phased: boolean)
		if phased then
			pop("👻 PHASED!", "phase", true)
			Effects.Play("Zap", 1.8)
			return
		end
		local r = ctx.GetRun()
		pop("🪵 WHACK!", "crit", true)
		Effects.Play("Thud", 0.55, 1, true)
		Effects.Shake(1.6)
		if r then
			Effects.Impact(r.Position, "Wood", 3, Color3.fromRGB(130, 90, 56))
		end
		kick(8)
	end

	function events.OnSlowMo(duration: number)
		local f = ctx.GetFlight()
		if f then
			f.SlowMo = math.max(f.SlowMo, duration)
		end
	end

	function events.OnZone(index: number)
		local zone = Config.Zones[index]
		UI.Banner(zone.Icon .. " " .. string.upper(zone.Name), zone.BannerColor)
		Effects.Flash(zone.BannerColor, 0.15)
		Effects.Play("Victory", 0.9, 0.5)
	end

	return events
end

return FlightEvents
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Quality</string>
            <string name="Source"><![CDATA[--[[
	Picks an effects budget (Config.Quality.High / Medium / Low) for this
	device. Performance Mode in Settings always means Low; otherwise phones and
	low graphics settings get a lighter budget automatically.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)

local Quality = {}

Quality.Current = Config.Quality.High
local listeners: { (any) -> () } = {}

-- The player's Roblox graphics level (1-10), or nil when it's "Automatic".
local function graphicsLevel(): number?
	local ok, level = pcall(function()
		local setting = (UserSettings() :: any).GameSettings.SavedQualityLevel
		return tonumber(string.match(setting.Name, "%d+"))
	end)
	return if ok then level else nil
end

function Quality.Detect(): string
	local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local level = graphicsLevel()
	if level and level <= 3 then
		return "Low"
	elseif touchOnly or (level and level <= 6) then
		return "Medium"
	end
	return "High"
end

-- Re-picks the budget from the player's settings; tells listeners if it changed.
function Quality.Apply(settings)
	local name = if settings and settings.Performance then "Low" else Quality.Detect()
	local profile = Config.Quality[name] or Config.Quality.High
	if profile ~= Quality.Current then
		Quality.Current = profile
		for _, listener in listeners do
			task.spawn(listener, profile)
		end
	end
end

function Quality.OnChanged(listener: (any) -> ())
	table.insert(listeners, listener)
end

-- Scales a particle count by the budget, never below `minimum`.
function Quality.Amount(count: number, minimum: number?): number
	return math.max(minimum or 1, math.floor(count * Quality.Current.Particles + 0.5))
end

return Quality
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[--[[
	All 2D interface: lobby buttons, side menu, coin counter, power bar, flight
	HUD, results screen and the Shop / Rebirth / Stats / Settings panels.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Daily = require(ReplicatedStorage.Shared.Daily)
local Format = require(ReplicatedStorage.Shared.Format)
local Index = require(ReplicatedStorage.Shared.Index)
local UpgradeTree = require(script.Parent.UpgradeTree)
local Widgets = require(script.Parent.Widgets)

local UI = {}

local C = Widgets.Colors
local actions: { [string]: any } = {}
local gui: ScreenGui
local mode = "Lobby"
local data = nil

local refs: { [string]: any } = {} -- named GuiObjects
local panels = {} -- [name] = Frame
local settingButtons = {} -- [key] = { Button, Label }
local shopRows = {} -- [trailId] = { Button, Label, Price }
local statLabels = {} -- [key] = TextLabel
local indexCards = {} -- [entryId] = { Card, Icon, Name, Detail, Stroke }
local dailyCards = {} -- [day] = { Card, Stroke, Label }
local dailyRefs: { [string]: any } = {}
local codeRefs: { [string]: any } = {}
local dailyPrompted = false
local rebirthRefs: { [string]: any } = {}

local displayedRunCoins = 0
local targetRunCoins = 0
local displayedCoins = 0
local targetCoins = 0

local function isTouchOnly(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function pill(props: { [string]: any }): Frame
	local frame = Widgets.new("Frame", {
		Name = props.Name,
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		Position = props.Position,
		Size = props.Size,
		BackgroundColor3 = props.Color or C.Dark,
		BackgroundTransparency = props.Transparency or 0.2,
		Visible = props.Visible ~= false,
		Parent = props.Parent,
	})
	Widgets.Corner(frame, props.Corner or 14)
	Widgets.Stroke(frame, Color3.fromRGB(0, 0, 0), 2)
	return frame
end

--------------------------------------------------------------------------------
-- Lobby: top buttons, side menu, coins
--------------------------------------------------------------------------------

local function buildLobby()
	local top = Widgets.new("Frame", {
		Name = "TopButtons",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(440, 72),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Widgets.AutoScale(top)
	refs.TopButtons = top
	local launch = Widgets.Button({
		Text = "🎯 Launch",
		Color = C.Blue,
		Size = UDim2.fromOffset(212, 68),
		Parent = top,
	})
	launch.Activated:Connect(function()
		actions.Launch()
	end)
	local upgrade = Widgets.Button({
		Text = "⬆️ Upgrade",
		Color = C.Green,
		Position = UDim2.fromOffset(228, 0),
		Size = UDim2.fromOffset(212, 68),
		Parent = top,
	})
	upgrade.Activated:Connect(function()
		UI.OpenPanel("Upgrades")
	end)

	-- Tutorial pointers for new players (bounced in UI.Init's render loop).
	local function pointer(name: string, text: string, x: number): TextLabel
		local label = Widgets.Label({
			Name = name,
			Text = text,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0, x, 1, 10),
			Size = UDim2.fromOffset(220, 40),
			TextColor3 = C.Header,
			StrokeThickness = 3,
			Visible = false,
			ZIndex = 5,
			Parent = top,
		})
		return label
	end
	refs.LaunchPointer = pointer("LaunchPointer", "👆 START HERE!", 106)
	refs.UpgradePointer = pointer("UpgradePointer", "👆 SPEND YOUR ⭐!", 334)

	local menu = Widgets.new("Frame", {
		Name = "SideMenu",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(190, 396),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Widgets.AutoScale(menu)
	refs.SideMenu = menu
	Widgets.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(90, 90),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = menu,
	})

	local tiles = {
		{ "Shop", "🛒", "Shop" },
		{ "Upgrades", "⬆️", "Upgrades" },
		{ "Rebirth", "🔄", "Rebirth" },
		{ "Index", "📖", "Index" },
		{ "Daily", "🎁", "Daily" },
		{ "Codes", "🎟️", "Codes" },
		{ "Stats", "📊", "Stats" },
		{ "Settings", "⚙️", "Settings" },
	}
	for order, tile in tiles do
		local name, icon, panelName = tile[1], tile[2], tile[3]
		local button = Widgets.new("TextButton", {
			Name = name,
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = Color3.new(1, 1, 1),
			LayoutOrder = order,
			Parent = menu,
		})
		Widgets.Corner(button, 14)
		Widgets.Stroke(button, Color3.fromRGB(20, 24, 36), 3)
		Widgets.Gradient(button, Color3.fromRGB(110, 128, 160), Color3.fromRGB(64, 74, 100))
		Widgets.Label({
			Text = icon,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 8),
			Size = UDim2.fromOffset(50, 50),
			StrokeThickness = 0,
			Parent = button,
		})
		Widgets.Label({
			Text = name,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -6),
			Size = UDim2.new(1, -8, 0, 22),
			Parent = button,
		})

		local badge = Widgets.new("Frame", {
			Name = "Badge",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -6, 0, 6),
			Size = UDim2.fromOffset(26, 26),
			BackgroundColor3 = C.Red,
			Visible = false,
			ZIndex = 3,
			Parent = button,
		})
		Widgets.Round(badge)
		Widgets.Stroke(badge, Color3.new(1, 1, 1), 2)
		Widgets.Label({ Text = "!", Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.1), ZIndex = 4, Parent = badge })
		refs[name .. "Badge"] = badge

		if not panelName then
			local soon = Widgets.new("Frame", {
				Name = "Soon",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, 0, 0, 2),
				Size = UDim2.fromOffset(56, 22),
				BackgroundColor3 = C.Yellow,
				ZIndex = 3,
				Parent = button,
			})
			Widgets.Corner(soon, 8)
			Widgets.Stroke(soon, Widgets.Darken(C.Yellow, 0.5), 2)
			Widgets.Label({ Text = "SOON", Size = UDim2.fromScale(1, 1), ZIndex = 4, StrokeThickness = 1.5, Parent = soon })
		end

		button.Activated:Connect(function()
			actions.Click()
			if panelName then
				UI.OpenPanel(panelName)
			else
				UI.Toast("Coming soon!")
			end
		end)
	end

	-- Bottom-left coins + best.
	local wallet = Widgets.new("Frame", {
		Name = "Wallet",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 14, 1, -14),
		Size = UDim2.fromOffset(250, 100),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Widgets.AutoScale(wallet)
	refs.Wallet = wallet
	local coins = pill({ Name = "Coins", Size = UDim2.fromOffset(250, 58), Parent = wallet })
	Widgets.Label({ Text = "⭐", Position = UDim2.fromOffset(6, 5), Size = UDim2.fromOffset(48, 48), StrokeThickness = 0, Parent = coins })
	refs.Coins = Widgets.Label({
		Text = "0",
		Position = UDim2.fromOffset(60, 7),
		Size = UDim2.new(1, -70, 1, -14),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = C.Coin,
		StrokeThickness = 3,
		Parent = coins,
	})
	refs.Best = Widgets.Label({
		Text = "🏆 BEST 0",
		Position = UDim2.fromOffset(4, 64),
		Size = UDim2.fromOffset(240, 32),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(140, 255, 100),
		StrokeThickness = 3,
		Parent = wallet,
	})
end

--------------------------------------------------------------------------------
-- In-run HUD: run coins, combo, distance, hint, power bar, pop text
--------------------------------------------------------------------------------

local function buildRunHud()
	local runCoins = pill({
		Name = "RunCoins",
