		Size = UDim2.fromOffset(470, 128),
		BackgroundColor3 = C.Panel,
		Visible = false,
		Parent = gui,
	})
	Widgets.Corner(power, 16)
	Widgets.Stroke(power, C.PanelStroke, 4)
