local function buildCodes()
	local panel, content, close = Widgets.Panel(gui, "🎟️ Codes", Vector2.new(460, 330))
	panels.Codes = panel
	close.Activated:Connect(UI.ClosePanels)

	Widgets.Label({
		Text = "Got a code? Type it here!",
		Size = UDim2.new(1, 0, 0, 30),
		ZIndex = 22,
		Parent = content,
	})
	local box = Widgets.new("TextBox", {
		Position = UDim2.fromOffset(0, 42),
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundColor3 = Color3.fromRGB(250, 244, 230),
		ClearTextOnFocus = false,
		Font = Widgets.Font,
		PlaceholderText = "Type a code...",
		PlaceholderColor3 = Color3.fromRGB(150, 130, 110),
		Text = "",
		TextColor3 = Color3.fromRGB(40, 26, 16),
		TextScaled = true,
		ZIndex = 22,
		Parent = content,
	})
	Widgets.Corner(box, 12)
	Widgets.Stroke(box, C.PanelStroke, 3)
	Widgets.new("UIPadding", {
		PaddingLeft = UDim.new(0, 14),
		PaddingRight = UDim.new(0, 14),
		PaddingTop = UDim.new(0, 10),
		PaddingBottom = UDim.new(0, 10),
		Parent = box,
	})
	codeRefs.Box = box
	codeRefs.Result = Widgets.Label({
		Text = "Hint: try LAUNCH",
		Position = UDim2.fromOffset(0, 108),
		Size = UDim2.new(1, 0, 0, 28),
		TextColor3 = Color3.fromRGB(255, 226, 190),
		ZIndex = 22,
		Parent = content,
	})
	local button = Widgets.Button({
		Text = "Redeem",
		Color = C.Green,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.fromOffset(240, 64),
		ZIndex = 22,
		Parent = content,
	})
	local function submit()
		local text = box.Text
		if text ~= "" then
			actions.RedeemCode(text)
		end
	end
	button.Activated:Connect(submit)
	box.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			submit()
		end
	end)
end

-- Shows the outcome of a code redemption under the text box.
function UI.CodeResult(ok: boolean, message: string)
	codeRefs.Result.Text = message
	codeRefs.Result.TextColor3 = if ok then Color3.fromRGB(140, 255, 100) else Color3.fromRGB(255, 130, 120)
	if ok then
		codeRefs.Box.Text = ""
	end
end

--------------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------------

function UI.Init(playerGui: PlayerGui, callbacks)
	actions = callbacks

	gui = Widgets.new("ScreenGui", {
		Name = "SlingHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 5,
		Parent = playerGui,
	})

	buildLobby()
	buildRunHud()
	buildResults()
	buildShop()
	buildRebirth()
	buildStats()
	buildSettings()
	buildIndex()
	buildDaily()
	buildCodes()
	UpgradeTree.Init(gui, function(nodeId)
		actions.BuyUpgrade(nodeId)
	end)

	-- Smoothly count coin labels up/down.
	RunService.RenderStepped:Connect(function(dt)
		local alpha = math.min(1, dt * 10)
		if math.abs(targetRunCoins - displayedRunCoins) > 0.5 then
			displayedRunCoins += (targetRunCoins - displayedRunCoins) * alpha
			refs.RunCoinsLabel.Text = Format.Coins(math.floor(displayedRunCoins + 0.5))
		end
		if math.abs(targetCoins - displayedCoins) > 0.5 then
			displayedCoins += (targetCoins - displayedCoins) * alpha
			refs.Coins.Text = Format.Coins(math.floor(displayedCoins + 0.5))
		end
		if refs.PowerGradient then
			refs.PowerGradient.Offset = Vector2.new(math.sin(os.clock() * 2) * 0.1, 0)
		end
		-- Bounce the tutorial pointers.
		local bounce = math.abs(math.sin(os.clock() * 4)) * 8
		refs.LaunchPointer.Position = UDim2.new(0, 106, 1, 10 + bounce)
		refs.UpgradePointer.Position = UDim2.new(0, 334, 1, 10 + bounce)
	end)

	-- Keep the daily countdown ticking while its panel is open.
	task.spawn(function()
		while true do
			task.wait(1)
			if panels.Daily.Visible then
				refreshDaily()
			end
		end
	end)

	UI.SetMode("Lobby")
end

function UI.PowerButton(): TextButton
	return refs.Power
end

function UI.SetData(newData)
	local first = data == nil
	data = newData
	targetCoins = data.Coins
	if first then
		displayedCoins = data.Coins
		refs.Coins.Text = Format.Coins(data.Coins)
	end
	refs.Best.Text = "🏆 BEST " .. Format.Short(data.BestDistance)

	refs.UpgradesBadge.Visible = UpgradeTree.HasAffordable(data)
	refs.RebirthBadge.Visible = data.Coins >= Config.RebirthCost(data.Rebirths)

	UpgradeTree.SetData(data)
	refreshShop()
	refreshRebirth()
	refreshStats()
	refreshSettings()
	refreshIndex()
	refreshDaily()
	UI.RefreshHint()
	UI.RefreshPointers()

	-- Greet returning players with their daily reward, once per session.
	if not dailyPrompted and Daily.Status(data.Daily, Workspace:GetServerTimeNow()) then
		dailyPrompted = true
		task.delay(1.5, function()
			if mode == "Lobby" and not UpgradeTree.IsOpen() then
				local anyOpen = false
				for name, panel in panels do
					if name ~= "Results" and panel.Visible then
						anyOpen = true
					end
				end
				if not anyOpen then
					UI.OpenPanel("Daily")
				end
			end
		end)
	end
end

-- Pointers for brand-new players: first press Launch, then buy an upgrade.
function UI.RefreshPointers()
	local launches = if data then data.Stats.Launches else 0
	local ownsUpgrade = data ~= nil and next(data.Upgrades) ~= nil
	refs.LaunchPointer.Visible = mode == "Lobby" and data ~= nil and launches == 0
	refs.UpgradePointer.Visible = mode == "Lobby"
		and launches > 0
		and not ownsUpgrade
		and UpgradeTree.HasAffordable(data)
end

function UI.ClosePanels()
	for name, panel in panels do
		if name ~= "Results" then
			panel.Visible = false
		end
	end
	UpgradeTree.Close()
end

function UI.OpenPanel(name: string)
	if mode ~= "Lobby" and mode ~= "Results" then
		return
	end
	local wasOpen = (name == "Upgrades" and UpgradeTree.IsOpen()) or (panels[name] and panels[name].Visible)
	UI.ClosePanels()
	if wasOpen then
		return
	end
	if name == "Upgrades" then
		UpgradeTree.Open()
	elseif panels[name] then
		panels[name].Visible = true
		Widgets.PopIn(panels[name])
	end
end

function UI.SetMode(newMode: string)
	mode = newMode
	local lobby = newMode == "Lobby"
	local aiming = newMode == "Aiming"
	local flying = newMode == "Flying"
	local results = newMode == "Results"

	refs.TopButtons.Visible = lobby
	refs.SideMenu.Visible = lobby
	refs.Wallet.Visible = true
	refs.RunCoins.Visible = aiming or flying or results
	refs.Distance.Visible = flying or results
	refs.Power.Visible = aiming
	refs.Combo.Visible = false
	refs.Boost.Visible = flying
	if not flying then
		refs.Ability.Visible = false
	end
	panels.Results.Visible = false
	if not lobby then
		UI.ClosePanels()
	end
	UI.RefreshHint()
	UI.RefreshPointers()
end

function UI.RefreshHint()
	local showHints = data == nil or data.Settings.Hints ~= false
	refs.Hint.Visible = mode == "Flying" and showHints
	refs.HintLabel.Text = if isTouchOnly()
		then "STICK TO STEER • TAP ⚡ FOR NITRO"
		else "A / D TO STEER • CLICK OR SPACE FOR NITRO"
end

-- Shows how many mid-air boosts are left.
function UI.SetBoosts(left: number)
	refs.BoostCount.Text = tostring(left)
	local color = if left > 0 then Color3.fromRGB(120, 240, 255) else Color3.fromRGB(130, 130, 140)
	local dark = if left > 0 then Color3.fromRGB(30, 120, 255) else Color3.fromRGB(80, 80, 90)
	refs.BoostGradient.Color = ColorSequence.new(color, dark)
end

-- Shows the active power-up and how much of it is left (kind = nil hides it).
local shownAbility = nil
function UI.SetAbility(kind: string?, fraction: number?)
	local ability = refs.Ability
	if not kind then
		ability.Visible = false
		shownAbility = nil
		return
	end
	local info = Config.Abilities[kind]
	if shownAbility ~= kind then
		shownAbility = kind
		refs.AbilityIcon.Text = info.Icon
		refs.AbilityName.Text = info.Name
		refs.AbilityName.TextColor3 = info.Color:Lerp(Color3.new(1, 1, 1), 0.35)
		refs.AbilityBar.BackgroundColor3 = info.Color
		if refs.AbilityStroke then
			refs.AbilityStroke.Color = info.Color
		end
		ability.Visible = true
		Widgets.PopIn(ability)
	end
	refs.AbilityBar.Size = UDim2.fromScale(math.clamp(fraction or 1, 0, 1), 1)
end

-- stateName: "aim" | "charging". angle/yaw are the current aim in degrees.
function UI.SetPower(power: number, stateName: string, angle: number?, yaw: number?)
	refs.PowerFill.Size = UDim2.fromScale(power, 1)
	local aimText = ""
	if angle then
		aimText = string.format("  ∠%d°", math.floor(angle + 0.5))
		if yaw and math.abs(yaw) >= 1 then
			aimText ..= string.format(" %s%d°", if yaw > 0 then "→" else "←", math.floor(math.abs(yaw) + 0.5))
		end
	end
	refs.PowerPercent.Text = math.floor(power * 100 + 0.5) .. "%" .. aimText
	if stateName == "charging" then
		refs.PowerStatus.Text = if isTouchOnly() then "DRAG TO AIM • RELEASE TO LAUNCH!" else "RELEASE TO LAUNCH!"
	elseif isTouchOnly() then
		refs.PowerStatus.Text = "STICK AIMS • PRESS & HOLD HERE TO CHARGE"
	else
		refs.PowerStatus.Text = "W/S A/D AIM • HOLD CLICK OR SPACE TO CHARGE"
	end
end

function UI.SetRunCoins(value: number, instant: boolean?)
	targetRunCoins = value
	if instant then
		displayedRunCoins = value
		refs.RunCoinsLabel.Text = Format.Coins(value)
	end
end

function UI.SetDistance(value: number)
	refs.DistanceLabel.Text = Format.Commas(value)
end

function UI.SetCombo(multiplier: number, timeFraction: number, visible: boolean)
	local combo = refs.Combo
	if not visible then
		combo.Visible = false
		return
	end
	local text = "x" .. multiplier
	if not combo.Visible or refs.ComboLabel.Text ~= text then
		refs.ComboLabel.Text = text
		combo.Visible = true
		Widgets.PopIn(combo)
	end
	refs.ComboBar.Size = UDim2.fromScale(math.clamp(timeFraction, 0, 1), 1)
end

local popToken = 0
local POP_STYLES = {
	max = { Color3.fromRGB(120, 255, 120), Color3.fromRGB(60, 160, 255) },
	crit = { Color3.fromRGB(255, 220, 90), Color3.fromRGB(255, 80, 40) },
	boost = { Color3.fromRGB(140, 255, 255), Color3.fromRGB(0, 160, 255) },
	best = { Color3.fromRGB(255, 120, 220), Color3.fromRGB(150, 90, 255) },
	combo = { Color3.fromRGB(255, 160, 220), Color3.fromRGB(255, 60, 150) },
	zap = { Color3.fromRGB(255, 140, 150), Color3.fromRGB(220, 30, 60) },
	phase = { Color3.fromRGB(230, 255, 255), Color3.fromRGB(80, 220, 255) },
	meteor = { Color3.fromRGB(255, 230, 120), Color3.fromRGB(255, 80, 20) },
	rift = { Color3.fromRGB(230, 200, 255), Color3.fromRGB(140, 70, 255) },
	shock = { Color3.fromRGB(255, 200, 200), Color3.fromRGB(255, 40, 60) },
	nitro = { Color3.fromRGB(220, 255, 255), Color3.fromRGB(40, 150, 255) },
}

function UI.Pop(text: string, style: string?)
	popToken += 1
	local token = popToken
	local pop = refs.Pop
	local colors = POP_STYLES[style or "max"] or POP_STYLES.max
	refs.PopGradient.Color = ColorSequence.new(colors[1], colors[2])
	pop.Text = text
	pop.TextTransparency = 0
	pop.Visible = true
	Widgets.PopIn(pop)
	task.delay(0.9, function()
		if token == popToken then
			TweenService:Create(pop, TweenInfo.new(0.25), { TextTransparency = 1 }):Play()
			task.wait(0.25)
			if token == popToken then
				pop.Visible = false
			end
		end
	end)
end

local bannerToken = 0
function UI.Banner(text: string, color: Color3?)
	bannerToken += 1
	local token = bannerToken
	local banner = refs.Banner
	banner.Text = text
	banner.TextColor3 = color or C.Header
	banner.Visible = true
	Widgets.PopIn(banner)
	task.delay(2, function()
		if token == bannerToken then
			banner.Visible = false
		end
	end)
end

local toastToken = 0
function UI.Toast(text: string, color: Color3?)
	toastToken += 1
	local token = toastToken
	refs.ToastLabel.Text = text
	refs.ToastLabel.TextColor3 = color or C.Text
	refs.Toast.Visible = true
	Widgets.PopIn(refs.Toast)
	task.delay(2.2, function()
		if token == toastToken then
			refs.Toast.Visible = false
		end
	end)
end

local resultToken = 0

function UI.ShowResults(result, comboMultiplier: number)
	resultToken += 1
	local token = resultToken
	local panel = panels.Results
	refs.ResultTitle.Text = if result.NewBest then "NEW BEST!" else "NICE LAUNCH!"
	refs.ResultGradient.Enabled = result.NewBest == true
	refs.ResultTitle.TextColor3 = if result.NewBest then Color3.new(1, 1, 1) else C.Header
	if result.Failed then
		refs.ResultBreakdown.Text = "Server didn't respond - nothing was saved"
	else
		local parts = {
			"Smashing ⭐ " .. Format.Short(result.RunCoins or 0),
			"Distance ⭐ " .. Format.Short(result.DistanceCoins or 0),
		}
		if (result.DiscoveryCoins or 0) > 0 then
			table.insert(parts, "Index ⭐ " .. Format.Short(result.DiscoveryCoins))
		end
		refs.ResultBreakdown.Text = table.concat(parts, "  •  ")
	end

	local found = {}
	for _, entry in result.Discoveries or {} do
		table.insert(found, string.format("%s %s (+%s)", entry.Icon, entry.Name, Format.Short(entry.Reward)))
	end
	refs.ResultDiscoveries.Visible = #found > 0
	refs.ResultDiscoveries.Text = "📖 NEW: " .. table.concat(found, "   ")

	refs.ResultDistance.Text = Format.Commas(result.Distance or 0)
	refs.ResultSmashes.Text = Format.Commas(result.Smashes or 0)
	refs.ResultCombo.Text = "x" .. comboMultiplier
	panel.Visible = true
	Widgets.PopIn(panel)

	-- Count the earned coins up instead of showing them all at once.
	local earned = result.Earned or 0
	local start = os.clock()
	local duration = math.clamp(0.4 + earned / 20000, 0.4, 1.2)
	refs.ResultEarned.Text = "⭐ +0"
	task.spawn(function()
		while token == resultToken do
			local alpha = math.min(1, (os.clock() - start) / duration)
			local eased = 1 - (1 - alpha) ^ 3
			refs.ResultEarned.Text = "⭐ +" .. Format.Commas(math.floor(earned * eased + 0.5))
			if alpha >= 1 then
				break
			end
			task.wait()
		end
	end)

	if result.NewBest then
		UI.Confetti()
	end
end

-- A burst of falling confetti across the whole screen.
function UI.Confetti()
	local colors = {
		Color3.fromRGB(255, 90, 90),
		Color3.fromRGB(255, 210, 60),
		Color3.fromRGB(90, 220, 110),
		Color3.fromRGB(70, 180, 255),
		Color3.fromRGB(200, 110, 255),
	}
	local layer = Widgets.new("Frame", {
		Name = "Confetti",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 70,
		Parent = gui,
	})
	for i = 1, 60 do
		local piece = Widgets.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(math.random(), 0, 0, -20 - math.random(0, 120)),
			Size = UDim2.fromOffset(math.random(8, 14), math.random(14, 22)),
			Rotation = math.random(0, 360),
			BackgroundColor3 = colors[(i % #colors) + 1],
			BorderSizePixel = 0,
			ZIndex = 71,
			Parent = layer,
		})
		local fall = TweenInfo.new(1.6 + math.random() * 1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		TweenService:Create(piece, fall, {
			Position = UDim2.new(piece.Position.X.Scale + (math.random() - 0.5) * 0.2, 0, 1, 40),
			Rotation = piece.Rotation + math.random(-540, 540),
		}):Play()
	end
	task.delay(3.2, function()
		layer:Destroy()
	end)
end

function UI.HideResults()
	panels.Results.Visible = false
end

return UI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">UpgradeTree</string>
            <string name="Source"><![CDATA[--[[
	Full-screen hex upgrade tree. Drag to pan, scroll or 🔍 to zoom, tap a node
	to see it in the info card and buy it.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Widgets = require(script.Parent.Widgets)

local UpgradeTree = {}

local HEX = 47 -- hex "radius" in pixels; neighbours are HEX * sqrt(3) apart
local NODE_SIZE = 66
local ZOOM_LEVELS = { 1, 0.75, 0.55 }

local COLORS = {
	Owned = { Color3.fromRGB(90, 190, 255), Color3.fromRGB(40, 110, 225) },
	Available = { Color3.fromRGB(190, 110, 255), Color3.fromRGB(122, 52, 214) },
	Locked = { Color3.fromRGB(84, 62, 120), Color3.fromRGB(52, 36, 80) },
	Start = { Color3.fromRGB(90, 240, 220), Color3.fromRGB(30, 170, 180) },
}

local overlay: Frame
local canvas: Frame
local canvasScale: UIScale
local coinsLabel: TextLabel
local info = {}
local nodeViews = {} -- [nodeId] = { Button, Gradient, Stroke, Icon, Line }
local selectedId: string? = nil
local currentData = nil
local onBuy = nil
local pan = Vector2.zero
local zoomIndex = 1
local pulseConnection: RBXScriptConnection? = nil

local function hexToPixel(q: number, r: number): Vector2
	return Vector2.new(HEX * math.sqrt(3) * (q + r / 2), HEX * 1.5 * r)
end

local function nodeState(node, data): string
	if not data then
		return "Locked"
	end
	if data.Upgrades[node.Id] then
		return "Owned"
	end
	if node.Requires == "Start" or data.Upgrades[node.Requires] then
		return "Available"
	end
	return "Locked"
end

local function applyCanvasTransform()
	canvas.Position = UDim2.new(0.5, pan.X, 0.5, pan.Y)
	canvasScale.Scale = Widgets.ViewportScale() * ZOOM_LEVELS[zoomIndex]
end

local function makeLine(fromPos: Vector2, toPos: Vector2): Frame
	local delta = toPos - fromPos
	local mid = (fromPos + toPos) / 2
	return Widgets.new("Frame", {
		Name = "Line",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, mid.X, 0.5, mid.Y),
		Size = UDim2.fromOffset(delta.Magnitude, 9),
		Rotation = math.deg(math.atan2(delta.Y, delta.X)),
		BackgroundColor3 = Color3.fromRGB(50, 36, 70),
		BorderSizePixel = 0,
		ZIndex = 32,
		Parent = canvas,
	})
end

local function makeNode(node, isStart: boolean)
	local pos = hexToPixel(node.Q, node.R)
	local button = Widgets.new("TextButton", {
		Name = node.Id,
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, pos.X, 0.5, pos.Y),
		Size = UDim2.fromOffset(NODE_SIZE, NODE_SIZE),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 34,
		Parent = canvas,
	})
	Widgets.Round(button)
	local colors = if isStart then COLORS.Start else COLORS.Locked
	local gradient = Widgets.Gradient(button, colors[1], colors[2])
	local stroke = Widgets.Stroke(button, Color3.fromRGB(30, 20, 46), 4)

	local icon = Widgets.Label({
		Name = "Icon",
		Text = node.Icon,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.48),
		Size = UDim2.fromScale(0.62, 0.62),
		StrokeThickness = 0,
		ZIndex = 35,
		Parent = button,
	})

	if not isStart then
		local badge = Widgets.new("Frame", {
			Name = "Tier",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -8, 1, -8),
			Size = UDim2.fromOffset(24, 24),
			BackgroundColor3 = Color3.fromRGB(30, 22, 44),
			ZIndex = 36,
			Parent = button,
		})
		Widgets.Round(badge)
		Widgets.Stroke(badge, Color3.fromRGB(255, 255, 255), 1.5)
		Widgets.Label({
			Text = tostring(node.Tier),
			Size = UDim2.fromScale(0.8, 0.8),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			StrokeThickness = 0,
			ZIndex = 37,
			Parent = badge,
		})
	end

	button.Activated:Connect(function()
		UpgradeTree.Select(node.Id)
	end)

	return {
		Button = button,
		Gradient = gradient,
		Stroke = stroke,
		Icon = icon,
		Position = pos,
	}
end

local function buildInfoCard(parent: Instance)
	local card = Widgets.new("Frame", {
		Name = "InfoCard",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -18, 0.5, 0),
		Size = UDim2.fromOffset(270, 340),
		BackgroundColor3 = Widgets.Colors.Panel,
		Active = true, -- clicks on the card shouldn't start a pan
		ZIndex = 40,
		Parent = parent,
	})
	Widgets.Corner(card, 16)
	Widgets.Stroke(card, Widgets.Colors.PanelStroke, 4)
	Widgets.AutoScale(card)

	info.Icon = Widgets.Label({
		Text = "🎯",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 14),
		Size = UDim2.fromOffset(70, 70),
		StrokeThickness = 0,
		ZIndex = 41,
		Parent = card,
	})
	info.Name = Widgets.Label({
		Text = "Start",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 90),
		Size = UDim2.new(1, -24, 0, 34),
		StrokeThickness = 3,
		ZIndex = 41,
		Parent = card,
	})
	info.Description = Widgets.Label({
		Text = "",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 130),
		Size = UDim2.new(1, -28, 0, 66),
		TextWrapped = true,
		TextColor3 = Color3.fromRGB(255, 236, 200),
		MaxTextSize = 20,
		StrokeThickness = 0,
		ZIndex = 41,
		Parent = card,
	})
	info.Status = Widgets.Label({
		Text = "",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 202),
		Size = UDim2.new(1, -28, 0, 30),
		TextColor3 = Widgets.Colors.Coin,
		MaxTextSize = 24,
		ZIndex = 41,
		Parent = card,
	})
	local buy, buyLabel = Widgets.Button({
		Name = "Buy",
		Text = "Buy",
		Color = Widgets.Colors.Green,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(220, 62),
		ZIndex = 41,
		Parent = card,
	})
	info.Buy = buy
	info.BuyLabel = buyLabel
	buy.Activated:Connect(function()
		if selectedId and selectedId ~= "Start" and onBuy then
			onBuy(selectedId)
		end
	end)
end

function UpgradeTree.Init(gui: ScreenGui, buyCallback)
	onBuy = buyCallback

	overlay = Widgets.new("Frame", {
		Name = "UpgradeTree",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(16, 12, 28),
		BackgroundTransparency = 0.25,
		Active = true,
		Visible = false,
		ZIndex = 30,
		Parent = gui,
	})

	local viewport = Widgets.new("Frame", {
		Name = "Viewport",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 31,
		Parent = overlay,
	})

	canvas = Widgets.new("Frame", {
		Name = "Canvas",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(1400, 1100),
		BackgroundTransparency = 1,
		ZIndex = 31,
		Parent = viewport,
	})
	canvasScale = Widgets.new("UIScale", { Parent = canvas })

	-- Lines first so they render under the nodes.
	local startView = makeNode(Config.StartNode, true)
	nodeViews.Start = startView
	local lines = {}
	for _, node in Config.Nodes do
		local parentNode = Config.NodesById[node.Requires] or Config.StartNode
		lines[node.Id] = makeLine(hexToPixel(parentNode.Q, parentNode.R), hexToPixel(node.Q, node.R))
	end
	for _, node in Config.Nodes do
		local view = makeNode(node, false)
		view.Line = lines[node.Id]
		nodeViews[node.Id] = view
	end

	-- Drag to pan.
	local dragging = false
	local dragStart = Vector2.zero
	local panStart = Vector2.zero
	viewport.InputBegan:Connect(function(input: InputObject)
		local inputType = input.UserInputType
		if inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = Vector2.new(input.Position.X, input.Position.Y)
			panStart = pan
		end
	end)
	viewport.InputChanged:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			if input.Position.Z > 0 then
				zoomIndex = math.max(1, zoomIndex - 1)
			else
				zoomIndex = math.min(#ZOOM_LEVELS, zoomIndex + 1)
			end
			applyCanvasTransform()
		end
	end)
	UserInputService.InputChanged:Connect(function(input: InputObject)
		if not dragging then
			return
		end
		local inputType = input.UserInputType
		if inputType == Enum.UserInputType.MouseMovement or inputType == Enum.UserInputType.Touch then
			local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
			pan = Vector2.new(math.clamp(panStart.X + delta.X, -700, 700), math.clamp(panStart.Y + delta.Y, -600, 600))
			applyCanvasTransform()
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		local inputType = input.UserInputType
		if inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	-- Header: coins + title.
	local top = Widgets.new("Frame", {
		Name = "Top",
		Size = UDim2.new(1, 0, 0, 70),
		BackgroundTransparency = 1,
		ZIndex = 40,
		Parent = overlay,
	})
	local coinsPill = Widgets.new("Frame", {
		Name = "Coins",
		Position = UDim2.fromOffset(16, 12),
		Size = UDim2.fromOffset(210, 52),
		BackgroundColor3 = Widgets.Colors.Dark,
		BackgroundTransparency = 0.2,
		ZIndex = 40,
		Parent = top,
	})
	Widgets.Corner(coinsPill, 14)
	Widgets.Stroke(coinsPill, Color3.fromRGB(0, 0, 0), 2)
	Widgets.AutoScale(coinsPill)
	Widgets.Label({
		Text = "⭐",
		Position = UDim2.fromOffset(6, 4),
		Size = UDim2.fromOffset(44, 44),
		StrokeThickness = 0,
		ZIndex = 41,
		Parent = coinsPill,
	})
	coinsLabel = Widgets.Label({
		Text = "0",
		Position = UDim2.fromOffset(56, 6),
		Size = UDim2.new(1, -66, 1, -12),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Widgets.Colors.Coin,
		ZIndex = 41,
		Parent = coinsPill,
	})

	local title = Widgets.new("Frame", {
		Name = "Title",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(420, 70),
		BackgroundTransparency = 1,
		ZIndex = 40,
		Parent = top,
	})
	Widgets.AutoScale(title)
	Widgets.Label({
		Text = "UPGRADES",
		Size = UDim2.new(1, 0, 0, 42),
		TextColor3 = Widgets.Colors.Header,
		StrokeThickness = 3,
		ZIndex = 41,
		Parent = title,
	})
	Widgets.Label({
		Text = "Drag to explore • tap a node to buy",
		Position = UDim2.fromOffset(0, 44),
		Size = UDim2.new(1, 0, 0, 22),
		TextColor3 = Color3.fromRGB(220, 210, 255),
		ZIndex = 41,
		Parent = title,
	})

	buildInfoCard(overlay)

	-- Bottom: Close + zoom.
	local bottom = Widgets.new("Frame", {
		Name = "Bottom",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(280, 64),
		BackgroundTransparency = 1,
		ZIndex = 40,
		Parent = overlay,
	})
	Widgets.AutoScale(bottom)
	local close = Widgets.Button({
		Text = "Close",
		Color = Widgets.Colors.Red,
		Size = UDim2.fromOffset(200, 62),
		ZIndex = 41,
		Parent = bottom,
	})
	close.Activated:Connect(function()
		UpgradeTree.Close()
	end)
	local zoom = Widgets.Button({
		Text = "🔍",
		Color = Widgets.Colors.Blue,
		Position = UDim2.fromOffset(216, 0),
		Size = UDim2.fromOffset(62, 62),
		ZIndex = 41,
		Parent = bottom,
	})
	zoom.Activated:Connect(function()
		zoomIndex = zoomIndex % #ZOOM_LEVELS + 1
		applyCanvasTransform()
	end)

	applyCanvasTransform()
	UpgradeTree.Select("Start")
end

function UpgradeTree.Select(nodeId: string)
	selectedId = nodeId
	for id, view in nodeViews do
		view.Button.Size = if id == nodeId
			then UDim2.fromOffset(NODE_SIZE + 10, NODE_SIZE + 10)
			else UDim2.fromOffset(NODE_SIZE, NODE_SIZE)
	end

	if nodeId == "Start" then
		info.Icon.Text = Config.StartNode.Icon
		info.Name.Text = "Slingshot"
		info.Description.Text = "Your trusty slingshot. Every branch grows from here!"
		info.Status.Text = ""
		info.Buy.Visible = false
		return
	end

	local node = Config.NodesById[nodeId]
	if not node then
		return
	end
	local data = currentData
	local state = nodeState(node, data)
	info.Icon.Text = node.Icon
	info.Name.Text = node.Name
	info.Description.Text = node.Description
	info.Buy.Visible = true

	if state == "Owned" then
		info.Status.Text = "✅ Owned"
		info.BuyLabel.Text = "Owned"
		Widgets.SetButtonColor(info.Buy, Widgets.Colors.Blue)
	elseif state == "Available" then
		info.Status.Text = "⭐ " .. Format.Coins(node.Cost)
		local affordable = data ~= nil and data.Coins >= node.Cost
		info.BuyLabel.Text = if affordable then "Buy" else "Need more ⭐"
		Widgets.SetButtonColor(info.Buy, if affordable then Widgets.Colors.Green else Widgets.Colors.Grey)
	else
		local required = Config.NodesById[node.Requires]
		info.Status.Text = "🔒 Needs " .. (if required then required.Name else "previous")
		info.BuyLabel.Text = "Locked"
		Widgets.SetButtonColor(info.Buy, Widgets.Colors.Grey)
	end
end

function UpgradeTree.SetData(data)
	currentData = data
	if not overlay then
		return
	end
	coinsLabel.Text = Format.Coins(data.Coins)

	for _, node in Config.Nodes do
		local view = nodeViews[node.Id]
		local state = nodeState(node, data)
		local colors = COLORS[state]
		view.Gradient.Color = ColorSequence.new(colors[1], colors[2])
		view.Icon.TextTransparency = if state == "Locked" then 0.5 else 0
		if state == "Owned" then
			view.Stroke.Color = Color3.fromRGB(255, 255, 255)
			view.Stroke.Thickness = 3
			view.Line.BackgroundColor3 = Color3.fromRGB(255, 210, 60)
		elseif state == "Available" then
			view.Stroke.Color = Color3.fromRGB(255, 210, 60)
			view.Stroke.Thickness = 4
			view.Line.BackgroundColor3 = Color3.fromRGB(190, 150, 255)
		else
			view.Stroke.Color = Color3.fromRGB(30, 20, 46)
			view.Stroke.Thickness = 4
			view.Line.BackgroundColor3 = Color3.fromRGB(50, 36, 70)
		end
	end

	if selectedId then
		UpgradeTree.Select(selectedId)
	end
end

-- True when at least one unlocked upgrade can be bought right now.
function UpgradeTree.HasAffordable(data): boolean
	if not data then
		return false
	end
	for _, node in Config.Nodes do
		if nodeState(node, data) == "Available" and data.Coins >= node.Cost then
			return true
		end
	end
	return false
end

function UpgradeTree.IsOpen(): boolean
	return overlay ~= nil and overlay.Visible
end

function UpgradeTree.Open()
	if not overlay then
		return
	end
	overlay.Visible = true
	applyCanvasTransform()
	if currentData then
		UpgradeTree.SetData(currentData)
	end
	-- Pick the cheapest thing you can buy so the card is useful immediately.
	if currentData then
		local best = nil
		for _, node in Config.Nodes do
			if nodeState(node, currentData) == "Available" and (best == nil or node.Cost < best.Cost) then
				best = node
			end
		end
		if best then
			UpgradeTree.Select(best.Id)
		end
	end

	if pulseConnection then
		pulseConnection:Disconnect()
	end
	pulseConnection = RunService.Heartbeat:Connect(function()
		local data = currentData
		if not data then
			return
		end
		local pulse = 4 + math.sin(os.clock() * 6) * 2
		for _, node in Config.Nodes do
			if nodeState(node, data) == "Available" and data.Coins >= node.Cost then
				nodeViews[node.Id].Stroke.Thickness = pulse
			end
		end
	end)
end

function UpgradeTree.Close()
	if overlay then
		overlay.Visible = false
	end
	if pulseConnection then
		pulseConnection:Disconnect()
		pulseConnection = nil
	end
end

return UpgradeTree
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Widgets</string>
            <string name="Source"><![CDATA[--[[
	Tiny UI kit: chunky cartoon panels, buttons and labels built from code.
]]

local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Widgets = {}

Widgets.Font = Enum.Font.FredokaOne

Widgets.Colors = {
	Panel = Color3.fromRGB(96, 62, 42),
	PanelDark = Color3.fromRGB(62, 40, 28),
	PanelStroke = Color3.fromRGB(36, 22, 14),
	Header = Color3.fromRGB(255, 206, 46),
	Green = Color3.fromRGB(92, 214, 64),
	Yellow = Color3.fromRGB(255, 196, 36),
	Blue = Color3.fromRGB(64, 146, 255),
	Red = Color3.fromRGB(236, 64, 64),
	Purple = Color3.fromRGB(150, 80, 230),
	Pink = Color3.fromRGB(255, 76, 170),
	Grey = Color3.fromRGB(120, 120, 130),
	Slate = Color3.fromRGB(70, 82, 104),
	Text = Color3.fromRGB(255, 255, 255),
	TextStroke = Color3.fromRGB(30, 18, 10),
	Coin = Color3.fromRGB(255, 214, 60),
	Dark = Color3.fromRGB(24, 24, 32),
}

local buttonColorSetters = setmetatable({}, { __mode = "k" }) -- [GuiButton] = function(Color3)
local autoScales = {} -- list of { Scale: UIScale, Multiplier: number }
local autoMultipliers = setmetatable({}, { __mode = "k" }) -- [UIScale] = multiplier

function Widgets.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	if props then
		for key, value in props do
			if key ~= "Parent" then
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if props and props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function Widgets.Darken(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(0, 0, 0), amount)
end

function Widgets.Lighten(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(1, 1, 1), amount)
end

function Widgets.Corner(parent: Instance, radius: number?): UICorner
	return Widgets.new("UICorner", { CornerRadius = UDim.new(0, radius or 12), Parent = parent })
end

function Widgets.Round(parent: Instance): UICorner
	return Widgets.new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = parent })
end

function Widgets.Stroke(parent: Instance, color: Color3?, thickness: number?, border: boolean?): UIStroke
	return Widgets.new("UIStroke", {
		Color = color or Widgets.Colors.PanelStroke,
		Thickness = thickness or 3,
		ApplyStrokeMode = if border == false then Enum.ApplyStrokeMode.Contextual else Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = parent,
	})
end

function Widgets.Gradient(parent: Instance, top: Color3, bottom: Color3, rotation: number?): UIGradient
	return Widgets.new("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = rotation or 90,
		Parent = parent,
	})
end

function Widgets.Rainbow(parent: Instance, rotation: number?): UIGradient
	return Widgets.new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(80, 220, 255)),
			ColorSequenceKeypoint.new(0.25, Color3.fromRGB(150, 110, 255)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 80, 200)),
			ColorSequenceKeypoint.new(0.75, Color3.fromRGB(255, 200, 60)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 255, 90)),
		}),
		Rotation = rotation or 0,
		Parent = parent,
	})
end

-- A text label with the chunky outlined look used everywhere.
-- Extra props: StrokeThickness (0 = no outline), MaxTextSize.
function Widgets.Label(props: { [string]: any }): TextLabel
	local label = Widgets.new("TextLabel", {
		BackgroundTransparency = 1,
		Font = Widgets.Font,
		TextColor3 = Widgets.Colors.Text,
		TextScaled = true,
		Text = "",
	})
	for key, value in props do
		if key ~= "StrokeThickness" and key ~= "MaxTextSize" and key ~= "Parent" then
			(label :: any)[key] = value
		end
	end
	if props.StrokeThickness ~= 0 then
		Widgets.Stroke(label, Widgets.Colors.TextStroke, props.StrokeThickness or 2, false)
	end
	if props.MaxTextSize then
		Widgets.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize, Parent = label })
	end
	label.Parent = props.Parent
	return label
end

-- Button with a gradient, outline, centred label and a squish animation.
function Widgets.Button(props: { [string]: any }): (TextButton, TextLabel)
	local color = props.Color or Widgets.Colors.Green
	local button = Widgets.new("TextButton", {
		Name = props.Name or "Button",
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = Color3.new(1, 1, 1),
		Size = props.Size or UDim2.fromOffset(180, 56),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
	})
	Widgets.Corner(button, props.Corner or 12)
	local stroke = Widgets.Stroke(button, Widgets.Darken(color, 0.55), props.StrokeThickness or 3)
	local gradient = Widgets.Gradient(button, Widgets.Lighten(color, 0.15), Widgets.Darken(color, 0.12))

	local label = Widgets.Label({
		Name = "Label",
		Text = props.Text or "",
		Size = UDim2.new(1, -16, 1, -12),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = props.TextSize,
		ZIndex = (props.ZIndex or 1) + 1,
		Parent = button,
	})

	local scale = Widgets.new("UIScale", { Parent = button })
	local function tweenScale(target: number)
		TweenService:Create(scale, TweenInfo.new(0.08, Enum.EasingStyle.Quad), { Scale = target }):Play()
	end
	button.MouseEnter:Connect(function()
		tweenScale(1.05)
	end)
	button.MouseLeave:Connect(function()
		tweenScale(1)
	end)
	button.MouseButton1Down:Connect(function()
		tweenScale(0.92)
	end)
	button.MouseButton1Up:Connect(function()
		tweenScale(1)
	end)

	buttonColorSetters[button] = function(newColor: Color3)
		gradient.Color = ColorSequence.new(Widgets.Lighten(newColor, 0.15), Widgets.Darken(newColor, 0.12))
		stroke.Color = Widgets.Darken(newColor, 0.55)
	end

	button.Parent = props.Parent
	return button, label
end

-- Recolours a button made with Widgets.Button (e.g. Buy -> Owned).
function Widgets.SetButtonColor(button: GuiButton, color: Color3)
	local setter = buttonColorSetters[button]
	if setter then
		setter(color)
	end
end

-- Keeps UIScales proportional to the screen height so the UI fits phones.
local function viewportScale(): number
	local camera = Workspace.CurrentCamera
	local height = if camera then camera.ViewportSize.Y else 800
	return math.clamp(height / 820, 0.48, 1.3)
end

function Widgets.ViewportScale(): number
	return viewportScale()
end

function Widgets.AutoScale(parent: Instance, multiplier: number?): UIScale
	local scale = Widgets.new("UIScale", { Scale = viewportScale() * (multiplier or 1), Parent = parent })
	table.insert(autoScales, { Scale = scale, Multiplier = multiplier or 1 })
	autoMultipliers[scale] = multiplier or 1
	return scale
end

local function refreshScales()
	local value = viewportScale()
	for _, entry in autoScales do
		entry.Scale.Scale = value * entry.Multiplier
	end
end

local function watchCamera(camera: Camera?)
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(refreshScales)
		refreshScales()
	end
end
watchCamera(Workspace.CurrentCamera)
Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	watchCamera(Workspace.CurrentCamera)
end)

-- Modal panel: brown body, yellow header with a title and a red close button.
function Widgets.Panel(parent: Instance, title: string, size: Vector2): (Frame, Frame, TextButton)
	local panel = Widgets.new("Frame", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundColor3 = Widgets.Colors.Panel,
		Visible = false,
		ZIndex = 20,
		Parent = parent,
	})
	Widgets.Corner(panel, 16)
	Widgets.Stroke(panel, Widgets.Colors.PanelStroke, 4)
	Widgets.AutoScale(panel)

	local header = Widgets.new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 62),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 21,
		Parent = panel,
	})
	Widgets.Corner(header, 16)
	Widgets.Gradient(header, Color3.fromRGB(255, 222, 90), Color3.fromRGB(240, 170, 20))
	Widgets.Stroke(header, Widgets.Colors.PanelStroke, 4)

	Widgets.Label({
		Name = "Title",
		Text = title,
		Size = UDim2.new(1, -120, 0, 40),
		Position = UDim2.new(0, 20, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		TextXAlignment = Enum.TextXAlignment.Left,
		StrokeThickness = 3,
		ZIndex = 22,
		Parent = header,
	})

	local close = Widgets.Button({
		Name = "Close",
		Text = "X",
		Color = Widgets.Colors.Red,
		Size = UDim2.fromOffset(50, 50),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -8, 0, 8),
		ZIndex = 24,
		Parent = panel,
	})

	local content = Widgets.new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(18, 76),
		Size = UDim2.new(1, -36, 1, -92),
		ZIndex = 21,
		Parent = panel,
	})

	return panel, content, close
end

-- Pops a GuiObject in with a quick bounce (reuses its UIScale if it has one).
function Widgets.PopIn(gui: GuiObject)
	local scale = gui:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = Widgets.new("UIScale", { Parent = gui })
	end
	local target = 1
	local multiplier = autoMultipliers[scale]
	if multiplier then
		target = viewportScale() * multiplier
	end
	scale.Scale = target * 0.6
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = target })
		:Play()
end

return Widgets
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
