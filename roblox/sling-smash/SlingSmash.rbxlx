		Colors = {
			Color3.fromRGB(255, 60, 60),
			Color3.fromRGB(255, 200, 40),
			Color3.fromRGB(60, 230, 90),
			Color3.fromRGB(40, 200, 255),
			Color3.fromRGB(170, 80, 255),
		},
	},
}

Config.TrailsById = {}
for _, trail in Config.Trails do
	Config.TrailsById[trail.Id] = trail
end

Config.DefaultSettings = {
	Music = true,
	SFX = true,
	CameraShake = true, -- shown as "Camera Effects": shake, FOV kicks, hit-stop, roll
	SpeedLines = true,
	Hints = true,
	Performance = false, -- fewer particles, debris and shadows
}

Config.SettingsOrder = { "Music", "SFX", "CameraShake", "SpeedLines", "Hints", "Performance" }

Config.SettingLabels = {
	Music = "Music",
	SFX = "SFX",
	CameraShake = "Camera Effects",
	SpeedLines = "Speed Lines",
	Hints = "Hints",
	Performance = "Performance Mode",
}

-- Effect budgets. The client picks one from the device and Performance Mode
-- (see Client/Quality). Everything that can pile up has a cap here.
Config.Quality = {
	High = {
		Name = "High",
		MaxDebris = 80, -- smashed blocks simulated at once
		DebrisTime = 1.8,
		Particles = 1, -- particle amount multiplier
		FloatText = 26,
		BlockShadows = true,
		ViewAhead = 560, -- course drawn this far ahead of you
		ViewBehind = 60,
		SpeedLines = 24,
		Weather = 1,
		Afterimages = 6,
		Lightning = true,
		HitStop = true,
	},
	Medium = {
		Name = "Medium",
		MaxDebris = 45,
		DebrisTime = 1.4,
		Particles = 0.6,
		FloatText = 16,
		BlockShadows = false,
		ViewAhead = 440,
		ViewBehind = 50,
		SpeedLines = 16,
		Weather = 0.6,
		Afterimages = 4,
		Lightning = true,
		HitStop = true,
	},
	Low = {
		Name = "Low",
		MaxDebris = 20,
		DebrisTime = 1,
		Particles = 0.35,
		FloatText = 8,
		BlockShadows = false,
		ViewAhead = 330,
		ViewBehind = 40,
		SpeedLines = 8,
		Weather = 0.3,
		Afterimages = 2,
		Lightning = false,
		HitStop = false,
	},
}

-- Sounds built into the Roblox client work in every place without uploading
-- anything. The client checks each one loads and swaps in the fallback if not.
-- Paste an "rbxassetid://<id>" into Music to add background music.
Config.Sounds = {
	Music = "",
	Launch = "rbxasset://sounds/action_jump.mp3",
	Wind = "rbxasset://sounds/action_falling.ogg",
	Smash = "rbxasset://sounds/action_jump_land.mp3",
	Coin = "rbxasset://sounds/electronicpingshort.wav",
	Click = "rbxasset://sounds/electronicpingshort.wav",
	Charge = "rbxasset://sounds/action_swim.mp3",
	Splash = "rbxasset://sounds/impact_water.mp3",
	GetUp = "rbxasset://sounds/action_get_up.mp3",
}
Config.SoundFallbacks = {
	Coin = "rbxasset://sounds/action_get_up.mp3",
	Click = "rbxasset://sounds/action_get_up.mp3",
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">CourseLayout</string>
          <string name="Source"><![CDATA[--[[
	Deterministic obstacle course layout.

	The client builds its own copy of the course from this data (so every player
	gets a fresh, smashable course for each launch) and the server uses the same
	data to sanity-check launch reports. RunSim simulates flights against it.

	Each row of the course sits at a distance d down the lane:
	  d        smashable structures (walls, towers, pyramids)
	  d + 10   stars and power-up orbs (in the air)
	  d + 20   floating walls (from the Jungle on)
	  d + 24   hazards: swinging logs (Jungle), laser barriers (Neon)
	  d + 28   boost rings
	  d + 32   ground helpers: bounce pads, geysers (Volcanic), updrafts (Sky)
	Rows are 40-60 studs apart, so nothing from one row overlaps the next.
]]

local Config = require(script.Parent.Config)

local CourseLayout = {}

CourseLayout.Bucket = 16 -- studs per distance bucket for fast lookups

-- The distance bucket a spot belongs to (shared by RunSim and the visuals).
function CourseLayout.BucketOf(distance: number): number
	return math.floor(distance / CourseLayout.Bucket)
end

local cached = nil

function CourseLayout.ZoneIndexAt(distance: number): number
	for index, zone in Config.Zones do
		if distance < zone.EndsAt then
			return index
		end
	end
	return #Config.Zones
end

-- Chance of each special block kind per biome (by Zone.Key).
local KIND_CHANCES = {
	Sky = { TNT = 0.045, Gold = 0.03, Armor = 0, Ice = 0 },
	Jungle = { TNT = 0.04, Gold = 0.03, Armor = 0.08, Ice = 0 },
	Volcanic = { TNT = 0.07, Gold = 0.03, Armor = 0.09, Ice = 0 },
	Frozen = { TNT = 0.04, Gold = 0.03, Armor = 0.04, Ice = 0.55 },
	Neon = { TNT = 0.05, Gold = 0.035, Armor = 0.11, Ice = 0 },
}

-- Each biome opens with the power-up that suits it best.
local SIGNATURE = {
	Jungle = "Meteor", -- armored ruins
	Volcanic = "Shockwave",
	Frozen = "Rift",
	Neon = "Phase", -- laser barriers
}

-- Power-up weights per biome.
local PICKUP_WEIGHTS = {
	Sky = { Meteor = 3, Rift = 3, Phase = 1, Shockwave = 1 },
	Jungle = { Meteor = 3, Rift = 1, Phase = 3, Shockwave = 2 },
	Volcanic = { Meteor = 3, Rift = 2, Phase = 1, Shockwave = 3 },
	Frozen = { Meteor = 2, Rift = 3, Phase = 1, Shockwave = 3 },
	Neon = { Meteor = 2, Rift = 1, Phase = 4, Shockwave = 2 },
}

local function pickKind(rng: Random, zoneKey: string, allowArmor: boolean): string
	local chances = KIND_CHANCES[zoneKey] or KIND_CHANCES.Sky
	local roll = rng:NextNumber()
	if roll < chances.TNT then
		return "TNT"
	end
	roll -= chances.TNT
	if roll < chances.Gold then
		return "Gold"
	end
	roll -= chances.Gold
	if roll < chances.Armor then
		return if allowArmor then "Armor" else "Block"
	end
	roll -= chances.Armor
	if roll < chances.Ice then
		return "Ice"
	end
	return "Block"
end

local function pickWeighted(rng: Random, weights: { [string]: number }): string
	local total = 0
	for _, key in Config.AbilityOrder do
		total += weights[key] or 0
	end
	local roll = rng:NextNumber() * total
	for _, key in Config.AbilityOrder do
		roll -= weights[key] or 0
		if roll <= 0 then
			return key
		end
	end
	return Config.AbilityOrder[1]
end

function CourseLayout.Get()
	if cached then
		return cached
	end

	local rng = Random.new(Config.CourseSeed)
	local size = Config.BlockSize
	local halfLane = Config.LaneWidth / 2 - 2
	local blocks = {}
	local stars = {}
	local rings = {}
	local pickups = {}
	local barriers = {}
	local logs = {}
	local geysers = {}
	local updrafts = {}
	local pads = {}

	-- x is the block centre, level counts blocks up from the ground.
	local function addBlock(x: number, level: number, distance: number, kind: string, zone: number, colorIndex: number)
		table.insert(blocks, {
			Id = #blocks + 1,
			Position = Vector3.new(x, Config.GroundY + size / 2 + level * size, -distance),
			Kind = kind,
			Zone = zone,
			ColorIndex = colorIndex,
		})
	end

	local function wall(cx: number, distance: number, width: number, height: number, baseLevel: number, zone: number, allowArmor: boolean)
		local colorIndex = rng:NextInteger(1, 4)
		local key = Config.Zones[zone].Key
		for i = 0, width - 1 do
			for j = 0, height - 1 do
				addBlock(cx + (i - (width - 1) / 2) * size, baseLevel + j, distance, pickKind(rng, key, allowArmor), zone, colorIndex)
			end
		end
	end

	local function tower(cx: number, distance: number, height: number, zone: number)
		local colorIndex = rng:NextInteger(1, 4)
		local key = Config.Zones[zone].Key
		-- Jungle and Volcanic towers often stand on armored foundations.
		local foundation = (key == "Jungle" or key == "Volcanic") and rng:NextNumber() < 0.45
		for i = 0, 1 do
			for k = 0, 1 do
				for j = 0, height - 1 do
					local kind = if foundation and j < 2 then "Armor" else pickKind(rng, key, true)
					addBlock(cx + (i - 0.5) * size, j, distance + k * size, kind, zone, colorIndex)
				end
			end
		end
	end

	local function pyramid(cx: number, distance: number, base: number, zone: number)
		local colorIndex = rng:NextInteger(1, 4)
		local key = Config.Zones[zone].Key
		for level = 0, base - 1 do
			local count = base - level
			for i = 0, count - 1 do
				addBlock(cx + (i - (count - 1) / 2) * size, level, distance, pickKind(rng, key, true), zone, colorIndex)
			end
		end
	end

	-- Picks a centre so a structure of halfWidth fits between minX and maxX.
	local function centerIn(minX: number, maxX: number, halfWidth: number): number
		local low, high = minX + halfWidth, maxX - halfWidth
		if low >= high then
			return (minX + maxX) / 2
		end
		return rng:NextNumber(low, high)
	end

	local function addPickup(kind: string, position: Vector3, zone: number)
		table.insert(pickups, { Id = #pickups + 1, Kind = kind, Position = position, Zone = zone })
	end

	-- The first wall sits right in front of the slingshot so even a weak
	-- first launch smashes something, and a Shockwave orb waits just after it
	-- to show new players what power-ups do.
	wall(0, Config.CourseStart, 5, 5, 0, 1, false)
	addPickup("Shockwave", Vector3.new(0, Config.GroundY + 8, -(Config.CourseStart + 25)), 1)

	local distance = Config.CourseStart + 45
	local row = 0
	local previousZone = 1
	while distance < Config.LaneLength - 60 do
		row += 1
		local zone = CourseLayout.ZoneIndexAt(distance)
		local key = Config.Zones[zone].Key
		local firstRowOfBiome = zone ~= previousZone
		previousZone = zone
		local fullWall = row % 9 == 0
		local hasLog = false
		-- Hazards and helpers sit a little further down the lane than the row,
		-- so only place them if that spot is still in the same biome.
		local function sameBiome(offset: number): boolean
			return CourseLayout.ZoneIndexAt(distance + offset) == zone
		end

		if fullWall then
			-- Full-width wall: you can't steer around this one (so no armor in it).
			local width = math.floor((Config.LaneWidth - 4) / size)
			wall(0, distance, width, rng:NextInteger(2, 3), 0, zone, false)
		else
			local count = if rng:NextNumber() < 0.55 then 2 else 1
			for n = 1, count do
				local minX, maxX = -halfLane, halfLane
				if count == 2 then
					if n == 1 then
						maxX = -3
					else
						minX = 3
					end
				end

				local roll = rng:NextNumber()
				if roll < 0.5 then
					local width = rng:NextInteger(3, 7)
					local height = rng:NextInteger(3, 6)
					wall(centerIn(minX, maxX, width * size / 2), distance, width, height, 0, zone, true)
				elseif roll < 0.78 then
					tower(centerIn(minX, maxX, size), distance, rng:NextInteger(6, 12), zone)
				else
					local base = rng:NextInteger(3, 5)
					pyramid(centerIn(minX, maxX, base * size / 2), distance, base, zone)
				end
			end

			-- Hazards never share a row with a full-width wall.
			if key == "Jungle" and rng:NextNumber() < 0.55 and sameBiome(30) then
				hasLog = true
				table.insert(logs, {
					Id = #logs + 1,
					Pivot = Vector3.new(rng:NextNumber(-18, 18), Config.GroundY + 27, -(distance + 24)),
					Length = 22,
					Swing = math.rad(rng:NextNumber(45, 60)),
					Period = rng:NextNumber(2.2, 3),
					Offset = rng:NextNumber(0, math.pi * 2),
					Zone = zone,
				})
			elseif key == "Neon" and rng:NextNumber() < 0.6 and sameBiome(30) then
				-- Either a low full-width laser (fly over it) or a tall narrow one (steer around it).
				if rng:NextNumber() < 0.5 then
					table.insert(barriers, {
						Id = #barriers + 1,
						Position = Vector3.new(0, Config.GroundY, -(distance + 24)),
						Width = Config.LaneWidth,
						Height = 9,
						Zone = zone,
					})
				else
					local width = rng:NextInteger(14, 24)
					table.insert(barriers, {
						Id = #barriers + 1,
						Position = Vector3.new(centerIn(-halfLane, halfLane, width / 2), Config.GroundY, -(distance + 24)),
						Width = width,
						Height = 42,
						Zone = zone,
					})
				end
			end
		end

		-- Floating walls reward high launches later in the course.
		if zone >= 2 and not hasLog and rng:NextNumber() < 0.25 then
			local width = rng:NextInteger(3, 6)
			wall(
				centerIn(-halfLane, halfLane, width * size / 2),
				distance + 20,
				width,
				2,
				rng:NextInteger(6, 13),
				zone,
				true
			)
		end

		if rng:NextNumber() < 0.6 then
			table.insert(stars, {
				Id = #stars + 1,
				Position = Vector3.new(
					rng:NextNumber(-halfLane + 10, halfLane - 10),
					Config.GroundY + rng:NextNumber(6, 34),
					-(distance + rng:NextNumber(10, 25))
				),
				Zone = zone,
			})
		end

		if firstRowOfBiome and SIGNATURE[key] then
			addPickup(SIGNATURE[key], Vector3.new(0, Config.GroundY + 9, -(distance + 12)), zone)
		elseif rng:NextNumber() < 0.25 then
			addPickup(
				pickWeighted(rng, PICKUP_WEIGHTS[key] or PICKUP_WEIGHTS.Sky),
				Vector3.new(rng:NextNumber(-halfLane + 8, halfLane - 8), Config.GroundY + rng:NextNumber(5, 16), -(distance + 12)),
				zone
			)
		end

		local ringChance = if key == "Neon" then 0.55 else 0.3
		if rng:NextNumber() < ringChance then
			table.insert(rings, {
				Id = #rings + 1,
				Position = Vector3.new(rng:NextNumber(-18, 18), Config.GroundY + rng:NextNumber(6, 22), -(distance + 28)),
				Zone = zone,
				Big = key == "Neon",
			})
		end

		-- Ground helpers.
		local groundD = distance + 32
		if not sameBiome(40) then
			-- Too close to the next biome for ground helpers.
		elseif key == "Volcanic" then
			local count = if rng:NextNumber() < 0.5 then 2 else 1
			for n = 1, count do
				local x = if count == 2 then (if n == 1 then rng:NextNumber(-30, -8) else rng:NextNumber(8, 30)) else rng:NextNumber(-24, 24)
				table.insert(geysers, {
					Id = #geysers + 1,
					Position = Vector3.new(x, Config.GroundY, -groundD),
					Period = rng:NextNumber(2.6, 3.6),
					Active = 1.2,
					Offset = rng:NextNumber(0, 3),
					Zone = zone,
				})
			end
		elseif key == "Sky" and rng:NextNumber() < 0.35 then
			local x = (if rng:NextNumber() < 0.5 then -1 else 1) * rng:NextNumber(12, 28)
			table.insert(updrafts, {
				Id = #updrafts + 1,
				Position = Vector3.new(x, Config.GroundY, -groundD),
				Zone = zone,
			})
			-- A star waits at the top of each updraft.
			table.insert(stars, {
				Id = #stars + 1,
				Position = Vector3.new(x, Config.GroundY + rng:NextNumber(46, 60), -groundD),
				Zone = zone,
			})
		elseif key ~= "Frozen" and rng:NextNumber() < (if key == "Neon" then 0.2 else 0.28) then
			table.insert(pads, {
				Id = #pads + 1,
				Position = Vector3.new(rng:NextNumber(-26, 26), Config.GroundY, -groundD),
				Zone = zone,
			})
		end

		distance += rng:NextNumber(40, 60)
	end

	cached = {
		Blocks = blocks,
		Stars = stars,
		Rings = rings,
		Pickups = pickups,
		Barriers = barriers,
		Logs = logs,
		Geysers = geysers,
		Updrafts = updrafts,
		Pads = pads,
		TotalBlocks = #blocks,
	}
	return cached
end

--------------------------------------------------------------------------------
-- Moving hazards. Both the simulation and the visuals use these, so what you
-- see is exactly what you hit.
--------------------------------------------------------------------------------

-- Swing angle of a log at time t (radians, 0 = hanging straight down).
function CourseLayout.LogAngle(log, t: number): number
	return log.Swing * math.sin(t * math.pi * 2 / log.Period + log.Offset)
end

-- Centre of the log's heavy end at time t.
function CourseLayout.LogHead(log, t: number): Vector3
	local angle = CourseLayout.LogAngle(log, t)
	return log.Pivot + Vector3.new(math.sin(angle) * log.Length, -math.cos(angle) * log.Length, 0)
end

-- Whether a geyser is erupting at time t, and how far into the eruption (0..1).
function CourseLayout.GeyserState(geyser, t: number): (boolean, number)
	local phase = (t + geyser.Offset) % geyser.Period
	if phase < geyser.Active then
		return true, phase / geyser.Active
	end
	return false, 0
end

return CourseLayout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Daily</string>
          <string name="Source"><![CDATA[--[[
	Daily reward with a 7-day streak, based on UTC calendar days.

	Claim on consecutive days to climb the streak; miss a day and it restarts at
	day 1. After day 7 the streak stays on the day-7 reward.
]]

local Config = require(script.Parent.Config)

local Daily = {}

Daily.Rewards = { 250, 500, 1000, 2000, 4000, 7500, 15000 }
Daily.DaySeconds = 86400

function Daily.DayNumber(now: number): number
	return math.floor(now / Daily.DaySeconds)
end

-- daily = { Day = last claimed day number, Streak = streak at that claim }
-- Returns canClaim, the streak the next claim gives, seconds until next claim.
function Daily.Status(daily, now: number): (boolean, number, number)
	local today = Daily.DayNumber(now)
	local lastDay = daily and daily.Day or 0
	local streak = daily and daily.Streak or 0
	if lastDay >= today then
		return false, math.max(1, streak), (today + 1) * Daily.DaySeconds - now
	end
	local nextStreak = if lastDay == today - 1 then streak + 1 else 1
	return true, nextStreak, 0
end

function Daily.Reward(streak: number, rebirths: number?): number
	local index = math.clamp(streak, 1, #Daily.Rewards)
	return math.floor(Daily.Rewards[index] * Config.RebirthMultiplier(rebirths or 0))
end

return Daily
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--[[
	Number formatting helpers shared by the server and the UI.
]]

local Format = {}

local SUFFIXES = { "K", "M", "B", "T", "Qa", "Qi" }

-- 7880 -> "7,880"
function Format.Commas(value: number): string
	local whole = math.floor(math.abs(value))
	local digits = tostring(whole)
	local grouped = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if grouped:sub(1, 1) == "," then
		grouped = grouped:sub(2)
	end
	return (if value < 0 then "-" else "") .. grouped
end

-- 1400 -> "1.4K", 25000 -> "25K", 999 -> "999"
function Format.Short(value: number): string
	local abs = math.abs(value)
	if abs < 1000 then
		return (if value < 0 then "-" else "") .. tostring(math.floor(abs))
	end
	local index = 0
	while abs >= 1000 and index < #SUFFIXES do
		abs /= 1000
		index += 1
	end
	local text
	if abs >= 100 then
		text = tostring(math.floor(abs))
	else
		text = string.format("%.1f", math.floor(abs * 10) / 10)
		text = text:gsub("%.0$", "")
	end
	return (if value < 0 then "-" else "") .. text .. SUFFIXES[index]
end

-- Uses commas below 100K and the short form above it.
function Format.Coins(value: number): string
	if math.abs(value) < 100000 then
		return Format.Commas(value)
	end
	return Format.Short(value)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Index</string>
          <string name="Source"><![CDATA[--[[
	The Index: a collection book of things to discover. Each entry unlocks once,
	the first time a launch meets its goal, and pays a one-time coin reward.

	The server evaluates entries against its own validated launch numbers; the
	client only uses this module to draw the Index panel.
]]

local Config = require(script.Parent.Config)

local Index = {}

-- Goal types match the fields of a launch summary:
--   Distance, Smashes, Stars, Rings, Gold, TNT, Armor, Powerups, MaxCombo
Index.Entries = {
	{
		Id = "Zone1",
		Name = Config.Zones[1].Name,
		Icon = Config.Zones[1].Icon,
		Hint = "Launch for the first time",
		Goal = "Distance",
		Value = 1,
		Reward = 100,
	},
	{
		Id = "Zone2",
		Name = Config.Zones[2].Name,
		Icon = Config.Zones[2].Icon,
		Hint = "Fly " .. Config.Zones[1].EndsAt .. " studs",
		Goal = "Distance",
		Value = Config.Zones[1].EndsAt,
		Reward = 1500,
	},
	{
		Id = "Zone3",
		Name = Config.Zones[3].Name,
		Icon = Config.Zones[3].Icon,
		Hint = "Fly " .. Config.Zones[2].EndsAt .. " studs",
		Goal = "Distance",
		Value = Config.Zones[2].EndsAt,
		Reward = 6000,
	},
	{
		Id = "Zone4",
		Name = Config.Zones[4].Name,
		Icon = Config.Zones[4].Icon,
		Hint = "Fly " .. Config.Zones[3].EndsAt .. " studs",
		Goal = "Distance",
		Value = Config.Zones[3].EndsAt,
		Reward = 25000,
	},
	{
		Id = "Zone5",
		Name = Config.Zones[5].Name,
		Icon = Config.Zones[5].Icon,
		Hint = "Fly " .. Config.Zones[4].EndsAt .. " studs",
		Goal = "Distance",
		Value = Config.Zones[4].EndsAt,
		Reward = 60000,
	},
	{
		Id = "Finish",
		Name = "Finish Line",
		Icon = "🏆",
		Hint = "Reach the end of the lane",
		Goal = "Distance",
		Value = Config.LaneLength - 5,
		Reward = 100000,
	},
	{
		Id = "Gold",
		Name = "Gold Rush",
		Icon = "💛",
		Hint = "Smash a gold block",
		Goal = "Gold",
		Value = 1,
		Reward = 400,
	},
	{
		Id = "TNT",
		Name = "Kaboom",
		Icon = "💣",
		Hint = "Smash a TNT block",
		Goal = "TNT",
		Value = 1,
		Reward = 400,
	},
	{
		Id = "Star",
		Name = "Star Catcher",
		Icon = "⭐",
		Hint = "Grab a floating star",
		Goal = "Stars",
		Value = 1,
		Reward = 600,
	},
	{
		Id = "Ring",
		Name = "Ring Runner",
		Icon = "🌀",
		Hint = "Fly through a boost ring",
		Goal = "Rings",
		Value = 1,
		Reward = 600,
	},
	{
		Id = "Stars3",
		Name = "Star Shower",
		Icon = "🌟",
		Hint = "Grab 3 stars in one launch",
		Goal = "Stars",
		Value = 3,
		Reward = 4000,
	},
	{
		Id = "Combo25",
		Name = "Combo Master",
		Icon = "🔥",
		Hint = "Chain a 25-smash combo",
		Goal = "MaxCombo",
		Value = 25,
		Reward = 2500,
	},
	{
		Id = "Armor",
		Name = "Iron Breaker",
		Icon = "🛡️",
		Hint = "Break an armored block",
		Goal = "Armor",
		Value = 1,
		Reward = 2000,
	},
	{
		Id = "Powerup",
		Name = "Power Surge",
		Icon = "🔮",
		Hint = "Grab a power-up orb",
		Goal = "Powerups",
		Value = 1,
		Reward = 500,
	},
	{
		Id = "Powerups3",
		Name = "Overcharged",
		Icon = "⚡",
		Hint = "Grab 3 power-ups in one launch",
		Goal = "Powerups",
		Value = 3,
		Reward = 8000,
	},
	{
		Id = "Smash100",
		Name = "Wrecking Crew",
		Icon = "🔨",
		Hint = "Smash 100 blocks in one launch",
		Goal = "Smashes",
		Value = 100,
		Reward = 5000,
	},
	{
		Id = "Smash250",
		Name = "Demolition",
		Icon = "🏗️",
		Hint = "Smash 250 blocks in one launch",
		Goal = "Smashes",
		Value = 250,
		Reward = 20000,
	},
}

Index.ById = {}
for _, entry in Index.Entries do
	Index.ById[entry.Id] = entry
end

-- Entries this launch summary unlocks that aren't in `discovered` yet.
function Index.Evaluate(summary, discovered)
	local unlocked = {}
	for _, entry in Index.Entries do
		local value = summary[entry.Goal]
		if not discovered[entry.Id] and type(value) == "number" and value >= entry.Value then
			table.insert(unlocked, entry)
		end
	end
	return unlocked
end

function Index.Count(discovered): number
	local count = 0
	for _, entry in Index.Entries do
		if discovered[entry.Id] then
			count += 1
		end
	end
	return count
end

return Index
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Physics</string>
          <string name="Source"><![CDATA[--[[
	Pure flight physics: no Instances, no effects. The client flies with it,
	the aim preview predicts the arc with it, and the tests run it in plain Luau.

	A body is a table with Position, Velocity, Grounded and Thrust (seconds of
	Nitro thrust left). Step() moves it by one small fixed time step.
]]

local Config = require(script.Parent.Config)

local Physics = {}

export type Body = {
	Position: Vector3,
	Velocity: Vector3,
	Grounded: boolean,
	Thrust: number,
	[string]: any,
}

-- Per-step modifiers from abilities, hazards and the biome's ground.
export type Env = {
	GravityMult: number?,
	ExtraAccel: Vector3?,
	DecelMult: number?,
	DragMult: number?,
}

-- Where the flyer sits in the pouch at a given pull (0..1).
function Physics.PouchPosition(amount: number): Vector3
	local back = Config.PouchRestOffset + Config.PouchPullDistance * amount
	return Config.SlingshotPosition + Vector3.new(0, Config.PouchHeight - amount * 1.2, back)
end

-- Launch direction for an aim (degrees above the horizon, degrees right of the lane).
function Physics.AimDirection(angle: number, yaw: number): Vector3
	local a, y = math.rad(angle), math.rad(yaw)
	local flat = Config.Forward * math.cos(y) + Config.Right * math.sin(y)
	return flat * math.cos(a) + Vector3.yAxis * math.sin(a)
end

function Physics.LaunchSpeed(stats, power: number): number
	local F = Config.Flight
	return stats.LaunchSpeed * (F.MinPower + (1 - F.MinPower) * math.clamp(power, 0, 1))
end

function Physics.LaunchVelocity(stats, power: number, angle: number, yaw: number): Vector3
	return Physics.AimDirection(angle, yaw) * Physics.LaunchSpeed(stats, power)
end

function Physics.NewBody(position: Vector3, velocity: Vector3): Body
	return { Position = position, Velocity = velocity, Grounded = false, Thrust = 0 }
end

-- Moves the body by h seconds. Returns the downward speed if it touched the
-- ground this step (positive number), otherwise nil. `bounced` tells whether
-- it bounced (true) or settled into a slide (false).
function Physics.Step(body: Body, h: number, steer: number, stats, env: Env?): (number?, boolean)
	local F = Config.Flight
	local previous = body.Position
	local velocity = body.Velocity
	local gravityMult = if env and env.GravityMult then env.GravityMult else 1

	-- Steering (sideways only).
	local vx = velocity.X + steer * stats.Steer * h
	if steer == 0 then
		vx -= vx * math.min(1, F.SideDamping * h)
	end
	vx = math.clamp(vx, -F.MaxSideSpeed, F.MaxSideSpeed)
	velocity = Vector3.new(vx, velocity.Y, velocity.Z)

	-- Nitro thrust pushes along the lane.
	if body.Thrust > 0 then
		local dt = math.min(h, body.Thrust)
		body.Thrust -= h
		velocity += Config.Forward * (Config.Boost.Thrust * dt)
	end

	if env and env.ExtraAccel then
		velocity += env.ExtraAccel * h
		if env.ExtraAccel.Y > 0 then
			body.Grounded = false
		end
	end

	if body.Grounded then
		local horizontal = Vector3.new(velocity.X, 0, velocity.Z)
		local speed = horizontal.Magnitude
		if speed > 1e-3 then
			local decel = F.GroundDecel * (if env and env.DecelMult then env.DecelMult else 1)
			local drag = F.GroundDrag * (if env and env.DragMult then env.DragMult else 1)
			local newSpeed = math.max(0, speed - decel * h) * (1 - math.min(1, drag * h))
			horizontal *= newSpeed / speed
		end
		velocity = Vector3.new(horizontal.X, math.max(0, velocity.Y), horizontal.Z)
		if velocity.Y > 0 then
			body.Grounded = false
		end
	else
		velocity *= 1 - math.min(1, F.AirDrag * h)
		velocity -= Vector3.new(0, stats.Gravity * gravityMult * h, 0)
	end

	local position = previous + velocity * h

	-- Bounce off the lane rails.
	local limit = Config.LaneWidth / 2 - 1.5
	if math.abs(position.X) > limit then
		position = Vector3.new(math.sign(position.X) * limit, position.Y, position.Z)
		velocity = Vector3.new(-velocity.X * 0.4, velocity.Y, velocity.Z)
	end

	-- Ground: bounce when falling fast, otherwise start sliding.
	local contact: number? = nil
	local bounced = false
	local floor = Config.GroundY + F.BodyHeight
	if position.Y <= floor then
		position = Vector3.new(position.X, floor, position.Z)
		if velocity.Y < 0 then
			contact = -velocity.Y
		end
		if velocity.Y < -F.MinBounceSpeed then
			velocity = Vector3.new(velocity.X * F.BounceKeep, -velocity.Y * F.Bounce, velocity.Z * F.BounceKeep)
			bounced = true
		elseif velocity.Y <= 0 then
			velocity = Vector3.new(velocity.X, 0, velocity.Z)
			body.Grounded = true
		end
	end

	body.Position = position
	body.Velocity = velocity
	return contact, bounced
end

-- Predicts the arc of a launch until it first touches the ground (or maxTime).
-- Returns points spaced `spacing` seconds apart, the last position, and
-- whether that position is a real landing (false if maxTime ran out first).
function Physics.Predict(stats, start: Vector3, velocity: Vector3, maxTime: number, spacing: number): ({ Vector3 }, Vector3, boolean)
	local body = Physics.NewBody(start, velocity)
	local h = 1 / 120
	local points = { start }
	local t, nextSample = 0, spacing
	local landed = false
	while t < maxTime do
		local contact = Physics.Step(body, h, 0, stats, nil)
		t += h
		if contact then
			landed = true
			break
		end
		if t >= nextSample then
			table.insert(points, body.Position)
			nextSample += spacing
		end
	end
	return points, body.Position, landed
end

return Physics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">RunSim</string>
          <string name="Source"><![CDATA[--[[
	RunSim: the rules of one launch, with no Instances or effects.

	The client steps it every frame and turns its events into visuals and
	sound; the tests step it in plain Luau to check balance. Everything that
	changes the flight (smashing, combos, armor, power-ups, hazards, biome
	ground rules) lives here so the game and the tests can never disagree.

	Events (all optional callbacks in opts.Events):
	  OnSmash(block, info)        info = { Coins, Crit, Tier, Cause, Velocity }
	                              Cause: "hit" | "tnt" | "shockwave" | "slam" | "rift"
	  OnBonk(block, speed)        bounced off armor
	  OnPhase(block)              phased through armor
	  OnExplode(position, chainIndex)
	  OnStar(star, coins)         OnRing(ring)
	  OnPickup(pickup)            OnAbility(kind)        OnAbilityEnd(kind)
	  OnShockwave(position, radius, cause)
	  OnBoost()                   OnBounce(speed)        OnLava(position)
	  OnPad(pad)                  OnGeyser(geyser)       OnUpdraft(updraft)
	  OnBarrier(barrier, phased)  OnLog(log, phased)
	  OnSlowMo(duration)          OnZone(index)
]]

local Config = require(script.Parent.Config)
local CourseLayout = require(script.Parent.CourseLayout)
local Physics = require(script.Parent.Physics)

local RunSim = {}
RunSim.__index = RunSim

local BLOCK_HIT_RADIUS = Config.BlockSize * 0.55
local H = Config.Hazards

local function distanceToSegment(point: Vector3, a: Vector3, b: Vector3): number
	local ab = b - a
	local lengthSquared = ab:Dot(ab)
	if lengthSquared < 1e-6 then
		return (point - a).Magnitude
	end
	local t = math.clamp((point - a):Dot(ab) / lengthSquared, 0, 1)
	return (a + ab * t - point).Magnitude
end
RunSim.DistanceToSegment = distanceToSegment

local bucketOf = CourseLayout.BucketOf

-- Distance buckets for everything in the layout, built once and shared.
local index = nil
local function bucketize(list, key: string)
	local buckets = {}
	for _, item in list do
		local b = bucketOf(-item[key].Z)
		local entries = buckets[b]
		if not entries then
			entries = {}
			buckets[b] = entries
		end
		table.insert(entries, item)
	end
	return buckets
end

function RunSim.Index()
	if index then
		return index
	end
	local layout = CourseLayout.Get()
	local kinds = {}
	for _, block in layout.Blocks do
		kinds[block.Kind] = (kinds[block.Kind] or 0) + 1
	end
	index = {
		Layout = layout,
		Kinds = kinds,
		Blocks = bucketize(layout.Blocks, "Position"),
		Stars = bucketize(layout.Stars, "Position"),
		Rings = bucketize(layout.Rings, "Position"),
		Pickups = bucketize(layout.Pickups, "Position"),
		Barriers = bucketize(layout.Barriers, "Position"),
		Logs = bucketize(layout.Logs, "Pivot"),
		Geysers = bucketize(layout.Geysers, "Position"),
		Updrafts = bucketize(layout.Updrafts, "Position"),
		Pads = bucketize(layout.Pads, "Position"),
	}
	return index
end

-- Calls fn(item) for every item in buckets between distances d1 and d2 (plus margin).
local function forEachNear(buckets, d1: number, d2: number, margin: number, fn: (any) -> ())
	local low = math.min(d1, d2) - margin
	local high = math.max(d1, d2) + margin
	for b = bucketOf(low) - 1, bucketOf(high) + 1 do
		local entries = buckets[b]
		if entries then
			for _, item in entries do
				fn(item)
			end
		end
	end
end

local function horizontalDistance(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

--------------------------------------------------------------------------------

function RunSim.new(stats, start: Vector3, velocity: Vector3, opts: { [string]: any }?)
	local options = opts or {}
	local self = setmetatable({}, RunSim)
	self.Stats = stats
	self.Index = RunSim.Index()
	self.Rng = options.Rng or Random.new()
	self.Events = options.Events or {}

	-- Body (Physics.Step moves these).
	self.Position = start
	self.Velocity = velocity
	self.Grounded = false
	self.Thrust = 0

	self.Time = 0
	self.Combo = 0
	self.ComboTimer = 0
	self.MaxCombo = 0
	self.RunCoins = 0
	self.Smashes = 0
	self.Stars = 0
	self.Rings = 0
	self.Gold = 0
	self.TNT = 0
	self.Armor = 0
	self.Powerups = 0
	self.MaxTier = 0
	self.Boosts = stats.BoostCharges
	self.BoostCooldown = 0
	self.Zone = 1
	self.Ability = nil -- { Kind, TimeLeft, Duration }
	self.PullTimer = 0
	self.SlamCooldown = 0
	self.BonkCooldown = 0
	self.Done = nil -- "finish" | "stopped" | "timeout"

	self.Broken = {} -- [blockId] = true
	self.Phased = {} -- [blockId] = true
	self.Used = {} -- ["Star3"] = true, one-time pickups, rings, barriers
	self.Cooldowns = {} -- ["Log2"] = time it can trigger again
	self.InUpdraft = nil
	self.UpdraftTime = {} -- [updraftId] = seconds spent inside
	self.SlowTime = 0 -- seconds spent crawling (ends stuck runs)
	return self
end

function RunSim:_fire(name: string, ...)
	local callback = self.Events[name]
	if callback then
		callback(...)
	end
end

function RunSim:AbilityKind(): string?
	return if self.Ability then self.Ability.Kind else nil
end

function RunSim:HitRadius(): number
	local radius = self.Stats.HitRadius
	if self:AbilityKind() == "Meteor" then
		radius += Config.Abilities.Meteor.RadiusBonus
	end
	return radius
end

function RunSim:Distance(): number
	return math.max(0, -self.Position.Z)
end

function RunSim:BreakCombo()
	self.Combo = 0
	self.ComboTimer = 0
end

--------------------------------------------------------------------------------
-- Smashing
--------------------------------------------------------------------------------

local CAUSE_TIER = { tnt = 2, shockwave = 3, slam = 2, rift = 1 }

function RunSim:_smash(block, cause: string, fling: Vector3, minTier: number?)
	self.Broken[block.Id] = true
	local info = Config.Blocks[block.Kind] or Config.Blocks.Block
	local stats = self.Stats
	self.Smashes += 1
	if self.ComboTimer > 0 then
		self.Combo += 1
	else
		self.Combo = 1
	end
	self.ComboTimer = stats.ComboWindow
	self.MaxCombo = math.max(self.MaxCombo, self.Combo)

	local multiplier = Config.ComboMultiplier(self.Combo, stats.MaxComboMult)
	local crit = self.Rng:NextNumber() < Config.CritChance
	local zone = Config.Zones[block.Zone]
	local coins = math.floor(
		info.Value
			* zone.ValueMult
			* stats.SmashCoinMult
			* multiplier
			* (if crit then Config.CritMultiplier else 1)
			* stats.CoinMult
	)
	self.RunCoins += coins
	if block.Kind == "Gold" then
		self.Gold += 1
	elseif block.Kind == "TNT" then
		self.TNT += 1
	elseif block.Kind == "Armor" then
		self.Armor += 1
	end

	local tier
	if cause == "hit" then
		local bonus = (if crit then 1 else 0) + (if self:AbilityKind() == "Meteor" then 1 else 0)
		tier = Config.ImpactTier(self.Velocity.Magnitude, info.Durability, bonus)
	else
		tier = CAUSE_TIER[cause] or 1
	end
	tier = math.max(tier, minTier or 1)
	self.MaxTier = math.max(self.MaxTier, tier)

	self:_fire("OnSmash", block, { Coins = coins, Crit = crit, Tier = tier, Cause = cause, Velocity = fling })
end

-- Every unbroken block within radius of a point.
function RunSim:BlocksNear(center: Vector3, radius: number)
	local found = {}
	local d = -center.Z
	forEachNear(self.Index.Blocks, d, d, radius, function(block)
		if not self.Broken[block.Id] and (block.Position - center).Magnitude <= radius then
			table.insert(found, block)
		end
	end)
	return found
end

-- Explodes one or more TNT blocks (already smashed) and everything they chain
-- into. However many TNT go off together, you get one boost.
function RunSim:_explode(sources)
	local queue = table.clone(sources)
	local chain = 0
	local blast = Config.Blocks.TNT
	while #queue > 0 do
		local source = table.remove(queue, 1)
		chain += 1
		self:_fire("OnExplode", source.Position, chain)
		for _, other in self:BlocksNear(source.Position, blast.BlastRadius) do
			local away = other.Position - source.Position
			local push = if away.Magnitude > 0.01 then away.Unit * 45 else Vector3.zero
			self:_smash(other, "tnt", self.Velocity * 0.4 + push)
			if other.Kind == "TNT" then
				table.insert(queue, other)
			end
		end
	end
	self.Velocity += Config.Forward * blast.Boost
	self.Velocity = Vector3.new(self.Velocity.X, math.max(self.Velocity.Y, blast.Lift), self.Velocity.Z)
	self.Grounded = false
	self:_fire("OnSlowMo", Config.SlowMo.Duration)
end

-- Smashes everything nearby (armor too) and pushes it outwards.
function RunSim:_shockwave(center: Vector3, radius: number, cause: string, maxBlocks: number, lift: number?, boost: number?)
	self:_fire("OnShockwave", center, radius, cause)
	local tnt = {}
	local count = 0
	for _, block in self:BlocksNear(center, radius) do
		if count >= maxBlocks then
			break
		end
		count += 1
		local away = block.Position - center
		local push = if away.Magnitude > 0.01 then away.Unit * 70 else Vector3.yAxis * 40
		self:_smash(block, cause, push + Vector3.new(0, 30, 0))
		if block.Kind == "TNT" then
			table.insert(tnt, block)
		end
	end
	if lift then
		self.Velocity = Vector3.new(self.Velocity.X, math.max(self.Velocity.Y, lift), self.Velocity.Z)
		self.Grounded = false
	end
	if boost then
		self.Velocity += Config.Forward * boost
	end
	if #tnt > 0 then
		self:_explode(tnt)
	end
end

function RunSim:_bonk(block, speed: number)
	if self.BonkCooldown > 0 then
		return
	end
	self.BonkCooldown = 0.3
	local v = self.Velocity
	local along = v:Dot(Config.Forward)
	local side = v - Config.Forward * along - Vector3.yAxis * v.Y
	self.Velocity = side * 0.4 - Config.Forward * (math.abs(along) * 0.25) + Vector3.yAxis * math.max(v.Y, 16)
	self.Grounded = false
	self:BreakCombo()
	self:_fire("OnBonk", block, speed)
end

function RunSim:_onBlock(block)
	if self.Broken[block.Id] or self.Phased[block.Id] then
		return
	end
	local info = Config.Blocks[block.Kind] or Config.Blocks.Block
	local ability = self:AbilityKind()
	local speed = self.Velocity.Magnitude

	if block.Kind == "Armor" then
		if ability == "Meteor" or speed >= info.BreakSpeed then
			self:_smash(block, "hit", self.Velocity, 3)
			if ability ~= "Meteor" then
				self.Velocity *= 1 - info.Slowdown * self.Stats.SmashSlow
			end
		elseif ability == "Phase" then
			self.Phased[block.Id] = true
			self:_fire("OnPhase", block)
		else
			self:_bonk(block, speed)
		end
		return
	end

	self:_smash(block, "hit", self.Velocity)
	if ability ~= "Meteor" then
		self.Velocity *= 1 - info.Slowdown * self.Stats.SmashSlow
	end
	if block.Kind == "TNT" then
		self:_explode({ block })
	end
end

--------------------------------------------------------------------------------
-- Power-ups and boosts
--------------------------------------------------------------------------------

function RunSim:Boost(): boolean
	if self.Done or self.Boosts <= 0 or self.BoostCooldown > 0 then
		return false
	end
	local cfg = Config.Boost
	self.Boosts -= 1
	self.BoostCooldown = cfg.Cooldown
	self.Velocity += Config.Forward * cfg.Impulse
	self.Velocity = Vector3.new(self.Velocity.X, math.max(self.Velocity.Y, cfg.Lift), self.Velocity.Z)
	self.Grounded = false
	self.Thrust = cfg.ThrustTime
	self:_fire("OnBoost")
	return true
end

function RunSim:_endAbility()
	local ability = self.Ability
	if ability then
		self.Ability = nil
		self:_fire("OnAbilityEnd", ability.Kind)
	end
end

function RunSim:_activate(pickup)
	self.Used["Pickup" .. pickup.Id] = true
	self.Powerups += 1
	self:_fire("OnPickup", pickup)
	local cfg = Config.Abilities[pickup.Kind]
	if not cfg then
		return
	end
	if pickup.Kind == "Shockwave" then
		self:_shockwave(self.Position, cfg.Radius, "shockwave", cfg.MaxBlocks, cfg.Lift, cfg.Boost)
		return
	end
	self:_endAbility()
	self.Ability = { Kind = pickup.Kind, TimeLeft = cfg.Duration, Duration = cfg.Duration }
	self.PullTimer = 0
	self:_fire("OnAbility", pickup.Kind)
end

function RunSim:_riftPull(h: number)
	local cfg = Config.Abilities.Rift
	self.PullTimer -= h
	if self.PullTimer > 0 then
		return
	end
	self.PullTimer = cfg.PullInterval
	local pulled = 0
	local tnt = {}
	for _, block in self:BlocksNear(self.Position, cfg.PullRadius) do
		if pulled >= cfg.PullMax then
			break
		end
		if block.Kind ~= "Armor" then
			pulled += 1
			local toward = self.Position - block.Position
			local fling = if toward.Magnitude > 0.01 then toward.Unit * 60 else Vector3.zero
			self:_smash(block, "rift", fling)
			if block.Kind == "TNT" then
				table.insert(tnt, block)
			end
		end
	end
	if #tnt > 0 then
		self:_explode(tnt)
	end
end

--------------------------------------------------------------------------------
-- Stepping
--------------------------------------------------------------------------------

-- Makes sure launchers never send you straight up and back onto themselves.
function RunSim:_ensureForward(minimum: number)
	local along = self.Velocity:Dot(Config.Forward)
	if along < minimum then
		self.Velocity += Config.Forward * (minimum - along)
	end
end

function RunSim:_cooldownReady(key: string, duration: number): boolean
	local readyAt = self.Cooldowns[key]
	if readyAt and self.Time < readyAt then
		return false
	end
	self.Cooldowns[key] = self.Time + duration
	return true
end

-- One fixed substep of length h with steering input -1..1.
function RunSim:Step(h: number, steer: number)
	if self.Done then
		return
	end
	local stats = self.Stats
	local idx = self.Index
	local previous = self.Position
	self.Time += h
	self.BoostCooldown = math.max(0, self.BoostCooldown - h)
	self.SlamCooldown = math.max(0, self.SlamCooldown - h)
	self.BonkCooldown = math.max(0, self.BonkCooldown - h)

	if self.Ability then
		self.Ability.TimeLeft -= h
		if self.Ability.TimeLeft <= 0 then
			self:_endAbility()
		end
	end

	local distance = -previous.Z
	local zoneIndex = CourseLayout.ZoneIndexAt(math.max(0, distance))
	local zone = Config.Zones[zoneIndex]
	local rule = Config.GroundRules[zone.Ground] or Config.GroundRules.Grass

	-- Updrafts push up while you're inside the column.
	local extra: Vector3? = nil
	-- Each updraft only carries you for a limited time, so you can't hover forever.
	local inside = nil
	forEachNear(idx.Updrafts, distance, distance, H.Updraft.Radius, function(updraft)
		if
			horizontalDistance(previous, updraft.Position) <= H.Updraft.Radius
			and previous.Y - updraft.Position.Y <= H.Updraft.Height
			and (self.UpdraftTime[updraft.Id] or 0) < H.Updraft.MaxTime
		then
			inside = updraft
		end
	end)
	if inside then
		self.UpdraftTime[inside.Id] = (self.UpdraftTime[inside.Id] or 0) + h
		extra = Vector3.new(0, H.Updraft.Accel, 0) + Config.Forward * H.Updraft.Drift
		if self.InUpdraft ~= inside then
			self:_fire("OnUpdraft", inside)
		end
	end
	self.InUpdraft = inside

	local env = {
		GravityMult = if self:AbilityKind() == "Rift" then Config.Abilities.Rift.GravityMult else 1,
		ExtraAccel = extra,
		DecelMult = rule.DecelMult,
		DragMult = rule.DragMult,
	}
	local contact, bounced = Physics.Step(self, h, steer, stats, env)
	local position = self.Position

	-- End of the lane.
	if -position.Z >= Config.LaneLength then
		self.Position = Vector3.new(position.X, position.Y, -Config.LaneLength)
		self.Velocity = Vector3.zero
		self.Done = "finish"
		return
	end

	-- Ground contact: slams, bounce pads, lava.
	if contact or self.Grounded then
		if contact and contact >= Config.Slam.MinSpeed and self.SlamCooldown <= 0 then
			self.SlamCooldown = Config.Slam.Cooldown
			self:_shockwave(position, Config.Slam.Radius, "slam", 30, nil, nil)
		end
		local pad = nil
		forEachNear(idx.Pads, -position.Z, -position.Z, H.Pad.Radius, function(candidate)
			if horizontalDistance(position, candidate.Position) <= H.Pad.Radius then
				pad = candidate
			end
		end)
		local horizontalSpeed = Vector3.new(self.Velocity.X, 0, self.Velocity.Z).Magnitude
		if pad and self:_cooldownReady("Pad" .. pad.Id, H.Pad.Cooldown) then
			self.Velocity = Vector3.new(self.Velocity.X, H.Pad.Lift, self.Velocity.Z) + Config.Forward * H.Pad.Push
			self:_ensureForward(H.MinExitSpeed)
			self.Grounded = false
			self:_fire("OnPad", pad)
		elseif rule.BounceSpeed and horizontalSpeed > rule.MinSpeed then
			local v = self.Velocity
			self.Velocity = Vector3.new(v.X * rule.Keep, math.max(v.Y, rule.BounceSpeed), v.Z * rule.Keep)
			self.Grounded = false
			self:_fire("OnLava", position)
		elseif contact and bounced then
			self:_fire("OnBounce", contact)
		end
	end

	-- Smashable blocks along this step's path.
	local radius = self:HitRadius()
	local d1, d2 = -previous.Z, -position.Z
	forEachNear(idx.Blocks, d1, d2, radius + BLOCK_HIT_RADIUS, function(block)
		if
			not self.Broken[block.Id]
			and distanceToSegment(block.Position, previous, position) <= radius + BLOCK_HIT_RADIUS
		then
			self:_onBlock(block)
		end
	end)

	forEachNear(idx.Stars, d1, d2, radius + Config.StarRadius, function(star)
		local key = "Star" .. star.Id
		if not self.Used[key] and distanceToSegment(star.Position, previous, position) <= radius + Config.StarRadius then
			self.Used[key] = true
			self.Stars += 1
			local coins = math.floor(Config.StarValue * Config.Zones[star.Zone].ValueMult * stats.CoinMult)
			self.RunCoins += coins
			self:_fire("OnStar", star, coins)
		end
	end)

	forEachNear(idx.Rings, d1, d2, Config.BigRingRadius, function(ring)
		local key = "Ring" .. ring.Id
		local ringRadius = if ring.Big then Config.BigRingRadius else Config.RingRadius
		if not self.Used[key] and distanceToSegment(ring.Position, previous, position) <= ringRadius then
			self.Used[key] = true
			self.Rings += 1
			local push = if ring.Big then Config.BigRingBoost else Config.RingBoost
			self.Velocity += Config.Forward * push
			self.Velocity = Vector3.new(self.Velocity.X, math.max(self.Velocity.Y, Config.RingLift), self.Velocity.Z)
			self.Grounded = false
			self:_fire("OnRing", ring)
		end
	end)

	local pickupReach = Config.PickupRadius + H.BodyRadius
	forEachNear(idx.Pickups, d1, d2, pickupReach, function(pickup)
		if
			not self.Used["Pickup" .. pickup.Id]
			and distanceToSegment(pickup.Position, previous, position) <= pickupReach
		then
			self:_activate(pickup)
		end
	end)

	local phase = self:AbilityKind() == "Phase"

	-- Laser barriers: a vertical wall across part of the lane.
	forEachNear(idx.Barriers, d1, d2, 2, function(barrier)
		local key = "Barrier" .. barrier.Id
		local z = barrier.Position.Z
		if self.Used[key] or (previous.Z - z) * (position.Z - z) > 0 or previous.Z == position.Z then
			return
		end
		local t = (z - previous.Z) / (position.Z - previous.Z)
		local cross = previous + (position - previous) * t
		local withinX = math.abs(cross.X - barrier.Position.X) <= barrier.Width / 2 + H.BodyRadius
		local withinY = cross.Y - barrier.Position.Y <= barrier.Height + H.BodyRadius * 0.5
		if withinX and withinY then
			self.Used[key] = true
			if not phase then
				self.Velocity *= H.Barrier.SpeedKeep
				self:BreakCombo()
			end
			self:_fire("OnBarrier", barrier, phase)
		end
	end)

	-- Swinging logs knock you sideways.
	forEachNear(idx.Logs, d1, d2, H.Log.Radius + H.BodyRadius, function(log)
		local head = CourseLayout.LogHead(log, self.Time)
		if distanceToSegment(head, previous, position) > H.Log.Radius + H.BodyRadius then
			return
		end
		if not self:_cooldownReady("Log" .. log.Id, H.Log.Cooldown) then
			return
		end
		if not phase then
			-- Push the way the log is swinging.
			local swingDirection = math.cos(self.Time * math.pi * 2 / log.Period + log.Offset)
			local push = Config.Right * (if swingDirection >= 0 then 1 else -1) * H.Log.Push
			local v = self.Velocity
			self.Velocity = Vector3.new(v.X, math.max(v.Y, 22), v.Z * 0.55) + push
			self.Grounded = false
			self:BreakCombo()
		end
		self:_fire("OnLog", log, phase)
	end)

	-- Erupting geysers launch you skywards.
	forEachNear(idx.Geysers, d1, d2, H.Geyser.Radius, function(geyser)
		local active = CourseLayout.GeyserState(geyser, self.Time)
		if
			active
			and horizontalDistance(position, geyser.Position) <= H.Geyser.Radius
			and position.Y - geyser.Position.Y <= H.Geyser.Height
			and self:_cooldownReady("Geyser" .. geyser.Id, H.Geyser.Cooldown)
		then
			self.Velocity = Vector3.new(self.Velocity.X, math.max(self.Velocity.Y, H.Geyser.Lift), self.Velocity.Z)
				+ Config.Forward * H.Geyser.Push
			self:_ensureForward(H.MinExitSpeed)
			self.Grounded = false
			self:_fire("OnGeyser", geyser)
		end
	end)

	if self:AbilityKind() == "Rift" then
		self:_riftPull(h)
	end

	if self.ComboTimer > 0 then
		self.ComboTimer -= h
		if self.ComboTimer <= 0 then
			self.Combo = 0
		end
	end

	local newZone = CourseLayout.ZoneIndexAt(self:Distance())
	if newZone > self.Zone then
		self.Zone = newZone
		self:_fire("OnZone", newZone)
	end

	-- Progress is speed along the lane; sliding sideways on ice doesn't count.
	local laneSpeed = math.abs(self.Velocity:Dot(Config.Forward))
	if laneSpeed < Config.Flight.CrawlSpeed and self.Thrust <= 0 then
		self.SlowTime += h
	else
		self.SlowTime = 0
	end
	if self.Grounded and laneSpeed < Config.Flight.StopSpeed and self.Thrust <= 0 then
		self.Done = "stopped"
	elseif self.SlowTime > Config.Flight.CrawlTime then
		-- Barely moving for a while (e.g. bouncing in place): call it.
		self.Done = "stopped"
	elseif self.Time > Config.Flight.MaxFlightTime then
		self.Done = "timeout"
	end
end

-- What the client reports to the server when the launch ends.
function RunSim:Report()
	return {
		Distance = self:Distance(),
		Smashes = self.Smashes,
		Stars = self.Stars,
		Rings = self.Rings,
		Gold = self.Gold,
		TNT = self.TNT,
		Armor = self.Armor,
		Powerups = self.Powerups,
		MaxCombo = self.MaxCombo,
		RunCoins = self.RunCoins,
	}
end

return RunSim
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="11">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="12">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Sling Smash - server entry point.

	Builds the world, owns player data (coins, upgrades, trails, settings),
	and validates launch results reported by clients.
]]

local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local CourseLayout = require(Shared:WaitForChild("CourseLayout"))
local Daily = require(Shared:WaitForChild("Daily"))
local Index = require(Shared:WaitForChild("Index"))

local Codes = require(script.Codes)
local DataService = require(script.DataService)
local Leaderboard = require(script.Leaderboard)
local WorldBuilder = require(script.WorldBuilder)

Players.CharacterAutoLoads = false

--------------------------------------------------------------------------------
-- Collision groups
--   Players: walking characters (don't push each other around the slingshot)
--   Flyer:   a character mid-launch (set by its own client; passes through all)
--   Debris:  smashed blocks flying around (never hit characters)
--------------------------------------------------------------------------------

for _, name in { "Players", "Flyer", "Debris" } do
	if not PhysicsService:IsCollisionGroupRegistered(name) then
		PhysicsService:RegisterCollisionGroup(name)
	end
end
PhysicsService:CollisionGroupSetCollidable("Players", "Players", false)
PhysicsService:CollisionGroupSetCollidable("Flyer", "Default", false)
PhysicsService:CollisionGroupSetCollidable("Flyer", "Players", false)
PhysicsService:CollisionGroupSetCollidable("Flyer", "Flyer", false)
PhysicsService:CollisionGroupSetCollidable("Flyer", "Debris", false)
PhysicsService:CollisionGroupSetCollidable("Debris", "Players", false)
-- Flung blocks don't collide with each other: far fewer contacts in big chains.
PhysicsService:CollisionGroupSetCollidable("Debris", "Debris", false)

--------------------------------------------------------------------------------
-- Remotes
--------------------------------------------------------------------------------

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"

local function remote(className: string, name: string): any
	local instance = Instance.new(className)
	instance.Name = name
	instance.Parent = remotes
	return instance
end

local GetData = remote("RemoteFunction", "GetData") :: RemoteFunction
local DataChanged = remote("RemoteEvent", "DataChanged") :: RemoteEvent
local StartLaunch = remote("RemoteFunction", "StartLaunch") :: RemoteFunction
local FinishLaunch = remote("RemoteFunction", "FinishLaunch") :: RemoteFunction
local BuyUpgrade = remote("RemoteFunction", "BuyUpgrade") :: RemoteFunction
local Rebirth = remote("RemoteFunction", "Rebirth") :: RemoteFunction
local BuyTrail = remote("RemoteFunction", "BuyTrail") :: RemoteFunction
local EquipTrail = remote("RemoteFunction", "EquipTrail") :: RemoteFunction
local UpdateSetting = remote("RemoteEvent", "UpdateSetting") :: RemoteEvent
local ClaimDaily = remote("RemoteFunction", "ClaimDaily") :: RemoteFunction
local RedeemCode = remote("RemoteFunction", "RedeemCode") :: RemoteFunction

remotes.Parent = ReplicatedStorage

--------------------------------------------------------------------------------
-- World
--------------------------------------------------------------------------------

local map = WorldBuilder.Build()

Leaderboard.Init(map, function(player)
	local data = DataService.Get(player)
	return if data then data.BestDistance else 0
end)

local layout = CourseLayout.Get()
local layoutKinds = { Block = 0, Ice = 0, Gold = 0, TNT = 0, Armor = 0 }
for _, block in layout.Blocks do
	layoutKinds[block.Kind] = (layoutKinds[block.Kind] or 0) + 1
end

--------------------------------------------------------------------------------
-- Characters + trails
--------------------------------------------------------------------------------

local function applyTrail(player: Player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	for _, child in root:GetChildren() do
		if child.Name == "SlingTrail" or child.Name == "SlingTrailA0" or child.Name == "SlingTrailA1" then
			child:Destroy()
		end
	end

	local data = DataService.Get(player)
	local trailInfo = data and Config.TrailsById[data.EquippedTrail]
	if not trailInfo or not trailInfo.Colors then
		return
	end

	-- Attachments sit shoulder-to-shoulder so the ribbon is wide whether the
	-- character is standing or flying superman-style.
	local a0 = Instance.new("Attachment")
	a0.Name = "SlingTrailA0"
	a0.Position = Vector3.new(-1.2, 0, 0)
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Name = "SlingTrailA1"
	a1.Position = Vector3.new(1.2, 0, 0)
	a1.Parent = root

	local keypoints = {}
	local colors = trailInfo.Colors
	for i, color in colors do
		local time = if #colors == 1 then 0 else (i - 1) / (#colors - 1)
		table.insert(keypoints, ColorSequenceKeypoint.new(time, color))
	end
	if #keypoints == 1 then
		table.insert(keypoints, ColorSequenceKeypoint.new(1, colors[1]))
	end

	local trail = Instance.new("Trail")
	trail.Name = "SlingTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(keypoints)
	trail.Lifetime = 0.6
	trail.MinLength = 0.1
	trail.FaceCamera = true
	trail.LightEmission = 0.6
	trail.Transparency = NumberSequence.new(0.1, 1)
	trail.WidthScale = NumberSequence.new(1, 0.2)
	trail.Parent = root
end

local function setCollisionGroup(instance: Instance)
	if instance:IsA("BasePart") then
		instance.CollisionGroup = "Players"
	end
end

local function spawnCharacter(player: Player)
	if player.Parent ~= Players then
		return
	end
	local ok, err = pcall(function()
		player:LoadCharacterAsync()
	end)
	if not ok then
		warn("[SlingSmash] Could not spawn", player.Name, err)
	end
end

local function onCharacterAdded(player: Player, character: Model)
	for _, descendant in character:GetDescendants() do
		setCollisionGroup(descendant)
	end
	character.DescendantAdded:Connect(setCollisionGroup)

	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if humanoid then
		humanoid.Died:Connect(function()
			task.wait(2.5)
			spawnCharacter(player)
		end)
	end

	character:WaitForChild("HumanoidRootPart", 10)
	applyTrail(player)
end

DataService.OnChanged(function(player, data)
	DataChanged:FireClient(player, data)
end)

local function onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)

	local data = DataService.Load(player)
	if data then
		-- Seed the global board with bests from before it existed.
		Leaderboard.Submit(player, data.BestDistance)
	end
	spawnCharacter(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	DataService.Release(player)
end)

game:BindToClose(function()
	-- Write leaderboard bests and player data in parallel, and wait for both.
	local flushed = false
	task.spawn(function()
		Leaderboard.Flush()
		flushed = true
	end)
	DataService.SaveAll()
	local deadline = os.clock() + 20
	while not flushed and os.clock() < deadline do
		task.wait(0.1)
	end
end)

task.spawn(function()
	while true do
		task.wait(Config.AutosaveInterval)
		for _, player in Players:GetPlayers() do
			task.spawn(DataService.Save, player)
		end
	end
end)

--------------------------------------------------------------------------------
-- Launch validation
--------------------------------------------------------------------------------

local sessions = {} -- [Player] = { Id, StartedAt, Active }

Players.PlayerRemoving:Connect(function(player)
	sessions[player] = nil
end)

-- tonumber that also rejects NaN and infinities from untrusted input.
local function safeNumber(value: any): number
	local n = tonumber(value)
	if n == nil or n ~= n or n == math.huge or n == -math.huge then
		return 0
	end
	return n
end

GetData.OnServerInvoke = function(player)
	return DataService.WaitFor(player, 20)
end

StartLaunch.OnServerInvoke = function(player)
	if not DataService.Get(player) then
		return nil
	end
	local session = sessions[player] or { Id = 0 }
	session.Id += 1
	session.StartedAt = os.clock()
	session.Active = true
	sessions[player] = session
	return session.Id
end

FinishLaunch.OnServerInvoke = function(player, launchId, report)
	local data = DataService.Get(player)
	local session = sessions[player]
	if not data or not session or not session.Active or session.Id ~= launchId or type(report) ~= "table" then
		return nil
	end
	session.Active = false

	local elapsed = os.clock() - session.StartedAt
	local stats = Config.ComputeStats(data.Upgrades, data.Rebirths)

	-- Clamp every reported number to what is physically possible.
	local limits = Config.LaunchLimits(stats, elapsed, layout.TotalBlocks)
	local distance = math.clamp(safeNumber(report.Distance), 0, limits.MaxDistance)
	local smashes = math.clamp(math.floor(safeNumber(report.Smashes)), 0, limits.MaxSmashes)
	local stars = math.clamp(math.floor(safeNumber(report.Stars)), 0, #layout.Stars)
	local rings = math.clamp(math.floor(safeNumber(report.Rings)), 0, #layout.Rings)
	local gold = math.clamp(math.floor(safeNumber(report.Gold)), 0, math.min(smashes, layoutKinds.Gold))
	local tnt = math.clamp(math.floor(safeNumber(report.TNT)), 0, math.min(smashes, layoutKinds.TNT))
	local armor = math.clamp(math.floor(safeNumber(report.Armor)), 0, math.min(smashes, layoutKinds.Armor))
	local powerups = math.clamp(math.floor(safeNumber(report.Powerups)), 0, #layout.Pickups)
	local maxCombo = math.clamp(math.floor(safeNumber(report.MaxCombo)), 0, smashes)

	local ceiling = Config.CoinCeiling(stats, smashes, stars)
	local runCoins = math.clamp(math.floor(safeNumber(report.RunCoins)), 0, math.floor(ceiling))
	local distanceCoins = math.floor(distance * Config.CoinsPerStud * stats.CoinMult)
	local earned = runCoins + distanceCoins

	-- Index discoveries pay a one-time bonus on top of the launch.
	local discoveries = {}
	local discoveryCoins = 0
	local summary = {
		Distance = distance,
		Smashes = smashes,
		Stars = stars,
		Rings = rings,
		Gold = gold,
		TNT = tnt,
		Armor = armor,
		Powerups = powerups,
		MaxCombo = maxCombo,
	}
	for _, entry in Index.Evaluate(summary, data.Index) do
		data.Index[entry.Id] = true
		discoveryCoins += entry.Reward
		table.insert(discoveries, { Id = entry.Id, Name = entry.Name, Icon = entry.Icon, Reward = entry.Reward })
	end
	earned += discoveryCoins

	local newBest = distance > data.BestDistance
	data.Coins += earned
	if newBest then
		data.BestDistance = math.floor(distance)
		Leaderboard.Submit(player, data.BestDistance)
	end
	data.Stats.Launches += 1
	data.Stats.TotalSmashes += smashes
	data.Stats.TotalCoins += earned
	data.Stats.TotalDistance += math.floor(distance)
	data.Stats.StarsCollected += stars
	data.Stats.BestCombo = math.max(data.Stats.BestCombo, maxCombo)
	DataService.Changed(player)

	return {
		Earned = earned,
		RunCoins = runCoins,
		DistanceCoins = distanceCoins,
		Distance = math.floor(distance),
		Smashes = smashes,
		MaxCombo = maxCombo,
		Stars = stars,
		NewBest = newBest,
		Best = data.BestDistance,
		Discoveries = discoveries,
		DiscoveryCoins = discoveryCoins,
	}
end

--------------------------------------------------------------------------------
-- Upgrades, rebirth, trails, settings
--------------------------------------------------------------------------------

BuyUpgrade.OnServerInvoke = function(player, nodeId)
	local data = DataService.Get(player)
	local node = type(nodeId) == "string" and Config.NodesById[nodeId]
	if not data or not node then
		return false, "Unknown upgrade"
	end
	if data.Upgrades[node.Id] then
		return false, "Already owned"
	end
	if node.Requires ~= "Start" and not data.Upgrades[node.Requires] then
		return false, "Unlock the previous upgrade first"
	end
	if data.Coins < node.Cost then
		return false, "Not enough coins"
	end
	data.Coins -= node.Cost
	data.Upgrades[node.Id] = true
	DataService.Changed(player)
	return true
end

Rebirth.OnServerInvoke = function(player)
	local data = DataService.Get(player)
	if not data then
		return false, "Data not loaded"
	end
	local cost = Config.RebirthCost(data.Rebirths)
	if data.Coins < cost then
		return false, "Not enough coins"
	end
	data.Coins = 0
	data.Upgrades = {}
	data.Rebirths += 1
	DataService.Changed(player)
	return true
end

BuyTrail.OnServerInvoke = function(player, trailId)
	local data = DataService.Get(player)
	local trail = type(trailId) == "string" and Config.TrailsById[trailId]
	if not data or not trail then
		return false, "Unknown trail"
	end
	if data.Trails[trail.Id] then
		return false, "Already owned"
	end
	if data.Coins < trail.Price then
		return false, "Not enough coins"
	end
	data.Coins -= trail.Price
	data.Trails[trail.Id] = true
	data.EquippedTrail = trail.Id
	DataService.Changed(player)
	applyTrail(player)
	return true
end

EquipTrail.OnServerInvoke = function(player, trailId)
	local data = DataService.Get(player)
	if not data or type(trailId) ~= "string" or not data.Trails[trailId] then
		return false, "Trail not owned"
	end
	data.EquippedTrail = trailId
	DataService.Changed(player)
	applyTrail(player)
	return true
end

ClaimDaily.OnServerInvoke = function(player)
	local data = DataService.Get(player)
	if not data then
		return false, "Data not loaded"
	end
	local now = os.time()
	local canClaim, streak = Daily.Status(data.Daily, now)
	if not canClaim then
		return false, "Already claimed today"
	end
	local reward = Daily.Reward(streak, data.Rebirths)
	data.Daily.Day = Daily.DayNumber(now)
	data.Daily.Streak = streak
	data.Coins += reward
	DataService.Changed(player)
	return true, reward
end

local lastCodeAttempt = {} -- [Player] = os.clock()
Players.PlayerRemoving:Connect(function(player)
	lastCodeAttempt[player] = nil
end)

RedeemCode.OnServerInvoke = function(player, text)
	local data = DataService.Get(player)
	if not data then
		return false, "Data not loaded"
	end
	local now = os.clock()
	if lastCodeAttempt[player] and now - lastCodeAttempt[player] < 1 then
		return false, "Slow down!"
	end
	lastCodeAttempt[player] = now

	local code = Config.NormalizeCode(text)
	local reward = code and Codes[code]
	if not code or not reward then
		return false, "That code doesn't exist"
	end
	if data.Codes[code] then
		return false, "You already used that code"
	end
	data.Codes[code] = true
	data.Coins += reward
	DataService.Changed(player)
	return true, reward
end

UpdateSetting.OnServerEvent:Connect(function(player, key, value)
	local data = DataService.Get(player)
	if not data or type(key) ~= "string" or type(value) ~= "boolean" then
		return
	end
	if Config.DefaultSettings[key] == nil then
		return
	end
	data.Settings[key] = value
end)

print(
	"[SlingSmash] Server ready -",
	layout.TotalBlocks,
	"blocks,",
	#layout.Stars,
	"stars,",
	#layout.Rings,
	"rings,",
	#layout.Pickups,
	"power-ups"
)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Codes</string>
          <string name="Source"><![CDATA[--[[
	Redeemable codes and their coin rewards. Each player can use each code once.
	Keys must be upper case with no spaces (see Config.NormalizeCode).

	This lives on the server, so players can't read it from inside the game.
	Anyone who can read this source code can, though, so treat these as public
	promo codes, not secrets.
]]

return {
	LAUNCH = 500,
	SMASH = 1500,
	KABOOM = 3000,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--[[
	Loads, caches and saves player data with DataStoreService.

	In an unpublished place (or with Studio API access turned off) DataStores are
	unavailable; the game still works, progress just isn't saved between sessions.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}

local profiles = {} -- [Player] = data table
local canSave = {} -- [Player] = boolean
local changedCallbacks = {}

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[SlingSmash] DataStores unavailable, progress will not save:", result)
	end
end

local function defaultData()
	local settings = {}
	for key, value in Config.DefaultSettings do
		settings[key] = value
	end
	return {
		Coins = 0,
		BestDistance = 0,
		Rebirths = 0,
		Upgrades = {},
		Trails = { None = true },
		EquippedTrail = "None",
		Settings = settings,
		Index = {}, -- [entryId] = true, kept through rebirths
		Daily = { Day = 0, Streak = 0 },
		Codes = {}, -- [code] = true
		Stats = {
			Launches = 0,
			TotalSmashes = 0,
			TotalCoins = 0,
			TotalDistance = 0,
			BestCombo = 0,
			StarsCollected = 0,
		},
	}
end

-- Fills in any keys missing from saved data (e.g. after adding new features).
local function reconcile(target, template)
	for key, value in template do
		if target[key] == nil then
			if type(value) == "table" then
				local copy = {}
				reconcile(copy, value)
				target[key] = copy
			else
				target[key] = value
			end
		elseif type(value) == "table" and type(target[key]) == "table" then
			reconcile(target[key], value)
		end
	end
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

local function updateLeaderstats(player: Player, data)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		leaderstats = Instance.new("Folder")
		leaderstats.Name = "leaderstats"
		leaderstats.Parent = player
	end
	local coins = leaderstats:FindFirstChild("Coins") :: IntValue?
	if not coins then
		local value = Instance.new("IntValue")
		value.Name = "Coins"
		value.Parent = leaderstats
		coins = value
	end
	local best = leaderstats:FindFirstChild("Best") :: IntValue?
	if not best then
		local value = Instance.new("IntValue")
		value.Name = "Best"
		value.Parent = leaderstats
		best = value
	end
	if coins then
		coins.Value = math.floor(data.Coins)
	end
	if best then
		best.Value = math.floor(data.BestDistance)
	end
end

function DataService.Load(player: Player)
	local data = nil
	local loaded = false

	if store then
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return (store :: DataStore):GetAsync(keyFor(player))
			end)
			if ok then
				data = result
				loaded = true
				break
			end
			local message = tostring(result)
			if message:find("StudioAccessToApisNotAllowed") or message:find("publish") or message:find("403") then
				-- Unpublished place / API access disabled: stop trying for everyone.
				warn("[SlingSmash] DataStores are disabled here, progress will not save. " .. message)
				store = nil
				break
			end
			warn(string.format("[SlingSmash] Load attempt %d failed for %s: %s", attempt, player.Name, message))
			task.wait(1.5)
		end
	end

	if type(data) ~= "table" then
		data = defaultData()
	else
		reconcile(data, defaultData())
	end

	-- Only save if we actually read the store; never overwrite real data with defaults.
	canSave[player] = store ~= nil and loaded

	if player.Parent ~= Players then
		return nil
	end

	profiles[player] = data
	updateLeaderstats(player, data)
	DataService.Changed(player)
	return data
end

function DataService.Get(player: Player)
	return profiles[player]
end

function DataService.WaitFor(player: Player, timeout: number?)
	local deadline = os.clock() + (timeout or 20)
	while not profiles[player] and player.Parent == Players and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

function DataService.OnChanged(callback)
	table.insert(changedCallbacks, callback)
end

-- Call after mutating a player's data so the client and leaderstats update.
function DataService.Changed(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	updateLeaderstats(player, data)
	for _, callback in changedCallbacks do
		task.spawn(callback, player, data)
	end
end

function DataService.Save(player: Player)
	local data = profiles[player]
	if not data or not store or not canSave[player] then
		return
	end
	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(keyFor(player), function()
			return data
		end)
	end)
	if not ok then
		warn("[SlingSmash] Save failed for", player.Name, err)
	end
end

function DataService.Release(player: Player)
	DataService.Save(player)
	profiles[player] = nil
	canSave[player] = nil
end

-- Saves every loaded profile in parallel and yields until all are done.
function DataService.SaveAll()
	local pending = 0
	for player in profiles do
		pending += 1
		task.spawn(function()
			DataService.Save(player)
			pending -= 1
		end)
	end
	local deadline = os.clock() + 25
	while pending > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Leaderboard</string>
          <string name="Source"><![CDATA[--[[
	"Top Launches" board in the lobby.

	Published games keep a global top 10 in an OrderedDataStore. Where
	DataStores aren't available (an unpublished place, or Studio without API
	access) the board shows the best distances of the players in this server.
	Temporary DataStore errors (throttling, outages) only skip one refresh or
	flush; queued bests are kept and retried.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local WorldBuilder = require(script.Parent.WorldBuilder)

local Leaderboard = {}

local ROWS = 10
local GLOBAL_REFRESH = 60
local LOCAL_REFRESH = 5
local FLUSH_INTERVAL = 30

local store: OrderedDataStore? = nil
local warned = false
local flushing = false
local pending = {} -- [userId] = best distance waiting to be written
local nameCache = {} -- [userId] = username (successful lookups only)
local rows = {} -- { { Name: TextLabel, Value: TextLabel } }
local statusLabel: TextLabel? = nil
local getBest: (Player) -> number = function()
	return 0
end

do
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName)
	end)
	if ok then
		store = result
	end
end

-- Unpublished places and disabled API access never recover; everything else
-- (throttling, outages) is treated as temporary.
local function handleError(err: any)
	local message = tostring(err)
	local permanent = message:find("StudioAccessToApisNotAllowed") ~= nil
		or message:find("publish") ~= nil
		or message:find("403") ~= nil
	if permanent then
		store = nil
	end
	if not warned then
		warned = true
		warn("[SlingSmash] Global leaderboard request failed:", message)
	end
end

local function buildBoard(parent: Instance)
	local _, gui = WorldBuilder.Signboard(parent, "TopLaunchesBoard", Config.LeaderboardPosition, Vector2.new(20, 22), 6)

	WorldBuilder.SignLabel({
		Text = "🏆 TOP LAUNCHES",
		Size = UDim2.new(1, 0, 0, 64),
		TextColor3 = Color3.fromRGB(255, 214, 60),
		LayoutOrder = 0,
		Parent = gui,
	})

	for rank = 1, ROWS do
		local row = Instance.new("Frame")
		row.Name = "Row" .. rank
		row.Size = UDim2.new(1, 0, 0, 38)
		row.BackgroundColor3 = if rank % 2 == 0 then Color3.fromRGB(86, 58, 40) else Color3.fromRGB(100, 68, 46)
		row.BorderSizePixel = 0
		row.LayoutOrder = rank
		row.Parent = gui
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent = row

		WorldBuilder.SignLabel({
			Text = if rank == 1 then "🥇" elseif rank == 2 then "🥈" elseif rank == 3 then "🥉" else "#" .. rank,
			Position = UDim2.fromOffset(6, 3),
			Size = UDim2.new(0, 50, 1, -6),
			Parent = row,
		})
		local name = WorldBuilder.SignLabel({
			Text = "---",
			Position = UDim2.fromOffset(62, 3),
			Size = UDim2.new(0.62, -62, 1, -6),
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		local value = WorldBuilder.SignLabel({
			Text = "",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 3),
			Size = UDim2.new(0.38, -10, 1, -6),
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = Color3.fromRGB(140, 255, 100),
			Parent = row,
		})
		rows[rank] = { Name = name, Value = value }
	end

	statusLabel = WorldBuilder.SignLabel({
		Text = "",
		Size = UDim2.new(1, 0, 0, 26),
		TextColor3 = Color3.fromRGB(255, 226, 190),
		LayoutOrder = ROWS + 1,
		Parent = gui,
	})
end

-- Usernames everywhere, so a player reads the same online and offline.
local function nameFor(userId: number): string
	local player = Players:GetPlayerByUserId(userId)
	if player then
		return player.Name
	end
	local cached = nameCache[userId]
	if cached then
		return cached
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and type(name) == "string" then
		nameCache[userId] = name
		return name
	end
	return "Player" -- not cached: try again on the next refresh
end

local function render(entries, isGlobal: boolean)
	for rank = 1, ROWS do
		local row = rows[rank]
		local entry = entries[rank]
		if row then
			row.Name.Text = if entry then entry.Name else "---"
			row.Value.Text = if entry then Format.Commas(entry.Value) else ""
		end
	end
	local status = statusLabel
	if status then
		status.Text = if isGlobal
			then "🌍 All servers • best distance in studs"
			else "🏠 This server • publish the game for a global board"
	end
end

local function localEntries()
	local entries = {}
	for _, player in Players:GetPlayers() do
		local best = getBest(player)
		if best > 0 then
			table.insert(entries, { Name = player.Name, Value = best })
		end
	end
	table.sort(entries, function(a, b)
		return a.Value > b.Value
	end)
	return entries
end

local function globalEntries()
	local activeStore = store
	if not activeStore then
		return nil
	end
	local ok, pages = pcall(function()
		return activeStore:GetSortedAsync(false, ROWS)
	end)
	if not ok then
		handleError(pages)
		return nil
	end
	local entries = {}
	for _, item in pages:GetCurrentPage() do
		local userId = tonumber(item.key)
		if userId and type(item.value) == "number" then
			table.insert(entries, { Name = nameFor(userId), Value = item.value })
		end
	end
	return entries
end

function Leaderboard.Refresh()
	local entries = globalEntries()
	if entries then
		render(entries, true)
	else
		render(localEntries(), false)
	end
end

-- Remembers a player's new best; written to the global store in batches.
function Leaderboard.Submit(player: Player, best: number)
	if best <= 0 then
		return
	end
	local userId = player.UserId
	pending[userId] = math.max(pending[userId] or 0, math.floor(best))
	if not store then
		render(localEntries(), false)
	end
end

-- Writes queued bests and yields until done. Only ever raises a stored value.
function Leaderboard.Flush()
	-- One flush at a time; a second caller waits for the running one.
	while flushing do
		task.wait(0.1)
	end
	local activeStore = store
	if not activeStore then
		return
	end
	flushing = true

	-- Work from a snapshot: Submit can run while UpdateAsync yields.
	local batch = {}
	for userId, best in pending do
		table.insert(batch, { UserId = userId, Best = best })
	end
	for _, item in batch do
		local ok, err = pcall(function()
			activeStore:UpdateAsync(tostring(item.UserId), function(old)
				if type(old) == "number" and old >= item.Best then
					return nil
				end
				return item.Best
			end)
		end)
		if ok then
			-- Keep anything newer that arrived during the write.
			if pending[item.UserId] == item.Best then
				pending[item.UserId] = nil
			end
		else
			handleError(err)
			break -- try the rest on the next flush
		end
	end
	flushing = false
end

function Leaderboard.Init(parent: Instance, bestForPlayer: (Player) -> number)
	getBest = bestForPlayer
	buildBoard(parent)
	render({}, store ~= nil)

	Players.PlayerRemoving:Connect(function()
		task.spawn(Leaderboard.Flush)
	end)

	task.spawn(function()
		while true do
			Leaderboard.Refresh()
			task.wait(if store then GLOBAL_REFRESH else LOCAL_REFRESH)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(FLUSH_INTERVAL)
			Leaderboard.Flush()
		end
	end)
end

return Leaderboard
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[--[[
	Builds the static world on the server: the Sky Kingdom lobby, the slingshot,
	and five biomes along the launch lane (terrain, scenery, gates, lighting).

	Landscape is Roblox Terrain (cheap to render, looks rich); props are Parts.
	The lane floor is always flat at Config.GroundY because flight physics
	assumes it. Hills, water and mountains stay well outside the lane.

	The smashable obstacles are NOT built here; each client builds its own copy
	(see Client/Course) so smashing is instant and resets for every launch.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local CourseLayout = require(ReplicatedStorage.Shared.CourseLayout)

local WorldBuilder = {}

local LANE_GROUND_HALF = 68 -- lane material reaches out to x = +-68
local OUTER_HALF = 480 -- side terrain reaches out to x = +-480
local TERRAIN_DEPTH = 16
local LOBBY_BACK = 220 -- terrain behind the slingshot (towards +Z)
local LANE_END = Config.LaneLength + 260

local rng = Random.new(42)

-- Waterfalls pour from floating islands into the Sky Kingdom river.
local WATERFALLS = {
	{ Top = Vector3.new(-150, 76, -20), Height = 77 },
	{ Top = Vector3.new(-148, 84, -200), Height = 85 },
	{ Top = Vector3.new(-152, 90, -380), Height = 91 },
}

--------------------------------------------------------------------------------
-- Part helpers
--------------------------------------------------------------------------------

local function part(props): BasePart
	local className = props.ClassName or "Part"
	local p = Instance.new(className) :: BasePart
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		if key ~= "ClassName" and key ~= "Parent" then
			(p :: any)[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

-- Decorations never need collisions, queries or touch events.
local function prop(props): BasePart
	props.CanCollide = false
	props.CanQuery = false
	props.CanTouch = false
	return part(props)
end

-- Upright cylinder (Roblox cylinders lie along X, so rotate them).
local function pillar(parent: Instance, base: Vector3, height: number, radius: number, color: Color3, material: Enum.Material?, name: string?): BasePart
	return prop({
		Name = name or "Pillar",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, radius * 2, radius * 2),
		CFrame = CFrame.new(base + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		Parent = parent,
	})
end

-- Cylinder between two points.
local function beamPart(parent: Instance, a: Vector3, b: Vector3, radius: number, color: Color3, material: Enum.Material?, name: string?): BasePart
	local length = (b - a).Magnitude
	local dir = (b - a).Unit
	local up = if math.abs(dir.Y) > 0.95 then Vector3.xAxis else Vector3.yAxis
	local side = up:Cross(dir).Unit
	return prop({
		Name = name or "Beam",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(length, radius * 2, radius * 2),
		CFrame = CFrame.fromMatrix((a + b) / 2, dir, dir:Cross(side)),
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		Parent = parent,
	})
end

local function ball(parent: Instance, center: Vector3, size: Vector3, color: Color3, material: Enum.Material?, name: string?): BasePart
	return prop({
		Name = name or "Ball",
		Shape = Enum.PartType.Ball,
		Size = size,
		CFrame = CFrame.new(center),
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		CastShadow = false,
		Parent = parent,
	})
end

-- A flat ring of neon segments (rings, holograms, gate frames).
local function ring(parent: Instance, cframe: CFrame, radius: number, thickness: number, color: Color3, segments: number?)
	local count = segments or 16
	local chord = 2 * radius * math.sin(math.pi / count) + thickness * 0.5
	for i = 1, count do
		local angle = (i / count) * math.pi * 2
		prop({
			Name = "RingSegment",
			Size = Vector3.new(thickness, chord, thickness),
			CFrame = cframe * CFrame.new(math.cos(angle) * radius, math.sin(angle) * radius, 0) * CFrame.Angles(0, 0, angle),
			Color = color,
			Material = Enum.Material.Neon,
			CastShadow = false,
			Parent = parent,
		})
	end
end

local function emitter(parent: Instance, props): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	for key, value in props do
		(e :: any)[key] = value
	end
	e.Parent = parent
	return e
end

local function sign(parent: Instance, size: Vector3, cframe: CFrame, text: string, color: Color3, textColor: Color3?, material: Enum.Material?)
	local board = prop({
		Name = "Sign",
		Size = size,
		CFrame = cframe,
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		Parent = parent,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back -- the +Z face, which faces the lobby
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 0
	gui.Parent = board

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = textColor or Color3.new(1, 1, 1)
	label.Parent = gui

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 4
	stroke.Color = Color3.fromRGB(20, 14, 10)
	stroke.Parent = label

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0.08, 0)
	padding.PaddingBottom = UDim.new(0.08, 0)
	padding.PaddingLeft = UDim.new(0.03, 0)
	padding.PaddingRight = UDim.new(0.03, 0)
	padding.Parent = label
	return board
end

local function zoneRange(index: number): (number, number)
	local from = if index == 1 then -LOBBY_BACK else Config.Zones[index - 1].EndsAt
	local to = if index == #Config.Zones then LANE_END else Config.Zones[index].EndsAt
	return from, math.min(to, LANE_END)
end

-- Random x outside the lane, on either side.
local function sideX(minX: number, maxX: number): number
	local side = if rng:NextNumber() < 0.5 then -1 else 1
	return side * rng:NextNumber(minX, maxX)
end

--------------------------------------------------------------------------------
-- Terrain
--------------------------------------------------------------------------------

local terrain: Terrain = Workspace.Terrain

local function fillBlock(cframe: CFrame, size: Vector3, material: Enum.Material)
	terrain:FillBlock(cframe, size, material)
end

-- Fills a slab from x1..x2, distance d1..d2, with its top at `top`, in chunks.
local function slab(x1: number, x2: number, d1: number, d2: number, top: number, depth: number, material: Enum.Material)
	local chunk = 512
	local d = d1
	while d < d2 do
		local length = math.min(chunk, d2 - d)
		fillBlock(
			CFrame.new((x1 + x2) / 2, top - depth / 2, -(d + length / 2)),
			Vector3.new(x2 - x1, depth, length),
			material
		)
		d += length
	end
end

local HILL_MATERIAL = {
	Sky = Enum.Material.Grass,
	Jungle = Enum.Material.LeafyGrass,
	Volcanic = Enum.Material.Basalt,
	Frozen = Enum.Material.Snow,
}
local MOUNTAIN_MATERIAL = {
	Sky = Enum.Material.Rock,
	Jungle = Enum.Material.Rock,
	Volcanic = Enum.Material.Basalt,
	Frozen = Enum.Material.Glacier,
}

-- Flat lane and side ground for every biome. If even this fails, the world
-- falls back to plain parts so nobody falls through the floor.
local function buildBaseTerrain()
	terrain:Clear()
	terrain.WaterColor = Color3.fromRGB(40, 150, 200)
	terrain.WaterTransparency = 0.6
	terrain.WaterWaveSize = 0.12
	terrain.WaterWaveSpeed = 8
	terrain.WaterReflectance = 0.5
	terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(128, 122, 116))
	for _, zone in Config.Zones do
		for materialName, color in zone.TerrainColors do
			terrain:SetMaterialColor((Enum.Material :: any)[materialName], color)
		end
	end

	for index, zone in Config.Zones do
		local from, to = zoneRange(index)
		-- Lane and shoulders, then the wider sides.
		slab(-LANE_GROUND_HALF, LANE_GROUND_HALF, from, to, Config.GroundY, TERRAIN_DEPTH, zone.LaneMaterial)
		slab(-OUTER_HALF, -LANE_GROUND_HALF, from, to, Config.GroundY, TERRAIN_DEPTH, zone.SideMaterial)
		slab(LANE_GROUND_HALF, OUTER_HALF, from, to, Config.GroundY, TERRAIN_DEPTH, zone.SideMaterial)
	end
end

-- Plain-part ground, only used if terrain can't be built.
local function buildFallbackGround(map: Folder)
	local ground = Instance.new("Folder")
	ground.Name = "FallbackGround"
	ground.Parent = map
	for index, zone in Config.Zones do
		local from, to = zoneRange(index)
		local d = from
		while d < to do
			local length = math.min(1000, to - d)
			part({
				Name = "Ground",
				Size = Vector3.new(LANE_GROUND_HALF * 4, 2, length),
				CFrame = CFrame.new(0, Config.GroundY - 1, -(d + length / 2)),
				Color = zone.BannerColor:Lerp(Color3.new(0.3, 0.3, 0.3), 0.5),
				Material = Enum.Material.SmoothPlastic,
				CastShadow = false,
				Parent = ground,
			})
			d += length
		end
	end
end

-- Hills, mountains, water, volcanoes and islands. Each piece is optional.
local function buildTerrainFeatures()
	for index, zone in Config.Zones do
		local from, to = zoneRange(index)
		local key = zone.Key

		-- Rolling hills beside the lane and mountains on the horizon.
		local hillMaterial = HILL_MATERIAL[key]
		local mountainMaterial = MOUNTAIN_MATERIAL[key]
		local length = to - from
		if hillMaterial then
			for _ = 1, math.floor(length / 70) do
				local radius = rng:NextNumber(18, 42)
				local x = sideX(LANE_GROUND_HALF + radius * 0.6 + 20, 230)
				-- Keep the Sky Kingdom river (x = -170..-130) and its banks clear.
				local overRiver = key == "Sky" and x - radius < -120 and x + radius > -180
				if not overRiver then
					terrain:FillBall(Vector3.new(x, Config.GroundY - radius * 0.45, -rng:NextNumber(from, to)), radius, hillMaterial)
				end
			end
		end
		if mountainMaterial then
			for _ = 1, math.max(2, math.floor(length / 160)) do
				local radius = rng:NextNumber(60, 110)
				local x = sideX(300, 440)
				local center = Vector3.new(x, Config.GroundY - radius * 0.25, -rng:NextNumber(from, to))
				terrain:FillBall(center, radius, mountainMaterial)
				-- Snowy or grassy caps.
				local cap = if key == "Frozen" or key == "Sky" then Enum.Material.Snow else hillMaterial
				if cap then
					terrain:FillBall(center + Vector3.new(0, radius * 0.55, 0), radius * 0.5, cap)
				end
			end
		end
	end

	-- Sky Kingdom river beside the lane, flowing past the lobby.
	local riverFrom, riverTo = -LOBBY_BACK + 20, Config.Zones[1].EndsAt - 20
	slab(-170, -130, riverFrom, riverTo, Config.GroundY, 10, Enum.Material.Air)
	slab(-170, -130, riverFrom, riverTo, Config.GroundY - 6, 4, Enum.Material.Sand)
	slab(-170, -130, riverFrom, riverTo, Config.GroundY - 1.5, 4.5, Enum.Material.Water)

	-- Jungle swamp pools.
	local jFrom, jTo = zoneRange(2)
	for _ = 1, 4 do
		local x = sideX(100, 200)
		local d = rng:NextNumber(jFrom + 40, jTo - 40)
		local radius = rng:NextNumber(16, 26)
		terrain:FillCylinder(CFrame.new(x, Config.GroundY - 2, -d), 6, radius, Enum.Material.Air)
		terrain:FillCylinder(CFrame.new(x, Config.GroundY - 3, -d), 4, radius, Enum.Material.Water)
	end

	-- Volcanoes: stacked cylinders make a cone; the crater is hollow.
	local vFrom, vTo = zoneRange(3)
	for i, info in { { -420, 0.35 }, { 460, 0.75 } } do
		local x, d = info[1], vFrom + (vTo - vFrom) * info[2]
		local size = if i == 1 then 1 else 0.7
		for level = 0, 8 do
			local radius = (150 - level * 16) * size
			terrain:FillCylinder(CFrame.new(x, Config.GroundY + level * 14 * size + 7, -d), 14 * size + 2, radius, Enum.Material.Basalt)
		end
		terrain:FillCylinder(CFrame.new(x, Config.GroundY + 9 * 14 * size, -d), 20 * size, 18 * size, Enum.Material.CrackedLava)
	end

	-- Frozen lake.
	local fFrom, fTo = zoneRange(4)
	terrain:FillCylinder(CFrame.new(-150, Config.GroundY - 1, -(fFrom + fTo) / 2), 2.5, 55, Enum.Material.Ice)

	-- Islands the waterfalls pour from, then more floating islands around the Sky Kingdom.
	for _, fall in WATERFALLS do
		local top = fall.Top + Vector3.new(0, 2, -8)
		terrain:FillBall(top - Vector3.new(0, 12, 0), 18, Enum.Material.Rock)
		terrain:FillCylinder(CFrame.new(top), 5, 17, Enum.Material.Grass)
	end
	for _ = 1, 9 do
		local radius = rng:NextNumber(14, 26)
		local top = Vector3.new(sideX(70, 260), rng:NextNumber(55, 110), -rng:NextNumber(-180, Config.Zones[1].EndsAt + 100))
		terrain:FillBall(top - Vector3.new(0, radius * 0.55, 0), radius, Enum.Material.Rock)
		terrain:FillCylinder(CFrame.new(top), 5, radius * 0.95, Enum.Material.Grass)
	end
end

--------------------------------------------------------------------------------
-- Lane rails, markers, gates, finish
--------------------------------------------------------------------------------

local RAIL_COLORS = {
	Sky = { Color3.fromRGB(255, 206, 46), Color3.fromRGB(245, 245, 245) },
	Jungle = { Color3.fromRGB(110, 170, 70), Color3.fromRGB(190, 170, 120) },
	Volcanic = { Color3.fromRGB(255, 110, 30), Color3.fromRGB(50, 44, 46) },
	Frozen = { Color3.fromRGB(120, 210, 255), Color3.fromRGB(245, 250, 255) },
	Neon = { Color3.fromRGB(0, 230, 255), Color3.fromRGB(255, 60, 200) },
}

local GATE_STYLE = {
	Sky = { Pillar = Color3.fromRGB(236, 228, 210), Material = Enum.Material.Limestone, Sign = Color3.fromRGB(120, 70, 220), Text = Color3.fromRGB(255, 230, 90), Accent = Color3.fromRGB(255, 206, 46) },
	Jungle = { Pillar = Color3.fromRGB(110, 120, 96), Material = Enum.Material.Cobblestone, Sign = Color3.fromRGB(40, 90, 40), Text = Color3.fromRGB(200, 255, 140), Accent = Color3.fromRGB(80, 160, 60) },
	Volcanic = { Pillar = Color3.fromRGB(46, 40, 42), Material = Enum.Material.Basalt, Sign = Color3.fromRGB(70, 20, 14), Text = Color3.fromRGB(255, 170, 60), Accent = Color3.fromRGB(255, 100, 20) },
	Frozen = { Pillar = Color3.fromRGB(180, 225, 255), Material = Enum.Material.Glass, Sign = Color3.fromRGB(40, 90, 150), Text = Color3.fromRGB(220, 245, 255), Accent = Color3.fromRGB(240, 250, 255) },
	Neon = { Pillar = Color3.fromRGB(24, 24, 36), Material = Enum.Material.SmoothPlastic, Sign = Color3.fromRGB(16, 14, 30), Text = Color3.fromRGB(120, 240, 255), Accent = Color3.fromRGB(0, 230, 255) },
}

local function buildLane(map: Folder)
	local lane = Instance.new("Folder")
	lane.Name = "Lane"
	lane.Parent = map

	-- Rails in 32-stud segments, coloured per biome.
	local railX = Config.LaneWidth / 2 + 0.6
	local segment = 32
	local index = 0
	for d = 8, Config.LaneLength, segment do
		local zone = Config.Zones[CourseLayout.ZoneIndexAt(d + segment / 2)]
		local colors = RAIL_COLORS[zone.Key]
		for _, side in { -1, 1 } do
			prop({
				Name = "Rail",
				Size = Vector3.new(0.9, 0.9, segment),
				CFrame = CFrame.new(side * railX, Config.GroundY + 0.45, -(d + segment / 2)),
				Color = colors[(index % 2) + 1],
				Material = if zone.Key == "Neon" then Enum.Material.Neon else Enum.Material.SmoothPlastic,
				CastShadow = false,
				Parent = lane,
			})
		end
		index += 1
	end

	-- Distance markers every 250 studs.
	for d = 250, Config.LaneLength - 50, 250 do
		for _, side in { -1, 1 } do
			local x = side * (railX + 5)
			prop({
				Name = "MarkerPost",
				Size = Vector3.new(0.8, 6, 0.8),
				CFrame = CFrame.new(x, Config.GroundY + 3, -d),
				Color = Color3.fromRGB(90, 60, 40),
				Parent = lane,
			})
			sign(lane, Vector3.new(8, 4, 0.6), CFrame.new(x, Config.GroundY + 7.5, -d), tostring(d), Color3.fromRGB(255, 196, 40))
		end
	end

	-- Themed gate at the start of each biome.
	local gateStart = 0
	for zoneIndex, zone in Config.Zones do
		local d = if zoneIndex == 1 then 14 else gateStart
		local style = GATE_STYLE[zone.Key]
		local pillarX = Config.LaneWidth / 2 + 4
		local gate = Instance.new("Model")
		gate.Name = "Gate_" .. zone.Key
		gate.Parent = lane
		for _, side in { -1, 1 } do
			local base = Vector3.new(side * pillarX, Config.GroundY, -d)
			local column = pillar(gate, base, 30, 2.2, style.Pillar, style.Material, "GatePillar")
			if zone.Key == "Frozen" then
				column.Transparency = 0.25
			end
			prop({
				Name = "GateCap",
				Size = Vector3.new(6, 2, 6),
				CFrame = CFrame.new(base + Vector3.new(0, 30.5, 0)),
				Color = style.Accent,
				Material = if zone.Key == "Neon" or zone.Key == "Volcanic" then Enum.Material.Neon else Enum.Material.SmoothPlastic,
				Parent = gate,
			})
			if zone.Key == "Neon" or zone.Key == "Volcanic" then
				-- Glowing strips up the pillars.
				prop({
					Name = "GateGlow",
					Size = Vector3.new(0.5, 26, 0.5),
					CFrame = CFrame.new(base + Vector3.new(-side * 2.3, 14, 0)),
					Color = style.Accent,
					Material = Enum.Material.Neon,
					CastShadow = false,
					Parent = gate,
				})
			elseif zone.Key == "Jungle" then
				for v = 1, 3 do
					beamPart(gate, base + Vector3.new(side * (v - 2) * 0.8, 29, 2.3), base + Vector3.new(side * (v - 2), 29 - rng:NextNumber(8, 16), 2.4), 0.25, Color3.fromRGB(70, 140, 50), Enum.Material.LeafyGrass, "Vine")
				end
			end
		end
		local title = if zoneIndex == 1 then Config.GameName else string.upper(zone.Name)
		sign(gate, Vector3.new(pillarX * 2 + 4, 7, 2), CFrame.new(0, Config.GroundY + 33, -d), title, style.Sign, style.Text)
		gateStart = zone.EndsAt
	end

	-- Finish: a glowing wall between two flaming pillars.
	local finishD = Config.LaneLength + 6
	prop({
		Name = "FinishWall",
		Size = Vector3.new(Config.LaneWidth + 12, 40, 4),
		CFrame = CFrame.new(0, Config.GroundY + 20, -finishD),
		Color = Color3.fromRGB(255, 200, 40),
		Material = Enum.Material.Neon,
		Parent = lane,
	})
	sign(lane, Vector3.new(60, 12, 1), CFrame.new(0, Config.GroundY + 20, -(finishD - 2.6)), "🏆 FINISH 🏆", Color3.fromRGB(120, 70, 220))
	for _, side in { -1, 1 } do
		local base = Vector3.new(side * (Config.LaneWidth / 2 + 10), Config.GroundY, -(finishD - 4))
		pillar(lane, base, 44, 3, Color3.fromRGB(60, 40, 90), Enum.Material.SmoothPlastic, "FinishPillar")
		local top = prop({
			Name = "FinishFlame",
			Size = Vector3.new(4, 2, 4),
			CFrame = CFrame.new(base + Vector3.new(0, 45, 0)),
			Color = Color3.fromRGB(255, 160, 40),
			Material = Enum.Material.Neon,
			Parent = lane,
		})
		emitter(top, {
			Rate = 24,
			Lifetime = NumberRange.new(0.6, 1.1),
			Speed = NumberRange.new(10, 18),
			SpreadAngle = Vector2.new(12, 12),
			EmissionDirection = Enum.NormalId.Top,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 0.5) }),
			Transparency = NumberSequence.new(0.1, 1),
			Color = ColorSequence.new(Color3.fromRGB(255, 220, 90), Color3.fromRGB(255, 70, 20)),
			LightEmission = 1,
		})
	end
end

--------------------------------------------------------------------------------
-- Slingshot + lobby
--------------------------------------------------------------------------------

local function buildSlingshot(map: Folder)
	local model = Instance.new("Model")
	model.Name = "Slingshot"
	model.Parent = map

	local base = Config.SlingshotPosition
	local wood = Color3.fromRGB(140, 90, 52)
	local stone = Color3.fromRGB(128, 128, 136)
	local gold = Color3.fromRGB(255, 190, 60)

	-- Round launch platform with a gold rim and arrows pointing down the lane.
	part({
		Name = "Pad",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.8, 28, 28),
		CFrame = CFrame.new(base + Vector3.new(0, 0.4, 9)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(70, 80, 120),
		Material = Enum.Material.Slate,
		Parent = model,
	})
	prop({
		Name = "PadRim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 30, 30),
		CFrame = CFrame.new(base + Vector3.new(0, 0.3, 9)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = gold,
		Material = Enum.Material.Metal,
		Parent = model,
	})
	for i = 1, 3 do
		for _, side in { -1, 1 } do
			prop({
				Name = "PadArrow",
				Size = Vector3.new(0.5, 0.2, 4),
				CFrame = CFrame.new(base + Vector3.new(side * 1.3, 0.85, 18 - i * 4.5)) * CFrame.Angles(0, side * math.rad(35), 0),
				Color = Color3.fromRGB(80, 230, 255),
				Material = Enum.Material.Neon,
				CastShadow = false,
				Parent = model,
			})
		end
	end

	-- Stone base with rocks.
	part({
		Name = "Base",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.6, 6.4, 6.4),
		CFrame = CFrame.new(base + Vector3.new(0, 1.2, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = stone,
		Material = Enum.Material.Slate,
		Parent = model,
	})
	for _, angle in { 30, 150, 250, 320 } do
		local a = math.rad(angle)
		ball(model, base + Vector3.new(math.cos(a) * 3.4, 0.8, math.sin(a) * 3.4), Vector3.new(1.8, 1.3, 1.6), Color3.fromRGB(100, 102, 108), Enum.Material.Rock, "Rock")
	end

	-- Trunk, with an "E to launch" prompt for players who walk up to it.
	local trunk = part({
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(5.4, 2.3, 2.3),
		CFrame = CFrame.new(base + Vector3.new(0, 4.6, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = wood,
		Material = Enum.Material.Wood,
		Parent = model,
	})
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "SlingLaunchPrompt"
	prompt.ActionText = "Launch"
	prompt.ObjectText = "Slingshot"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 18
	prompt.RequiresLineOfSight = false
	prompt.Parent = trunk

	-- Leather grip and rope binding.
	for i = 0, 4 do
		pillar(model, base + Vector3.new(0, 2.5 + i * 0.5, 0), 0.32, 1.25, Color3.fromRGB(120, 34, 28), Enum.Material.Leather, "Grip")
	end
	for i = 0, 2 do
		pillar(model, base + Vector3.new(0, 6.25 + i * 0.25, 0), 0.2, 1.2, Color3.fromRGB(214, 186, 130), Enum.Material.Fabric, "Binding")
	end

	-- Two arms angled 25 degrees outwards, with knobs and gold band rings.
	local angle = math.rad(25)
	local armLength = 7
	local root = base + Vector3.new(0, 6.5, 0)
	for _, side in { -1, 1 } do
		local dir = Vector3.new(side * math.sin(angle), math.cos(angle), 0)
		beamPart(model, root - dir * 0.6, root + dir * armLength, 0.9, wood, Enum.Material.Wood, "Arm")
		ball(model, root + dir * (armLength + 0.3), Vector3.new(2.2, 2, 2.2), Color3.fromRGB(150, 98, 58), Enum.Material.Wood, "Knob")
		beamPart(model, root + dir * (armLength - 1), root + dir * (armLength - 0.6), 1.05, gold, Enum.Material.Metal, "BandRing")
	end

	-- Energy core between the arms; the client makes it pulse while charging.
	local core = prop({
		Name = "Core",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.6, 1.6, 1.6),
		CFrame = CFrame.new(root + Vector3.new(0, 0.9, 0)),
		Color = Color3.fromRGB(90, 230, 255),
		Material = Enum.Material.Neon,
		CastShadow = false,
		Parent = model,
	})
	local light = Instance.new("PointLight")
	light.Name = "CoreLight"
	light.Color = Color3.fromRGB(90, 230, 255)
	light.Range = 10
	light.Brightness = 1.2
	light.Parent = core

	-- Resting band between the arm tips (the client hides it while aiming).
	local spread = Config.SlingshotArmSpread
	local tipY = Config.SlingshotArmTip
	prop({
		Name = "RestBand",
		Size = Vector3.new(spread * 2, 0.5, 0.5),
		CFrame = CFrame.new(base + Vector3.new(0, tipY - 0.6, 0)),
		Color = Color3.fromRGB(255, 120, 60),
		Parent = model,
	})
	prop({
		Name = "Pouch",
		Size = Vector3.new(2.4, 1, 1),
		CFrame = CFrame.new(base + Vector3.new(0, tipY - 0.6, 0.3)),
		Color = Color3.fromRGB(110, 70, 40),
		Material = Enum.Material.Leather,
		Parent = model,
	})

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(Config.LobbySpawn)
	spawn.Color = Color3.fromRGB(255, 206, 46)
	spawn.Material = Enum.Material.Plastic
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = map

	-- Stone plaza under the lobby so it reads as a place, not just grass.
	part({
		Name = "Plaza",
		Size = Vector3.new(96, 1, 120),
		CFrame = CFrame.new(0, Config.GroundY - 0.45, 70),
		Color = Color3.fromRGB(214, 206, 190),
		Material = Enum.Material.Limestone,
		CastShadow = false,
		Parent = map,
	})
end

--------------------------------------------------------------------------------
-- How to play sign
--------------------------------------------------------------------------------

local HOW_TO_PLAY = {
	"1. Press 🎯 LAUNCH (or E at the slingshot)",
	"2. W / S aim up and down, A / D left and right",
	"3. HOLD to charge, RELEASE to fly",
	"4. Steer with A / D • CLICK or SPACE for ⚡ NITRO",
	"5. Fly through glowing orbs for POWER-UPS",
	"6. Smash blocks for ⭐ and buy ⬆️ UPGRADES!",
}

-- A signboard on two golden posts, turned to face the lobby spawn. Returns the
-- board part and a SurfaceGui with padding and a vertical list layout.
function WorldBuilder.Signboard(parent: Instance, name: string, position: Vector3, size: Vector2, spacing: number?)
	local spawn = Config.LobbySpawn
	local lift = 3 -- gap between the ground and the bottom of the board
	local center = position + Vector3.new(0, lift + size.Y / 2, 0)

	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent

	local board = part({
		Name = "Board",
		Size = Vector3.new(size.X, size.Y, 1),
		CFrame = CFrame.lookAt(center, Vector3.new(spawn.X, center.Y, spawn.Z)),
		Color = Color3.fromRGB(70, 46, 32),
		Parent = model,
	})
	local postHeight = lift + size.Y
	for _, side in { -1, 1 } do
		part({
			Name = "Post",
			Size = Vector3.new(1.4, postHeight, 1.4),
			CFrame = board.CFrame * CFrame.new(side * (size.X / 2 + 0.7), postHeight / 2 - (lift + size.Y / 2), 0),
			Color = Color3.fromRGB(255, 196, 40),
			Parent = model,
		})
	end

	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front -- lookAt points the front face at the spawn
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	gui.Parent = board

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 16)
	padding.PaddingBottom = UDim.new(0, 16)
	padding.PaddingLeft = UDim.new(0, 22)
	padding.PaddingRight = UDim.new(0, 22)
	padding.Parent = gui

	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, spacing or 8)
	list.Parent = gui

	return board, gui
end

-- Outlined cartoon text for signboards.
function WorldBuilder.SignLabel(props: { [string]: any }): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	for key, value in props do
		if key ~= "Parent" then
			(label :: any)[key] = value
		end
	end
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(30, 18, 10)
	stroke.Parent = label
	label.Parent = props.Parent
	return label
end

local function buildHowToPlay(map: Folder)
	local _, gui = WorldBuilder.Signboard(map, "HowToPlay", Config.HowToPlayPosition, Vector2.new(22, 17))
	WorldBuilder.SignLabel({
		Text = "HOW TO PLAY",
		Size = UDim2.new(1, 0, 0, 62),
		TextColor3 = Color3.fromRGB(255, 214, 60),
		LayoutOrder = 0,
		Parent = gui,
	})
	for i, text in HOW_TO_PLAY do
		WorldBuilder.SignLabel({
			Text = text,
			Size = UDim2.new(1, 0, 0, 40),
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = i,
			Parent = gui,
		})
	end
end

--------------------------------------------------------------------------------
-- Scenery pieces
--------------------------------------------------------------------------------

local function giantTree(parent: Instance, base: Vector3, height: number, leafColor: Color3, vines: boolean)
	local tree = Instance.new("Model")
	tree.Name = "GiantTree"
	tree.Parent = parent
	local trunkRadius = height * 0.07
	local trunkColor = Color3.fromRGB(110, 76, 50)
	pillar(tree, base - Vector3.new(0, 1, 0), height + 1, trunkRadius, trunkColor, Enum.Material.Wood, "Trunk")
	-- Buttress roots.
	for i = 1, 3 do
		local a = math.rad(i * 120 + rng:NextNumber(-20, 20))
		local out = Vector3.new(math.cos(a), 0, math.sin(a))
		beamPart(tree, base + Vector3.new(0, height * 0.18, 0), base + out * trunkRadius * 3 - Vector3.new(0, 0.5, 0), trunkRadius * 0.45, trunkColor, Enum.Material.Wood, "Root")
	end
	-- Canopy.
	local top = base + Vector3.new(0, height, 0)
	for i = 1, 4 do
		local a = math.rad(i * 90 + rng:NextNumber(-25, 25))
		local r = height * rng:NextNumber(0.24, 0.34)
		local offset = Vector3.new(math.cos(a) * r * 0.7, rng:NextNumber(-2, 3), math.sin(a) * r * 0.7)
		local leaf = ball(tree, top + offset, Vector3.new(r * 2, r * 1.4, r * 2), leafColor, Enum.Material.LeafyGrass, "Leaves")
		leaf.CastShadow = true
		if vines and i % 2 == 0 then
			local hang = top + offset - Vector3.new(0, r * 0.6, 0)
			beamPart(tree, hang, hang - Vector3.new(0, rng:NextNumber(8, 16), 0), 0.22, Color3.fromRGB(60, 130, 50), Enum.Material.LeafyGrass, "Vine")
		end
	end
	local crown = ball(tree, top + Vector3.new(0, height * 0.18, 0), Vector3.new(height * 0.5, height * 0.36, height * 0.5), leafColor:Lerp(Color3.new(1, 1, 1), 0.12), Enum.Material.LeafyGrass, "Leaves")
	crown.CastShadow = true
end

local function ruins(parent: Instance, center: Vector3, color: Color3, material: Enum.Material)
	local model = Instance.new("Model")
	model.Name = "Ruins"
	model.Parent = parent
	for i = 1, rng:NextInteger(3, 6) do
		local offset = Vector3.new(rng:NextNumber(-12, 12), 0, rng:NextNumber(-12, 12))
		local height = rng:NextNumber(6, 18)
		local column = pillar(model, center + offset, height, 1.5, color, material, "Column")
		if rng:NextNumber() < 0.3 then
			-- Toppled column.
			column.CFrame = CFrame.new(center + offset + Vector3.new(0, 1.5, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0)
		end
		if i == 1 then
			prop({
				Name = "Lintel",
				Size = Vector3.new(10, 1.6, 3),
				CFrame = CFrame.new(center + offset + Vector3.new(3, height + 0.8, 0)) * CFrame.Angles(0, 0, math.rad(rng:NextNumber(-8, 8))),
				Color = color,
				Material = material,
				Parent = model,
			})
		end
	end
	for _ = 1, 3 do
		prop({
			Name = "Rubble",
			Size = Vector3.new(rng:NextNumber(2, 4), rng:NextNumber(1.5, 3), rng:NextNumber(2, 4)),
			CFrame = CFrame.new(center + Vector3.new(rng:NextNumber(-14, 14), 1, rng:NextNumber(-14, 14))) * CFrame.Angles(0, rng:NextNumber(0, 3), rng:NextNumber(-0.3, 0.3)),
			Color = color,
			Material = material,
			Parent = model,
		})
	end
end

local function cloud(parent: Instance, center: Vector3)
	for _ = 1, rng:NextInteger(3, 4) do
		local size = rng:NextNumber(14, 30)
		ball(parent, center + Vector3.new(rng:NextNumber(-16, 16), rng:NextNumber(-3, 3), rng:NextNumber(-10, 10)), Vector3.new(size * 1.4, size * 0.6, size), Color3.fromRGB(250, 251, 255), Enum.Material.SmoothPlastic, "Cloud")
	end
end

local function waterfall(parent: Instance, top: Vector3, height: number)
	local fall = prop({
		Name = "Waterfall",
		Size = Vector3.new(8, height, 1.5),
		CFrame = CFrame.new(top - Vector3.new(0, height / 2, 0)),
		Color = Color3.fromRGB(150, 210, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.35,
		CastShadow = false,
		Parent = parent,
	})
	emitter(fall, {
		Rate = 14,
		Lifetime = NumberRange.new(1, 1.6),
		Speed = NumberRange.new(20, 28),
		EmissionDirection = Enum.NormalId.Bottom,
		Size = NumberSequence.new(1.5, 3),
		Transparency = NumberSequence.new(0.4, 1),
		Color = ColorSequence.new(Color3.fromRGB(230, 245, 255)),
	})
	local mist = prop({
		Name = "Mist",
		Size = Vector3.new(10, 1, 10),
		CFrame = CFrame.new(top - Vector3.new(0, height, 0)),
		Transparency = 1,
		Parent = parent,
	})
	emitter(mist, {
		Rate = 10,
		Lifetime = NumberRange.new(1.5, 2.5),
		Speed = NumberRange.new(3, 6),
		SpreadAngle = Vector2.new(80, 80),
		EmissionDirection = Enum.NormalId.Top,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 10) }),
		Transparency = NumberSequence.new(0.6, 1),
		Color = ColorSequence.new(Color3.fromRGB(240, 250, 255)),
	})
end

local function pine(parent: Instance, base: Vector3, height: number)
	local tree = Instance.new("Model")
	tree.Name = "Pine"
	tree.Parent = parent
	pillar(tree, base, height * 0.3, height * 0.05, Color3.fromRGB(90, 62, 44), Enum.Material.Wood, "Trunk")
	for tier = 0, 2 do
		local radius = height * (0.32 - tier * 0.08)
		local y = height * (0.25 + tier * 0.22)
		pillar(tree, base + Vector3.new(0, y, 0), height * 0.18, radius, Color3.fromRGB(40, 100, 70), Enum.Material.LeafyGrass, "Needles")
		pillar(tree, base + Vector3.new(0, y + height * 0.18, 0), 0.6, radius * 0.85, Color3.fromRGB(245, 250, 255), Enum.Material.Snow, "Snow")
	end
end

local function iceCrystals(parent: Instance, base: Vector3)
	for _ = 1, rng:NextInteger(3, 5) do
		local height = rng:NextNumber(8, 22)
		local tilt = CFrame.Angles(rng:NextNumber(-0.35, 0.35), rng:NextNumber(0, math.pi), rng:NextNumber(-0.35, 0.35))
		local crystal = prop({
			Name = "IceCrystal",
			Size = Vector3.new(2.4, height, 2.4),
			CFrame = CFrame.new(base + Vector3.new(rng:NextNumber(-4, 4), height * 0.4, rng:NextNumber(-4, 4))) * tilt,
			Color = Color3.fromRGB(160, 220, 255),
			Material = Enum.Material.Glass,
			Transparency = 0.2,
			Reflectance = 0.2,
			Parent = parent,
		})
		crystal.CastShadow = false
	end
end

local function cityTower(parent: Instance, base: Vector3, width: number, height: number)
	local tower = Instance.new("Model")
	tower.Name = "Tower"
	tower.Parent = parent
	prop({
		Name = "Body",
		Size = Vector3.new(width, height, width),
		CFrame = CFrame.new(base + Vector3.new(0, height / 2, 0)),
		Color = Color3.fromRGB(22, 22, 34),
		Material = Enum.Material.Glass,
		Reflectance = 0.15,
		Parent = tower,
	})
	local accent = if rng:NextNumber() < 0.5 then Color3.fromRGB(0, 230, 255) else Color3.fromRGB(255, 60, 200)
	for _, corner in { Vector3.new(1, 0, 1), Vector3.new(-1, 0, 1) } do
		prop({
			Name = "Trim",
			Size = Vector3.new(0.5, height, 0.5),
			CFrame = CFrame.new(base + Vector3.new(corner.X * width / 2, height / 2, corner.Z * width / 2)),
			Color = accent,
			Material = Enum.Material.Neon,
			CastShadow = false,
			Parent = tower,
		})
	end
	local band = rng:NextNumber(0.4, 0.8)
	prop({
		Name = "Band",
		Size = Vector3.new(width + 0.3, 0.6, width + 0.3),
		CFrame = CFrame.new(base + Vector3.new(0, height * band, 0)),
		Color = accent,
		Material = Enum.Material.Neon,
		CastShadow = false,
		Parent = tower,
	})
end

--------------------------------------------------------------------------------
-- Biome scenery
--------------------------------------------------------------------------------

local function buildSkyKingdom(deco: Folder, from: number, to: number)
	-- Giant trees and ruins by the lane, clouds and waterfalls overhead.
	for d = math.max(from, -150), to, 70 do
		local x = sideX(LANE_GROUND_HALF + 8, 110)
		giantTree(deco, Vector3.new(x, Config.GroundY, -(d + rng:NextNumber(0, 40))), rng:NextNumber(24, 36), Color3.fromRGB(96, 186, 80), false)
	end
	for _ = 1, 4 do
		ruins(deco, Vector3.new(sideX(60, 100), Config.GroundY, -rng:NextNumber(from + 60, to)), Color3.fromRGB(226, 218, 200), Enum.Material.Limestone)
	end
	for _ = 1, 26 do
		cloud(deco, Vector3.new(rng:NextNumber(-420, 420), rng:NextNumber(70, 140), -rng:NextNumber(from, to + 300)))
	end
	for _, fall in WATERFALLS do
		waterfall(deco, fall.Top, fall.Height)
	end
	-- A wooden bridge over the river.
	local bridgeD = 120
	for i = 0, 9 do
		prop({
			Name = "BridgePlank",
			Size = Vector3.new(4.6, 0.6, 10),
			CFrame = CFrame.new(-172 + i * 4.8, Config.GroundY + 0.8 + math.sin(i / 9 * math.pi) * 2, -bridgeD),
			Color = Color3.fromRGB(150, 100, 60),
			Material = Enum.Material.WoodPlanks,
			Parent = deco,
		})
	end
end

local function buildJungle(deco: Folder, from: number, to: number)
	for d = from, to, 46 do
		local x = sideX(LANE_GROUND_HALF + 6, 140)
		giantTree(deco, Vector3.new(x, Config.GroundY, -(d + rng:NextNumber(0, 30))), rng:NextNumber(34, 52), Color3.fromRGB(56, 140, 56), true)
	end
	for _ = 1, 6 do
		ruins(deco, Vector3.new(sideX(56, 120), Config.GroundY, -rng:NextNumber(from + 30, to - 30)), Color3.fromRGB(116, 128, 100), Enum.Material.Cobblestone)
	end
	-- A stepped temple in the distance.
	local templeCenter = Vector3.new(-230, Config.GroundY, -(from + (to - from) * 0.55))
	for step = 0, 5 do
		local size = 70 - step * 11
		part({
			Name = "TempleStep",
			Size = Vector3.new(size, 7, size),
			CFrame = CFrame.new(templeCenter + Vector3.new(0, 3.5 + step * 7, 0)),
			Color = Color3.fromRGB(120 + step * 4, 130 + step * 3, 104),
			Material = Enum.Material.Cobblestone,
			Parent = deco,
		})
	end
	prop({
		Name = "TempleShrine",
		Size = Vector3.new(10, 9, 10),
		CFrame = CFrame.new(templeCenter + Vector3.new(0, 46.5, 0)),
		Color = Color3.fromRGB(90, 200, 120),
		Material = Enum.Material.Neon,
		Parent = deco,
	})
end

local function buildVolcanic(deco: Folder, from: number, to: number)
	-- Basalt spires lean over the lane edges.
	for d = from, to, 26 do
		local height = rng:NextNumber(10, 34)
		local x = sideX(LANE_GROUND_HALF - 10, 120)
		prop({
			Name = "Spire",
			ClassName = "WedgePart",
			Size = Vector3.new(rng:NextNumber(5, 9), height, rng:NextNumber(5, 9)),
			CFrame = CFrame.new(x, Config.GroundY + height / 2 - 1, -(d + rng:NextNumber(0, 20)))
				* CFrame.Angles(rng:NextNumber(-0.15, 0.15), rng:NextNumber(0, math.pi * 2), rng:NextNumber(-0.15, 0.15)),
			Color = Color3.fromRGB(46, 40, 44),
			Material = Enum.Material.Basalt,
			Parent = deco,
		})
	end
	-- Lava rivers glowing either side of the lane.
	for _, side in { -1, 1 } do
		local d = from
		while d < to do
			local length = math.min(120, to - d)
			prop({
				Name = "Lava",
				Size = Vector3.new(10, 0.4, length),
				CFrame = CFrame.new(side * 84, Config.GroundY + 0.05, -(d + length / 2)),
				Color = Color3.fromRGB(255, 110, 30),
				Material = Enum.Material.Neon,
				CastShadow = false,
				Parent = deco,
			})
			d += length
		end
	end
	-- Glowing cracks across the lane: the floor here is lava.
	for d = from + 10, math.min(to, Config.LaneLength), 22 do
		prop({
			Name = "LavaCrack",
			Size = Vector3.new(rng:NextNumber(10, 26), 0.12, rng:NextNumber(0.5, 1.1)),
			CFrame = CFrame.new(rng:NextNumber(-26, 26), Config.GroundY + 0.04, -(d + rng:NextNumber(0, 12)))
				* CFrame.Angles(0, rng:NextNumber(-0.7, 0.7), 0),
			Color = Color3.fromRGB(255, 120, 30),
			Material = Enum.Material.Neon,
			CastShadow = false,
			Parent = deco,
		})
	end
	-- Dead trees.
	for _ = 1, 10 do
		local base = Vector3.new(sideX(LANE_GROUND_HALF + 4, 130), Config.GroundY, -rng:NextNumber(from, to))
		local height = rng:NextNumber(10, 18)
		pillar(deco, base, height, 0.7, Color3.fromRGB(40, 32, 30), Enum.Material.Wood, "DeadTree")
		for b = 1, 2 do
			local a = rng:NextNumber(0, math.pi * 2)
			local start = base + Vector3.new(0, height * (0.5 + b * 0.18), 0)
			beamPart(deco, start, start + Vector3.new(math.cos(a) * 5, 3, math.sin(a) * 5), 0.35, Color3.fromRGB(40, 32, 30), Enum.Material.Wood, "Branch")
		end
	end
	-- Smoking craters on the volcano tops.
	for i, info in { { -420, 0.35 }, { 460, 0.75 } } do
		local size = if i == 1 then 1 else 0.7
		local top = Vector3.new(info[1], Config.GroundY + 9 * 14 * size + 4, -(from + (to - from) * info[2]))
		local crater = prop({
			Name = "Crater",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(2, 34 * size, 34 * size),
			CFrame = CFrame.new(top) * CFrame.Angles(0, 0, math.pi / 2),
			Color = Color3.fromRGB(255, 120, 30),
			Material = Enum.Material.Neon,
			Parent = deco,
		})
		emitter(crater, {
			Rate = 6,
			Lifetime = NumberRange.new(6, 9),
			Speed = NumberRange.new(10, 16),
			SpreadAngle = Vector2.new(15, 15),
			EmissionDirection = Enum.NormalId.Right, -- the cylinder's axis points up
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 14), NumberSequenceKeypoint.new(1, 40) }),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) }),
			Color = ColorSequence.new(Color3.fromRGB(70, 60, 60), Color3.fromRGB(150, 140, 140)),
			Acceleration = Vector3.new(4, 2, 0),
		})
	end
end

local function buildFrozen(deco: Folder, from: number, to: number)
	for d = from, to, 30 do
		pine(deco, Vector3.new(sideX(LANE_GROUND_HALF + 4, 150), Config.GroundY, -(d + rng:NextNumber(0, 24))), rng:NextNumber(14, 26))
	end
	for d = from + 20, to, 90 do
		iceCrystals(deco, Vector3.new(sideX(50, 90), Config.GroundY, -(d + rng:NextNumber(0, 40))))
	end
	-- Aurora: glowing ribbons across the sky.
	local anchor = prop({
		Name = "AuroraAnchor",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(0, 260, -(from + to) / 2),
		Transparency = 1,
		Parent = deco,
	})
	for i = 1, 4 do
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(-700, rng:NextNumber(-40, 40), (i - 2.5) * 120)
		a0.Parent = anchor
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(700, rng:NextNumber(-40, 40), (i - 2.5) * 120 + rng:NextNumber(-80, 80))
		a1.Parent = anchor
		local beam = Instance.new("Beam")
		beam.Name = "Aurora"
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Width0 = rng:NextNumber(60, 100)
		beam.Width1 = rng:NextNumber(60, 100)
		beam.CurveSize0 = rng:NextNumber(-260, 260)
		beam.CurveSize1 = rng:NextNumber(-260, 260)
		beam.Segments = 24
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(60, 255, 160)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(60, 200, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(190, 90, 255)),
		})
		beam.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.2, 0.55),
			NumberSequenceKeypoint.new(0.8, 0.6),
			NumberSequenceKeypoint.new(1, 1),
		})
		beam.Parent = anchor
	end
end

local function buildNeon(deco: Folder, from: number, to: number)
	for d = from, to, 34 do
		local width = rng:NextNumber(14, 26)
		cityTower(deco, Vector3.new(sideX(LANE_GROUND_HALF + width / 2 + 4, 170), Config.GroundY, -(d + rng:NextNumber(0, 20))), width, rng:NextNumber(40, 140))
	end
	-- Glowing grid across the lane.
	for d = from, math.min(to, Config.LaneLength), 40 do
		prop({
			Name = "GridLine",
			Size = Vector3.new(LANE_GROUND_HALF * 2, 0.15, 0.5),
			CFrame = CFrame.new(0, Config.GroundY + 0.05, -d),
			Color = Color3.fromRGB(60, 120, 255),
			Material = Enum.Material.Neon,
			CastShadow = false,
			Parent = deco,
		})
	end
	for _, x in { -20, 20 } do
		prop({
			Name = "GridLine",
			Size = Vector3.new(0.5, 0.15, to - from),
			CFrame = CFrame.new(x, Config.GroundY + 0.05, -(from + to) / 2),
			Color = Color3.fromRGB(255, 60, 200),
			Material = Enum.Material.Neon,
			CastShadow = false,
			Parent = deco,
		})
	end
	-- Holographic rings floating above the lane.
	for i = 1, 4 do
		local d = from + (to - from) * (i / 5)
		ring(deco, CFrame.new(0, 70 + i * 6, -d), 40 + i * 4, 1.2, if i % 2 == 0 then Color3.fromRGB(0, 230, 255) else Color3.fromRGB(255, 60, 200), 18)
	end
	-- Billboards.
	for i, text in { "OVERDRIVE", "VELOCITY", "MAX SPEED" } do
		local x = if i % 2 == 0 then 90 else -90
		local board = sign(deco, Vector3.new(30, 12, 1), CFrame.new(x, 40, -(from + i * (to - from) / 4)), text, Color3.fromRGB(16, 14, 30), Color3.fromRGB(120, 240, 255), Enum.Material.SmoothPlastic)
		board.CastShadow = false
	end
end

--------------------------------------------------------------------------------
-- Lighting (the client blends per-biome presets on top of this)
--------------------------------------------------------------------------------

local function setupLighting()
	local preset = Config.Zones[1].Lighting
	Lighting.ClockTime = preset.ClockTime
	Lighting.Brightness = preset.Brightness
	Lighting.Ambient = preset.Ambient
	Lighting.OutdoorAmbient = preset.OutdoorAmbient
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.3

	for _, child in Lighting:GetChildren() do
		if child:IsA("Atmosphere") or child:IsA("PostEffect") or child:IsA("Sky") then
			child:Destroy()
		end
	end

	local sky = Instance.new("Sky")
	sky.StarCount = 3000
	sky.CelestialBodiesShown = true
	sky.SunAngularSize = 14
	sky.MoonAngularSize = 9
	sky.Parent = Lighting

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = preset.Density
	atmosphere.Offset = 0.2
	atmosphere.Color = preset.AtmosphereColor
	atmosphere.Decay = preset.Decay
	atmosphere.Glare = preset.Glare
	atmosphere.Haze = preset.Haze
	atmosphere.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = preset.Bloom
	bloom.Size = 28
	bloom.Threshold = 1.4
	bloom.Parent = Lighting

	local color = Instance.new("ColorCorrectionEffect")
	color.Saturation = preset.Saturation
	color.Contrast = preset.Contrast
	color.TintColor = preset.Tint
	color.Brightness = 0.02
	color.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.06
	rays.Spread = 0.6
	rays.Parent = Lighting
end

function WorldBuilder.Build()
	local existing = Workspace:FindFirstChild("Map")
	if existing then
		existing:Destroy()
	end

	local map = Instance.new("Folder")
	map.Name = "Map"

	-- Terrain failing (e.g. an engine limit) must never stop the game loading.
	local ok, err = pcall(buildBaseTerrain)
	if ok then
		local featuresOk, featuresErr = pcall(buildTerrainFeatures)
		if not featuresOk then
			warn("[SlingSmash] Some terrain scenery failed:", featuresErr)
		end
	else
		warn("[SlingSmash] Terrain build failed, using plain ground:", err)
		buildFallbackGround(map)
	end

	buildLane(map)
	buildSlingshot(map)
	buildHowToPlay(map)

	local deco = Instance.new("Folder")
	deco.Name = "Decorations"
	deco.Parent = map
	local builders = { buildSkyKingdom, buildJungle, buildVolcanic, buildFrozen, buildNeon }
	for index, builder in builders do
		local from, to = zoneRange(index)
		local folder = Instance.new("Folder")
		folder.Name = Config.Zones[index].Key
		folder.Parent = deco
		builder(folder, from, to)
	end

	map.Parent = Workspace
	setupLighting()
	return map
end

return WorldBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="17">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="18">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="19">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--[[
	Sling Smash - client entry point.

	Game loop:  Lobby -> Aiming (in the slingshot) -> Charging (hold) -> Flying
	            -> Results -> Retry / Return

	The rules of a flight live in Shared/RunSim; this script steps it every
	frame and turns its events into visuals, sound and camera moves. The
	character is put in PlatformStand and its root part follows the simulation,
	which replicates to other players because each client owns its character.
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Physics = require(Shared:WaitForChild("Physics"))
local RunSim = require(Shared:WaitForChild("RunSim"))

local Atmosphere = require(script.Atmosphere)
local Course = require(script.Course)
local Effects = require(script.Effects)
local FlightEvents = require(script.FlightEvents)
local Quality = require(script.Quality)
local UI = require(script.UI)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local GetDataRemote = remotes:WaitForChild("GetData") :: RemoteFunction
local DataChangedRemote = remotes:WaitForChild("DataChanged") :: RemoteEvent
local StartLaunchRemote = remotes:WaitForChild("StartLaunch") :: RemoteFunction
local FinishLaunchRemote = remotes:WaitForChild("FinishLaunch") :: RemoteFunction
local UpdateSettingRemote = remotes:WaitForChild("UpdateSetting") :: RemoteEvent

local HOLD_STEP = "SlingSmashHold"
local FLIGHT_STEP = "SlingSmashFlight"
local BAND_STEP = "SlingSmashBands"
local FINISH_STEP = "SlingSmashFinish"
local CHARGE_ACTION = "SlingSmashCharge"
local BOOST_ACTION = "SlingSmashBoost"
local SUBSTEP = 1 / 120
local F = Config.Flight

local rng = Random.new()

--------------------------------------------------------------------------------
-- State
--------------------------------------------------------------------------------

local state = "Lobby" -- Lobby | Aiming | Charging | Flying | Results
local data = nil
local stats = Config.ComputeStats({}, 0)
local power = 0
local chargeStart = 0
local chargeInput: InputObject? = nil
local maxAnnounced = false
local aim = { Angle = F.LaunchAngle, Yaw = 0 }
local drag = nil -- { Start: Vector2, Angle, Yaw } while charging with a pointer
local run = nil -- RunSim for the current launch
local flight = nil -- client-side presentation state for the current launch

local character: Model? = nil
local humanoid: Humanoid? = nil
local root: BasePart? = nil
local savedGroups = {} -- [BasePart] = original CollisionGroup

local course = Course.new()
task.spawn(function()
	course:Build()
end)

local controls = nil
task.spawn(function()
	local playerScripts = player:WaitForChild("PlayerScripts")
	local module = playerScripts:WaitForChild("PlayerModule", 10)
	if module then
		local ok, playerModule = pcall(require, module)
		if ok and playerModule then
			controls = (playerModule :: any):GetControls()
		end
	end
end)

-- Render-step bindings, tracked so cleanup never unbinds something unbound.
local boundSteps = {}
local function bindStep(name: string, callback: (number) -> ())
	if boundSteps[name] then
		RunService:UnbindFromRenderStep(name)
	end
	RunService:BindToRenderStep(name, Enum.RenderPriority.Camera.Value + 1, callback)
	boundSteps[name] = true
end
local function unbindStep(name: string)
	if boundSteps[name] then
		boundSteps[name] = nil
		RunService:UnbindFromRenderStep(name)
	end
end

local function camera(): Camera
	return Workspace.CurrentCamera :: Camera
end

local function cameraEffectsOn(): boolean
	return data == nil or data.Settings.CameraShake ~= false
end

--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------

-- Movement input as (x = right, z = back). Works with keyboard, sticks and touch.
local function moveInput(): Vector3
	if controls then
		local ok, move = pcall(function()
			return controls:GetMoveVector()
		end)
		if ok and typeof(move) == "Vector3" and move.Magnitude > 0.05 then
			return move
		end
	end
	local x, z = 0, 0
	if UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then
		x -= 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then
		x += 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
		z -= 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
		z += 1
	end
	return Vector3.new(x, 0, z)
end

-- -1 (left) .. 1 (right).
local function steerInput(): number
	return math.clamp(moveInput().X, -1, 1)
end

local function setFlyerMode(enabled: boolean)
	if enabled then
		if humanoid then
			humanoid.PlatformStand = true
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
		end
		if character then
			for _, descendant in character:GetDescendants() do
				if descendant:IsA("BasePart") then
					if savedGroups[descendant] == nil then
						savedGroups[descendant] = descendant.CollisionGroup
					end
					descendant.CollisionGroup = "Flyer"
				end
			end
		end
	else
		for part, group in savedGroups do
			if part.Parent then
				part.CollisionGroup = group
			end
		end
		table.clear(savedGroups)
		if humanoid then
			humanoid.PlatformStand = false
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
		end
	end
end

local function restoreCamera()
	local cam = camera()
	cam.CameraType = Enum.CameraType.Custom
	if humanoid then
		cam.CameraSubject = humanoid
	end
	cam.FieldOfView = 70
end

-- The player list covers the distance counter, so hide it while flying.
local function setPlayerListVisible(visible: boolean)
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, visible)
	end)
end

-- "Press E to launch" prompts only make sense while standing around.
local function setPromptsEnabled(enabled: boolean)
	ProximityPromptService.Enabled = enabled
end

local function aimFlat(): Vector3
	return Physics.AimDirection(0, aim.Yaw)
end

local function pouchCFrame(amount: number): CFrame
	local position = Physics.PouchPosition(amount)
	return CFrame.lookAt(position, position + aimFlat())
end

--------------------------------------------------------------------------------
-- Slingshot bands: stretch, heat up and vibrate with tension; snap back after
--------------------------------------------------------------------------------

local bands: { BasePart } = {}
local hiddenSlingParts: { BasePart } = {}
local recoil = nil -- { Start, From }
local BAND_REST = Config.SlingshotPosition + Vector3.new(0, Config.SlingshotArmTip - 0.6, 0.3)

local function makeBand(): BasePart
	local band = Instance.new("Part")
	band.Name = "SlingBand"
	band.Anchored = true
	band.CanCollide = false
	band.CanQuery = false
	band.CanTouch = false
	band.CastShadow = false
	band.Material = Enum.Material.SmoothPlastic
	band.Color = Color3.fromRGB(255, 120, 60)
	band.Size = Vector3.new(0.45, 0.45, 1)
	band.Transparency = 1
	band.Parent = course.Folder
	return band
end

local function setBandsVisible(visible: boolean)
	if #bands == 0 then
		bands = { makeBand(), makeBand() }
	end
	for _, band in bands do
		band.Transparency = if visible then 0 else 1
	end
	-- Hide the server's resting band locally while our stretched bands show.
	local map = Workspace:FindFirstChild("Map")
	local slingshot = map and map:FindFirstChild("Slingshot")
	if slingshot and #hiddenSlingParts == 0 then
		for _, name in { "RestBand", "Pouch" } do
			local partInstance = slingshot:FindFirstChild(name)
			if partInstance and partInstance:IsA("BasePart") then
				table.insert(hiddenSlingParts, partInstance)
			end
		end
	end
	for _, slingPart in hiddenSlingParts do
		slingPart.Transparency = if visible then 1 else 0
	end
end

local BAND_COLD = Color3.fromRGB(255, 120, 60)
local BAND_TENSE = Color3.fromRGB(255, 40, 40)
local BAND_HOT = Color3.fromRGB(255, 240, 200)

local function updateBands(pouch: Vector3, tension: number)
	local base = Config.SlingshotPosition
	local tipY = Config.SlingshotArmTip - 0.6
	-- Shiver at high tension.
	if tension > 0.6 then
		local amount = (tension - 0.6) / 0.4 * 0.09
		pouch += Vector3.new(rng:NextNumber(-amount, amount), rng:NextNumber(-amount, amount), 0)
	end
	local color = if tension < 0.7
		then BAND_COLD:Lerp(BAND_TENSE, tension / 0.7)
		else BAND_TENSE:Lerp(BAND_HOT, (tension - 0.7) / 0.3)
	local width = 0.45 - 0.22 * math.clamp(tension, 0, 1)
	for i, side in { -1, 1 } do
		local band = bands[i]
		if band then
			local tip = base + Vector3.new(side * Config.SlingshotArmSpread, tipY, 0)
			local length = (pouch - tip).Magnitude
			band.Size = Vector3.new(width, width, math.max(0.1, length))
			band.CFrame = CFrame.lookAt((tip + pouch) / 2, pouch)
			band.Color = color
		end
	end
end

-- After release the bands snap forward, overshoot and settle.
local function bandRecoilStep(_dt: number)
	local r = recoil
	if not r then
		unbindStep(BAND_STEP)
		return
	end
	local t = os.clock() - r.Start
	if t > 0.6 then
		recoil = nil
		unbindStep(BAND_STEP)
		setBandsVisible(false)
		return
	end
	local offset = (r.From - BAND_REST) * math.exp(-7 * t) * math.cos(t * 26)
	updateBands(BAND_REST + offset, 0)
end

local function startBandRecoil(from: Vector3)
	recoil = { Start = os.clock(), From = from }
	bindStep(BAND_STEP, bandRecoilStep)
end

--------------------------------------------------------------------------------
-- Trajectory preview: marching dots along the predicted arc
--------------------------------------------------------------------------------

local DOTS = 26
local aimFolder = Instance.new("Folder")
aimFolder.Name = "SlingAim"
aimFolder.Parent = Workspace
local dots: { BasePart } = {}
local landing: BasePart? = nil
local predicted: { Vector3 } = {}
local predictedKey = ""
local landingVisible = false

local function aimPart(props): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	for key, value in props do
		(p :: any)[key] = value
	end
	p.Parent = aimFolder
	return p
end

local function setTrajectoryVisible(visible: boolean)
	if #dots == 0 then
		for i = 1, DOTS do
			local size = 0.75 - 0.45 * (i - 1) / (DOTS - 1)
			table.insert(dots, aimPart({ Name = "AimDot", Shape = Enum.PartType.Ball, Size = Vector3.new(size, size, size), Transparency = 1 }))
		end
		landing = aimPart({
			Name = "AimLanding",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.2, 6, 6),
			Transparency = 1,
		})
	end
	if not visible then
		for _, dot in dots do
			dot.Transparency = 1
		end
		if landing then
			landing.Transparency = 1
		end
	end
end

local function updateTrajectory(launchPower: number)
	local key = string.format("%.3f:%.1f:%.1f", launchPower, aim.Angle, aim.Yaw)
	if key ~= predictedKey then
		predictedKey = key
		local velocity = Physics.LaunchVelocity(stats, launchPower, aim.Angle, aim.Yaw)
		local points, land, landed = Physics.Predict(stats, Physics.PouchPosition(launchPower), velocity, 10, 1 / 30)
		predicted = points
		landingVisible = landed
		if landing then
			landing.CFrame = CFrame.new(Vector3.new(land.X, Config.GroundY + 0.12, land.Z)) * CFrame.Angles(0, 0, math.pi / 2)
		end
	end
	-- Dots march outward along the arc.
	local count = #predicted
	local phase = (os.clock() * 2.5) % 1
	local hot = Color3.fromRGB(255, 255, 255):Lerp(Color3.fromRGB(255, 220, 90), launchPower)
	for i, dot in dots do
		local index = math.floor((i - 1 + phase) * 1.5) + 1
		local point = predicted[index]
		if point and index <= count then
			dot.CFrame = CFrame.new(point)
			dot.Color = hot
			dot.Transparency = 0.15 + 0.6 * (i / DOTS)
		else
			dot.Transparency = 1
		end
	end
	if landing then
		landing.Color = hot
		landing.Transparency = if landingVisible then 0.45 + 0.2 * math.sin(os.clock() * 6) else 1
	end
end

--------------------------------------------------------------------------------
-- Aiming + charging
--------------------------------------------------------------------------------

local enterAiming, startFlight, returnToLobby, boost

local function updateAim(dt: number)
	local move = moveInput()
	aim.Angle = math.clamp(aim.Angle - move.Z * F.AimRate * dt, F.MinAngle, F.MaxAngle)
	aim.Yaw = math.clamp(aim.Yaw + move.X * F.AimRate * 0.6 * dt, -F.MaxYaw, F.MaxYaw)
end

local function aimCamera(amount: number, dt: number)
	local pouch = Physics.PouchPosition(amount)
	local flat = aimFlat()
	local position = pouch - flat * (14 + amount * 3) + Vector3.new(0, 5 + amount + (aim.Angle - F.LaunchAngle) * 0.08, 0)
	local target = pouch + Physics.AimDirection(aim.Angle * 0.45, aim.Yaw) * 40 + Vector3.new(0, 2, 0)
	local cam = camera()
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame = CFrame.lookAt(position, target) * Effects.ShakeOffset(dt)
	cam.FieldOfView = 70 + amount * (if cameraEffectsOn() then 6 else 3)
end

local function holdStep(dt: number)
	if state == "Charging" then
		power = math.min(1, (os.clock() - chargeStart) / F.ChargeTime)
		if power >= 1 and not maxAnnounced then
			maxAnnounced = true
			UI.Pop("MAX POWER!", "max")
			Effects.Overcharge(Physics.PouchPosition(1))
		end
		if power > 0.6 then
			Effects.Shake(0.08 * power)
		end
	end
	if not drag then
		updateAim(dt)
	end
	local cf = pouchCFrame(power)
	if root then
		root.CFrame = cf
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end
	updateBands(cf.Position + aimFlat() * 1.2, if state == "Charging" then power else 0)
	aimCamera(power, dt)
	updateTrajectory(if state == "Charging" then power else 1)
	if state == "Charging" then
		Effects.UpdateCharge(cf.Position, power)
	end
	UI.SetPower(power, if state == "Charging" then "charging" else "aim", aim.Angle, aim.Yaw)
end

local function unbindAiming()
	unbindStep(HOLD_STEP)
	ContextActionService:UnbindAction(CHARGE_ACTION)
	Effects.StopCharge()
	setTrajectoryVisible(false)
	drag = nil
end

local function isPointerInput(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function startCharging(input: InputObject?)
	if state ~= "Aiming" then
		return
	end
	state = "Charging"
	chargeStart = os.clock()
	chargeInput = input
	maxAnnounced = false
	if input and isPointerInput(input) then
		drag = { Start = Vector2.new(input.Position.X, input.Position.Y), Angle = aim.Angle, Yaw = aim.Yaw }
	end
	Effects.StartCharge(Physics.PouchPosition(0))
	Effects.Play("Click", 0.7)
end

local function releaseCharge()
	if state ~= "Charging" then
		return
	end
	local launchPower = power
	local pouch = pouchCFrame(launchPower).Position + aimFlat() * 1.2
	unbindAiming()
	startBandRecoil(pouch)
	startFlight(launchPower)
end

local function chargeAction(_actionName: string, inputState: Enum.UserInputState, input: InputObject)
	if inputState == Enum.UserInputState.Begin then
		startCharging(input)
	elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
		if chargeInput and chargeInput.KeyCode == input.KeyCode then
			releaseCharge()
		end
	end
	return Enum.ContextActionResult.Sink
end

enterAiming = function()
	if state == "Aiming" or state == "Charging" or state == "Flying" then
		return
	end
	if not (root and humanoid and humanoid.Health > 0) then
		return
	end
	if not course.Ready then
		UI.Toast("The course is still loading...")
		return
	end

	UI.ClosePanels()
	UI.HideResults()
	unbindStep(FINISH_STEP)
	course:Reset()
	course:SetView(0)
	setFlyerMode(true)

	state = "Aiming"
	power = 0
	chargeInput = nil
	drag = nil
	predictedKey = ""
	setPromptsEnabled(false)
	recoil = nil
	unbindStep(BAND_STEP)
	setBandsVisible(true)
	setTrajectoryVisible(true)
	bindStep(HOLD_STEP, holdStep)
	ContextActionService:BindActionAtPriority(
		CHARGE_ACTION,
		chargeAction,
		false,
		Enum.ContextActionPriority.High.Value + 10,
		Enum.KeyCode.Space,
		Enum.KeyCode.ButtonA,
		Enum.KeyCode.ButtonR2
	)

	UI.SetMode("Aiming")
	UI.SetPower(0, "aim", aim.Angle, aim.Yaw)
	UI.SetRunCoins(0, true)
	Effects.Play("Click", 1)
end

local function cancelAim()
	if state ~= "Aiming" and state ~= "Charging" then
		return
	end
	unbindAiming()
	setBandsVisible(false)
	returnToLobby()
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not isPointerInput(input) then
		return
	end
	if state == "Aiming" then
		startCharging(input)
	elseif state == "Flying" and input.UserInputType == Enum.UserInputType.MouseButton1 then
		-- Mouse clicks boost; phones use the NITRO button so stray taps don't waste charges.
		boost()
	end
end)

-- Dragging while charging aims like pulling a real slingshot: drag down to
-- aim higher, drag left to aim right.
UserInputService.InputChanged:Connect(function(input)
	local d = drag
	if state ~= "Charging" or not d or not chargeInput then
		return
	end
	local matches = input == chargeInput
		or (chargeInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)
	if not matches then
		return
	end
	local viewport = camera().ViewportSize
	local delta = Vector2.new(input.Position.X, input.Position.Y) - d.Start
	aim.Angle = math.clamp(d.Angle + delta.Y / math.max(1, viewport.Y) * 70, F.MinAngle, F.MaxAngle)
	aim.Yaw = math.clamp(d.Yaw - delta.X / math.max(1, viewport.X) * 40, -F.MaxYaw, F.MaxYaw)
end)

UserInputService.InputEnded:Connect(function(input)
	if state ~= "Charging" or not chargeInput or not isPointerInput(input) then
		return
	end
	-- Touches must match the finger that started the charge; mouse just needs the button.
	if input == chargeInput or input.UserInputType == Enum.UserInputType.MouseButton1 then
		if chargeInput.UserInputType == input.UserInputType then
			releaseCharge()
		end
	end
end)

--------------------------------------------------------------------------------
-- Flight events: RunSim decides, this makes it look and sound right
--------------------------------------------------------------------------------

local finishFlight

local events = FlightEvents.new({
	Course = course,
	GetRun = function()
		return run
	end,
	GetFlight = function()
		return flight
	end,
	GetCharacter = function()
		return character
	end,
	CameraEffectsOn = cameraEffectsOn,
})

--------------------------------------------------------------------------------
-- Flight loop
--------------------------------------------------------------------------------

local function flightCamera(dt: number, speed: number, steer: number)
	local f = flight
	local r = run
	local camFx = cameraEffectsOn()
	local velocity = r.Velocity
	local flat = Vector3.new(velocity.X, 0, velocity.Z)
	local lookAhead = if flat.Magnitude > 1 then flat.Unit else Config.Forward
	local back = -Config.Forward
	local desired = r.Position
		+ Vector3.new(0, 7 + math.min(speed, 200) * 0.02, 0)
		+ back * (20 + math.min(speed, 220) * 0.03)
		- Vector3.new(velocity.X * 0.06, 0, 0)
	-- A little lag sells momentum without losing the flyer.
	f.CameraPosition = f.CameraPosition:Lerp(desired, 1 - math.exp(-10 * dt))
	local look = r.Position + Config.Forward * 14 + lookAhead * math.min(speed, 160) * 0.05 + Vector3.new(0, 1.5, 0)
	local targetRoll = if camFx then -steer * 0.05 else 0
	f.Roll += (targetRoll - f.Roll) * math.min(1, dt * 5)

	local cam = camera()
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame = CFrame.lookAt(f.CameraPosition, look) * CFrame.Angles(0, 0, f.Roll) * Effects.ShakeOffset(dt)
	f.FovKick = math.max(0, f.FovKick - dt * 25)
	local fovScale = if camFx then 1 else 0.4
	cam.FieldOfView = 70 + (math.clamp(speed * 0.1, 0, 22) + f.FovKick) * fovScale
end

local function flightStep(dt: number)
	local f = flight
	local r = run
	if not f or not r then
		return
	end
	dt = math.min(dt, 0.1)

	-- Hit-stop freezes the world for a heartbeat; slow motion stretches it.
	local simDt = dt
	if f.HitStop > 0 then
		f.HitStop -= dt
		simDt = 0
	elseif f.SlowMo > 0 then
		f.SlowMo -= dt
		simDt = dt * Config.SlowMo.TimeScale
	end
	local steer = steerInput()
	if simDt > 0 then
		local steps = math.max(1, math.ceil(simDt / SUBSTEP))
		local h = simDt / steps
		for _ = 1, steps do
			r:Step(h, steer)
			if r.Done then
				break
			end
		end
	end

	local velocity = r.Velocity
	local speed = velocity.Magnitude

	-- Pose: superman-style, head first, rolling into turns.
	local direction = velocity + Config.Forward * 2
	if direction.Magnitude < 1e-3 then
		direction = Config.Forward
	end
	direction = direction.Unit
	local wobble = if r.Grounded then 0 else math.sin(r.Time * 7) * 0.12
	local pose = CFrame.lookAt(r.Position, r.Position + direction)
		* CFrame.Angles(-math.pi / 2, 0, 0)
		* CFrame.Angles(0, -steer * 0.5 + wobble, 0)
	if root then
		root.CFrame = pose
		root.AssemblyLinearVelocity = velocity
		root.AssemblyAngularVelocity = Vector3.zero
	end

	flightCamera(dt, speed, steer)

	-- HUD + effects.
	local distance = r:Distance()
	UI.SetDistance(math.floor(distance))
	UI.SetRunCoins(r.RunCoins)
	local multiplier = Config.ComboMultiplier(r.Combo, stats.MaxComboMult)
	UI.SetCombo(multiplier, r.ComboTimer / stats.ComboWindow, multiplier >= 2 and r.ComboTimer > 0)
	if r.Ability then
		UI.SetAbility(r.Ability.Kind, r.Ability.TimeLeft / r.Ability.Duration)
	end
	local thrusting = r.Thrust > 0
	Effects.UpdateFlight(pose, velocity, dt, thrusting)
	Effects.UpdateSpeedLines(dt, math.clamp((speed - 50) / 120, 0, 1) + (if thrusting then 0.5 else 0))
	Effects.SetWind(speed / 150)
	course:Update(dt, r.Position, r.Time)
	Atmosphere.Update(distance, camera().CFrame)

	if r.Done then
		finishFlight(r.Done)
	end
end

startFlight = function(launchPower: number)
	local start = Physics.PouchPosition(launchPower)
	local velocity = Physics.LaunchVelocity(stats, launchPower, aim.Angle, aim.Yaw)
	run = RunSim.new(stats, start, velocity, { Rng = Random.new(), Events = events })
	local f = {
		CameraPosition = camera().CFrame.Position,
		FovKick = 6 + launchPower * 6,
		SlowMo = 0,
		HitStop = 0,
		LastHitStop = 0,
		LastBigPop = 0,
		Roll = 0,
		LaunchId = nil,
		IdReady = false,
		BonkTipShown = false,
	}
	flight = f
	state = "Flying"

	task.spawn(function()
		local ok, launchId = pcall(function()
			return StartLaunchRemote:InvokeServer()
		end)
		if ok then
			f.LaunchId = launchId
		end
		f.IdReady = true
	end)

	UI.SetMode("Flying")
	UI.SetBoosts(run.Boosts)
	UI.SetAbility(nil)
	setPlayerListVisible(false)
	ContextActionService:BindActionAtPriority(
		BOOST_ACTION,
		function(_actionName, inputState)
			if inputState == Enum.UserInputState.Begin then
				boost()
			end
			return Enum.ContextActionResult.Sink
		end,
		false,
		Enum.ContextActionPriority.High.Value + 10,
		Enum.KeyCode.Space,
		Enum.KeyCode.ButtonA,
		Enum.KeyCode.ButtonR2
	)
	UI.Pop(if launchPower >= 0.99 then "PERFECT!" else "LAUNCH!", "max")
	Effects.Launch(start, velocity.Unit, launchPower)
	Effects.Play("Launch", 0.85 + launchPower * 0.25, 0.8 + launchPower * 0.4, true)
	bindStep(FLIGHT_STEP, flightStep)
end

-- Mid-air Nitro; limited charges per launch (Rocket Fuel adds more).
boost = function()
	if run then
		run:Boost()
	end
end

-- A short orbit around the flyer when they reach the finish line.
local function finishCinematic(position: Vector3)
	local start = os.clock()
	local cam = camera()
	cam.CameraType = Enum.CameraType.Scriptable
	bindStep(FINISH_STEP, function(_dt)
		local t = os.clock() - start
		if t > 2.4 or state ~= "Results" then
			unbindStep(FINISH_STEP)
			if state == "Results" then
				restoreCamera()
			end
			return
		end
		local angle = t * 1.1
		local offset = Vector3.new(math.sin(angle) * 22, 9 + t * 2, math.cos(angle) * 22)
		cam.CFrame = CFrame.lookAt(position + offset, position + Vector3.new(0, 3, 0))
		cam.FieldOfView = 60
	end)
end

local function cleanupFlightVisuals()
	Effects.EndFlight()
	Effects.SetWind(0)
	Effects.HideSpeedLines()
	UI.SetAbility(nil)
end

finishFlight = function(reason: string)
	local f = flight
	local r = run
	if not f or not r then
		return
	end
	flight = nil
	run = nil
	unbindStep(FLIGHT_STEP)
	ContextActionService:UnbindAction(BOOST_ACTION)
	setPlayerListVisible(true)
	setPromptsEnabled(true)
	cleanupFlightVisuals()
	state = "Results"

	-- Stand back up where we landed.
	if root and humanoid then
		local p = Vector3.new(r.Position.X, Config.GroundY + 3.2, r.Position.Z)
		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = CFrame.lookAt(p, p + Config.Forward)
		setFlyerMode(false)
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
	UI.SetMode("Results")
	UI.SetCombo(1, 0, false)
	if reason == "finish" then
		UI.Pop("🏆 FINISH!", "best")
		Effects.Play("Victory", 1, 1, true)
		Effects.Flash(Color3.fromRGB(255, 230, 120), 0.4)
		finishCinematic(r.Position)
	else
		restoreCamera()
	end

	local report = r:Report()
	local distance = report.Distance
	local comboMultiplier = Config.ComboMultiplier(r.MaxCombo, stats.MaxComboMult)
	task.spawn(function()
		local waited = 0
		while not f.IdReady and waited < 5 do
			waited += task.wait(0.1)
		end
		local ok, result = pcall(function()
			return FinishLaunchRemote:InvokeServer(f.LaunchId, report)
		end)
		if not ok or type(result) ~= "table" then
			result = {
				Earned = 0,
				Distance = math.floor(distance),
				Smashes = report.Smashes,
				MaxCombo = report.MaxCombo,
				NewBest = false,
				Failed = true,
			}
		end
		if state ~= "Results" then
			return
		end
		if result.NewBest then
			UI.Pop("NEW BEST!", "best")
			Effects.Flash(Color3.fromRGB(255, 200, 255), 0.3)
		end
		local discoveries = result.Discoveries
		if type(discoveries) == "table" and #discoveries > 0 then
			UI.Banner("📖 NEW DISCOVERY: " .. discoveries[1].Icon .. " " .. string.upper(discoveries[1].Name))
		end
		Effects.Play("Coin", 1)
		UI.ShowResults(result, comboMultiplier)
	end)
end

local function resetToLobbyState()
	flight = nil
	run = nil
	unbindStep(FLIGHT_STEP)
	unbindStep(FINISH_STEP)
	unbindAiming()
	recoil = nil
	unbindStep(BAND_STEP)
	setBandsVisible(false)
	ContextActionService:UnbindAction(BOOST_ACTION)
	setPlayerListVisible(true)
	setPromptsEnabled(true)
	cleanupFlightVisuals()
end

returnToLobby = function()
	resetToLobbyState()
	state = "Lobby"
	setFlyerMode(false)
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = CFrame.lookAt(Config.ReturnPoint, Config.ReturnPoint + Config.Forward)
	end
	restoreCamera()
	UI.SetMode("Lobby")
end

--------------------------------------------------------------------------------
-- Character lifecycle
--------------------------------------------------------------------------------

local function onCharacterAdded(newCharacter: Model)
	character = newCharacter
	humanoid = newCharacter:WaitForChild("Humanoid", 10) :: Humanoid?
	root = newCharacter:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	resetToLobbyState()
	table.clear(savedGroups)
	state = "Lobby"
	UI.SetMode("Lobby")
	restoreCamera()
	if humanoid then
		humanoid.Died:Connect(function()
			if character == newCharacter then
				resetToLobbyState()
				table.clear(savedGroups)
				state = "Lobby"
				UI.SetMode("Lobby")
			end
		end)
	end
end

--------------------------------------------------------------------------------
-- Data + UI wiring
--------------------------------------------------------------------------------

local function applyData(newData)
	if type(newData) ~= "table" then
		return
	end
	data = newData
	stats = Config.ComputeStats(newData.Upgrades, newData.Rebirths)
	predictedKey = "" -- upgrades change the arc
	Quality.Apply(newData.Settings)
	UI.SetData(newData)
	Effects.ApplySettings(newData.Settings)
end

local function invoke(remoteName: string, ...): (boolean, any)
	local args = table.pack(...)
	local remote = remotes:FindFirstChild(remoteName)
	if not remote or not remote:IsA("RemoteFunction") then
		return false, "Missing remote " .. remoteName
	end
	local ok, success, message = pcall(function()
		return remote:InvokeServer(table.unpack(args, 1, args.n))
	end)
	if not ok then
		return false, "Server didn't respond"
	end
	return success == true, message
end

Quality.Apply(nil)
Effects.Init(playerGui)
UI.Init(playerGui, {
	Launch = function()
		enterAiming()
	end,
	Cancel = function()
		cancelAim()
	end,
	Retry = function()
		enterAiming()
	end,
	Return = function()
		returnToLobby()
	end,
	Click = function()
		Effects.Play("Click", 1)
	end,
	BuyUpgrade = function(nodeId: string)
		local node = Config.NodesById[nodeId]
		if not node or not data then
			return
		end
		if data.Upgrades[nodeId] then
			return
		end
		if node.Requires ~= "Start" and not data.Upgrades[node.Requires] then
			UI.Toast("🔒 Unlock " .. Config.NodesById[node.Requires].Name .. " first")
			return
		end
		if data.Coins < node.Cost then
			UI.Toast("Not enough ⭐! Launch to earn more.", Color3.fromRGB(255, 120, 120))
			return
		end
		local ok, message = invoke("BuyUpgrade", nodeId)
		if ok then
			Effects.Play("Coin", 1.4)
			UI.Toast("✅ " .. node.Name .. " unlocked!", Color3.fromRGB(140, 255, 100))
		else
			UI.Toast(message or "Couldn't buy that", Color3.fromRGB(255, 120, 120))
		end
	end,
	Rebirth = function()
		local ok, message = invoke("Rebirth")
		if ok then
			UI.ClosePanels()
			UI.Pop("REBIRTH!", "best")
			Effects.Flash(Color3.fromRGB(200, 140, 255), 0.5)
		else
			UI.Toast(message or "Can't rebirth yet", Color3.fromRGB(255, 120, 120))
		end
	end,
	BuyTrail = function(trailId: string)
		local ok, message = invoke("BuyTrail", trailId)
		if ok then
			Effects.Play("Coin", 1.4)
			UI.Toast("✨ New trail equipped!", Color3.fromRGB(140, 255, 100))
		else
			UI.Toast(message or "Couldn't buy that", Color3.fromRGB(255, 120, 120))
		end
	end,
	EquipTrail = function(trailId: string)
		local ok, message = invoke("EquipTrail", trailId)
		if not ok then
			UI.Toast(message or "Couldn't equip that", Color3.fromRGB(255, 120, 120))
		end
	end,
	Boost = function()
		boost()
	end,
	ClaimDaily = function()
		local ok, result = invoke("ClaimDaily")
		if ok then
			UI.Pop("🎁 DAILY REWARD!", "best")
			UI.Toast("🎁 +" .. Format.Commas(tonumber(result) or 0) .. " coins!", Color3.fromRGB(140, 255, 100))
			Effects.Play("Coin", 1.3)
			Effects.Flash(Color3.fromRGB(255, 225, 90), 0.3)
		else
			UI.Toast(tostring(result or "Can't claim yet"), Color3.fromRGB(255, 120, 120))
		end
	end,
	RedeemCode = function(text: string)
		local ok, result = invoke("RedeemCode", text)
		if ok then
			UI.CodeResult(true, "✅ +" .. Format.Commas(tonumber(result) or 0) .. " coins!")
			Effects.Play("Coin", 1.3)
		else
			UI.CodeResult(false, tostring(result or "Couldn't redeem that"))
		end
	end,
	Setting = function(key: string, value: boolean)
		if not data then
			return
		end
		data.Settings[key] = value
		Quality.Apply(data.Settings)
		Effects.ApplySettings(data.Settings)
		UI.SetData(data)
		UpdateSettingRemote:FireServer(key, value)
	end,
})

-- Walking up to the slingshot and pressing E also works.
ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
	if who == player and prompt.Name == "SlingLaunchPrompt" then
		enterAiming()
	end
end)

-- Holding the power panel itself also charges (handy on phones).
UI.PowerButton().InputBegan:Connect(function(input)
	if state == "Aiming" and isPointerInput(input) then
		startCharging(input)
	end
end)

DataChangedRemote.OnClientEvent:Connect(applyData)
task.spawn(function()
	for _ = 1, 5 do
		local ok, result = pcall(function()
			return GetDataRemote:InvokeServer()
		end)
		if ok and type(result) == "table" then
			applyData(result)
			return
		end
		task.wait(2)
	end
end)

-- While not flying: keep the course, hazards and biome atmosphere around the player.
RunService.Heartbeat:Connect(function(dt)
	if flight then
		return
	end
	local focus = if root then root.Position else Config.LobbySpawn
	course:Update(dt, focus, os.clock())
	Atmosphere.Update(math.max(0, -focus.Z), camera().CFrame)
end)

player.CharacterAdded:Connect(onCharacterAdded)
if player.Character then
	task.spawn(onCharacterAdded, player.Character)
end
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Atmosphere</string>
            <string name="Source"><![CDATA[--[[
	Per-biome lighting and weather, on this client only.

	As you fly (or walk) down the lane, the time of day, fog, colour grade and
	bloom blend smoothly from one biome's preset to the next (Config.Zones[i]
	.Lighting), and a single weather emitter in front of the camera switches
	between wisps, leaves, embers, snow and neon motes. The Volcanic Wasteland
	adds distant lightning.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local CourseLayout = require(ReplicatedStorage.Shared.CourseLayout)
local Effects = require(script.Parent.Effects)
local Quality = require(script.Parent.Quality)

local Atmosphere = {}

local BLEND = 70 -- studs either side of a biome edge to blend over
local rng = Random.new()

local holder: BasePart? = nil
local weather = {} -- [name] = { Emitter, Rate }
local lastKey = ""
local currentWeather = nil
local nextLightning = 0

local WEATHER = {
	Wisps = {
		Rate = 3,
		Lifetime = NumberRange.new(4, 6),
		Speed = NumberRange.new(2, 4),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 9) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.4, 0.8), NumberSequenceKeypoint.new(1, 1) }),
		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255)),
		Acceleration = Vector3.new(1, 0, 0),
	},
	Leaves = {
		Rate = 10,
		Lifetime = NumberRange.new(3, 5),
		Speed = NumberRange.new(2, 5),
		Size = NumberSequence.new(0.5),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-120, 120),
		Color = ColorSequence.new(Color3.fromRGB(110, 190, 70), Color3.fromRGB(200, 170, 60)),
		Acceleration = Vector3.new(3, -3, 0),
	},
	Embers = {
		Rate = 18,
		Lifetime = NumberRange.new(2, 4),
		Speed = NumberRange.new(1, 4),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) }),
		LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(255, 200, 80), Color3.fromRGB(255, 70, 20)),
		Acceleration = Vector3.new(2, 4, 0),
	},
	Snow = {
		Rate = 34,
		Lifetime = NumberRange.new(3, 5),
		Speed = NumberRange.new(6, 10),
		Size = NumberSequence.new(0.45),
		Transparency = NumberSequence.new(0.1, 0.4),
		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255)),
		Acceleration = Vector3.new(4, -2, 0),
	},
	Data = {
		Rate = 12,
		Lifetime = NumberRange.new(2, 4),
		Speed = NumberRange.new(1, 3),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.2, 0.3), NumberSequenceKeypoint.new(1, 0) }),
		LightEmission = 1,
		Color = ColorSequence.new(Color3.fromRGB(0, 230, 255), Color3.fromRGB(255, 60, 200)),
		Acceleration = Vector3.new(0, 1, 0),
	},
}

local function ensureHolder(): BasePart
	if holder and holder.Parent then
		return holder
	end
	local part = Instance.new("Part")
	part.Name = "SlingWeather"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(90, 1, 90)
	part.Parent = Workspace
	for name, props in WEATHER do
		local e = Instance.new("ParticleEmitter")
		e.Name = name
		e.EmissionDirection = Enum.NormalId.Bottom
		e.SpreadAngle = Vector2.new(25, 25)
		for key, value in props do
			if key ~= "Rate" then
				(e :: any)[key] = value
			end
		end
		e.Rate = 0
		e.Parent = part
		weather[name] = { Emitter = e, Rate = props.Rate }
	end
	holder = part
	return part
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- The preset for a distance, blended near biome edges.
local function presetAt(distance: number)
	local index = CourseLayout.ZoneIndexAt(distance)
	local zone = Config.Zones[index]
	local nextZone = Config.Zones[index + 1]
	local previousZone = Config.Zones[index - 1]
	local a, b, t = zone.Lighting, zone.Lighting, 0
	if nextZone and distance > zone.EndsAt - BLEND then
		a, b = zone.Lighting, nextZone.Lighting
		t = math.clamp((distance - (zone.EndsAt - BLEND)) / (BLEND * 2), 0, 0.5)
	elseif previousZone and distance < previousZone.EndsAt + BLEND then
		a, b = previousZone.Lighting, zone.Lighting
		t = math.clamp((distance - (previousZone.EndsAt - BLEND)) / (BLEND * 2), 0.5, 1)
	end
	return a, b, t, index
end

local function apply(a, b, t: number)
	Lighting.ClockTime = lerp(a.ClockTime, b.ClockTime, t) % 24
	Lighting.Brightness = lerp(a.Brightness, b.Brightness, t)
	Lighting.Ambient = a.Ambient:Lerp(b.Ambient, t)
	Lighting.OutdoorAmbient = a.OutdoorAmbient:Lerp(b.OutdoorAmbient, t)
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		atmosphere.Density = lerp(a.Density, b.Density, t)
		atmosphere.Haze = lerp(a.Haze, b.Haze, t)
		atmosphere.Glare = lerp(a.Glare, b.Glare, t)
		atmosphere.Color = a.AtmosphereColor:Lerp(b.AtmosphereColor, t)
		atmosphere.Decay = a.Decay:Lerp(b.Decay, t)
	end
	for _, child in Lighting:GetChildren() do
		if child:IsA("ColorCorrectionEffect") and child.Name ~= "SlingAbilityTint" then
			child.TintColor = a.Tint:Lerp(b.Tint, t)
			child.Saturation = lerp(a.Saturation, b.Saturation, t)
			child.Contrast = lerp(a.Contrast, b.Contrast, t)
		elseif child:IsA("BloomEffect") then
			child.Intensity = lerp(a.Bloom, b.Bloom, t)
		end
	end
end

local function lightningStrike(cameraCFrame: CFrame)
	local ahead = cameraCFrame.Position + cameraCFrame.LookVector * rng:NextNumber(250, 450)
	local top = ahead + Vector3.new(rng:NextNumber(-250, 250), 220, 0)
	local bottom = Vector3.new(top.X + rng:NextNumber(-40, 40), Config.GroundY, top.Z + rng:NextNumber(-40, 40))
	Effects.Lightning(top, bottom, Color3.fromRGB(255, 230, 200), 0.25, 9)
	Lighting.ExposureCompensation = 0.9
	TweenService:Create(Lighting, TweenInfo.new(0.45, Enum.EasingStyle.Quad), { ExposureCompensation = 0 }):Play()
	task.delay(rng:NextNumber(0.3, 0.9), function()
		Effects.Play("Boom", 0.35, 0.5)
	end)
end

-- distance: how far down the lane the player (or camera) is.
function Atmosphere.Update(distance: number, cameraCFrame: CFrame?)
	local a, b, t, index = presetAt(math.max(0, distance))
	local key = string.format("%d:%.2f", index, t)
	if key ~= lastKey then
		lastKey = key
		apply(a, b, t)
	end

	local zone = Config.Zones[index]
	local part = ensureHolder()
	if cameraCFrame then
		part.CFrame = CFrame.new(cameraCFrame.Position + cameraCFrame.LookVector * 35 + Vector3.new(0, 22, 0))
	end
	local scale = Quality.Current.Weather
	if currentWeather ~= zone.Weather or weather[zone.Weather].Applied ~= scale then
		currentWeather = zone.Weather
		for name, entry in weather do
			local on = name == zone.Weather
			entry.Emitter.Rate = if on then entry.Rate * scale else 0
			entry.Applied = if on then scale else nil
		end
	end

	-- Distant lightning over the volcanoes.
	if zone.Key == "Volcanic" and cameraCFrame and Quality.Current.Lightning then
		local now = os.clock()
		if now >= nextLightning then
			if nextLightning > 0 then
				lightningStrike(cameraCFrame)
			end
			nextLightning = now + rng:NextNumber(4, 9)
		end
	end
end

return Atmosphere
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Course</string>
            <string name="Source"><![CDATA[--[[
	The course visuals, built locally on each client from CourseLayout.

	RunSim (shared) decides what gets hit; this module only draws it:
	  * Only the stretch of course near the player is parented to Workspace
	    (SetView). Everything else waits with Parent = nil, which keeps the part
	    count and render cost low, especially on phones.
	  * Smashed blocks are flung with real physics, but only up to the quality
	    budget (Quality.Current.MaxDebris); beyond that they just vanish.
	  * Moving hazards are animated from the same time functions RunSim uses.
	Reset() puts everything back for the next launch.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local CourseLayout = require(ReplicatedStorage.Shared.CourseLayout)
local Quality = require(script.Parent.Quality)
local Widgets = require(script.Parent.Widgets)

local Course = {}
Course.__index = Course

local H = Config.Hazards
local UP = CFrame.Angles(0, 0, math.pi / 2) -- turns a cylinder's axis upright

local rng = Random.new()

local bucketOf = CourseLayout.BucketOf

local function newPart(props): BasePart
	local p = Instance.new(props.ClassName or "Part") :: BasePart
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		if key ~= "ClassName" and key ~= "Parent" then
			(p :: any)[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function cylinderBetween(a: Vector3, b: Vector3): CFrame
	local dir = (b - a).Unit
	local up = if math.abs(dir.Y) > 0.95 then Vector3.xAxis else Vector3.yAxis
	local side = up:Cross(dir).Unit
	return CFrame.fromMatrix((a + b) / 2, dir, dir:Cross(side))
end

local function tntLabel(part: BasePart)
	-- One label on the face that looks back at the slingshot.
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.LightInfluence = 0
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.Parent = part
	Widgets.Label({
		Text = "TNT",
		Size = UDim2.fromScale(1, 0.5),
		Position = UDim2.fromScale(0, 0.25),
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(245, 245, 245),
		TextColor3 = Color3.fromRGB(30, 30, 30),
		StrokeThickness = 0,
		Parent = gui,
	})
end

function Course.new()
	local self = setmetatable({}, Course)
	self.Layout = CourseLayout.Get()
	self.Folder = Instance.new("Folder")
	self.Folder.Name = "LocalCourse"
	self.Folder.Parent = Workspace
	self.Blocks = {} -- [blockId] = entry
	self.BlockList = {}
	self.BlockBuckets = {} -- [bucket] = { entry }
	self.ItemBuckets = {} -- [bucket] = { item }
	self.Items = {} -- every item, for Reset
	self.Stars = {} -- [id] = item
	self.Rings = {}
	self.Pickups = {}
	self.Barriers = {}
	self.Pads = {}
	self.Flung = {}
	self.Flashing = {} -- [entry] = true while a block shows a flash colour
	self.Ready = false
	self.ViewLow = nil
	self.ViewHigh = nil
	self.ViewCenter = 0
	Quality.OnChanged(function()
		self:_applyQuality()
	end)
	return self
end

--------------------------------------------------------------------------------
-- Building
--------------------------------------------------------------------------------

function Course:_buildBlock(data)
	local zone = Config.Zones[data.Zone]
	local size = Config.BlockSize - 0.08
	local part = newPart({
		Name = data.Kind,
		Size = Vector3.new(size, size, size),
		CFrame = CFrame.new(data.Position),
		CanCollide = true,
		CastShadow = Quality.Current.BlockShadows,
	})

	if data.Kind == "Gold" then
		part.Color = Color3.fromRGB(255, 196, 40)
		part.Material = Enum.Material.Neon
	elseif data.Kind == "TNT" then
		part.Color = Color3.fromRGB(220, 40, 40)
		tntLabel(part)
	elseif data.Kind == "Armor" then
		part.Color = Color3.fromRGB(74, 78, 92)
		part.Material = Enum.Material.DiamondPlate
		part.Reflectance = 0.12
	elseif data.Kind == "Ice" then
		part.Color = Color3.fromRGB(176, 226, 255)
		part.Material = Enum.Material.Glass
		part.Transparency = 0.25
		part.Reflectance = 0.15
	else
		local base = zone.BlockColors[data.ColorIndex] or zone.BlockColors[1]
		-- Deterministic per-block shade so walls look hand-built.
		local shade = ((data.Id * 37) % 11 - 5) / 60
		part.Color = if shade >= 0 then Widgets.Lighten(base, shade) else Widgets.Darken(base, -shade)
		part.Material = zone.BlockMaterial
	end

	local entry = {
		Data = data,
		Part = part,
		CFrame = part.CFrame,
		Color = part.Color,
		Transparency = part.Transparency,
		Broken = false,
		Hidden = false,
		Bucket = bucketOf(-data.Position.Z),
	}
	self.Blocks[data.Id] = entry
	table.insert(self.BlockList, entry)
	local list = self.BlockBuckets[entry.Bucket]
	if not list then
		list = {}
		self.BlockBuckets[entry.Bucket] = list
	end
	table.insert(list, entry)
end

-- Registers an item (a Model or Part) to be shown when its spot is in view.
function Course:_addItem(kind: string, instance: Instance, position: Vector3, extra: { [string]: any }?)
	local item = extra or {}
	item.Kind = kind
	item.Instance = instance
	item.Position = position
	item.Hidden = false
	item.Bucket = bucketOf(-position.Z)
	local list = self.ItemBuckets[item.Bucket]
	if not list then
		list = {}
		self.ItemBuckets[item.Bucket] = list
	end
	table.insert(list, item)
	table.insert(self.Items, item)
	return item
end

function Course:_buildStar(data)
	local ball = newPart({
		Name = "Star",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(3, 3, 3),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 214, 40),
		CFrame = CFrame.new(data.Position),
	})
	local billboard = Widgets.new("BillboardGui", {
		Size = UDim2.new(8, 0, 8, 0),
		LightInfluence = 0,
		MaxDistance = 400,
		Parent = ball,
	})
	Widgets.Label({ Text = "⭐", Size = UDim2.fromScale(1, 1), StrokeThickness = 0, Parent = billboard })
	self.Stars[data.Id] = self:_addItem("Star", ball, data.Position, { Part = ball })
end

function Course:_buildRing(data)
	local model = Instance.new("Model")
	model.Name = if data.Big then "Gate" else "Ring"
	local radius = if data.Big then Config.BigRingRadius else Config.RingRadius
	local count = if data.Big then 18 else 14
	local chord = 2 * radius * math.sin(math.pi / count) + 0.4
	local segments = {}
	for i = 1, count do
		local angle = (i / count) * math.pi * 2
		local color = if data.Big
			then (if i % 2 == 0 then Color3.fromRGB(255, 60, 200) else Color3.fromRGB(0, 230, 255))
			else Color3.fromRGB(0, 230, 255)
		local segment = newPart({
			Name = "RingSegment",
			Material = Enum.Material.Neon,
			Color = color,
			Size = Vector3.new(1.2, chord, 1.2),
			CFrame = CFrame.new(data.Position + Vector3.new(math.cos(angle) * radius, math.sin(angle) * radius, 0)) * CFrame.Angles(0, 0, angle),
			Parent = model,
		})
		table.insert(segments, { Part = segment, Color = color })
	end
	self.Rings[data.Id] = self:_addItem("Ring", model, data.Position, { Segments = segments })
end

function Course:_buildPickup(data)
	local ability = Config.Abilities[data.Kind]
	local model = Instance.new("Model")
	model.Name = "PowerUp_" .. data.Kind
	local core = newPart({
		Name = "Core",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(2.6, 2.6, 2.6),
		Material = Enum.Material.Neon,
		Color = ability.Color,
		CFrame = CFrame.new(data.Position),
		Parent = model,
	})
	local shell = newPart({
		Name = "Shell",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(5.4, 5.4, 5.4),
		Material = Enum.Material.ForceField,
		Color = ability.Color,
		CFrame = CFrame.new(data.Position),
		Parent = model,
	})
	local light = Instance.new("PointLight")
	light.Color = ability.Color
	light.Range = 12
	light.Brightness = 2
	light.Parent = core
	local billboard = Widgets.new("BillboardGui", {
		Size = UDim2.new(5, 0, 5, 0),
		StudsOffsetWorldSpace = Vector3.new(0, 4.5, 0),
		LightInfluence = 0,
		MaxDistance = 260,
		Parent = core,
	})
	Widgets.Label({ Text = ability.Icon, Size = UDim2.fromScale(1, 1), StrokeThickness = 0, Parent = billboard })
	self.Pickups[data.Id] = self:_addItem("Pickup", model, data.Position, { Core = core, Shell = shell, Phase = rng:NextNumber(0, 6) })
end

function Course:_buildBarrier(data)
	local model = Instance.new("Model")
	model.Name = "LaserBarrier"
	local base = data.Position
	local wall = newPart({
		Name = "Wall",
		Size = Vector3.new(data.Width, data.Height, 0.3),
		CFrame = CFrame.new(base + Vector3.new(0, data.Height / 2, 0)),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 40, 70),
		Transparency = 0.6,
		Parent = model,
	})
	local lines = {}
	for i = 1, 3 do
		table.insert(lines, newPart({
			Name = "Laser",
			Size = Vector3.new(data.Width, 0.25, 0.25),
			CFrame = CFrame.new(base + Vector3.new(0, data.Height * i / 4, 0)),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 120, 140),
			Parent = model,
		}))
	end
	for _, side in { -1, 1 } do
		newPart({
			Name = "Post",
			Size = Vector3.new(1.2, data.Height + 1.5, 1.2),
			CFrame = CFrame.new(base + Vector3.new(side * data.Width / 2, (data.Height + 1.5) / 2, 0)),
			Material = Enum.Material.Metal,
			Color = Color3.fromRGB(40, 40, 52),
			CastShadow = true,
			Parent = model,
		})
	end
	self.Barriers[data.Id] = self:_addItem("Barrier", model, base, { Wall = wall, Lines = lines, Data = data, Down = false })
end

function Course:_buildLog(data)
	local model = Instance.new("Model")
	model.Name = "SwingingLog"
	local pivot = data.Pivot
	local wood = Color3.fromRGB(110, 76, 50)
	local frameX = Config.LaneWidth / 2 + 3
	newPart({
		Name = "Crossbar",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(frameX * 2 + 2, 1.8, 1.8),
		CFrame = CFrame.new(0, pivot.Y + 0.9, pivot.Z),
		Material = Enum.Material.Wood,
		Color = wood,
		CastShadow = true,
		Parent = model,
	})
	for _, side in { -1, 1 } do
		newPart({
			Name = "Post",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(pivot.Y + 1, 2, 2),
			CFrame = CFrame.new(side * frameX, (pivot.Y + 1) / 2, pivot.Z) * UP,
			Material = Enum.Material.Wood,
			Color = wood,
			CastShadow = true,
			Parent = model,
		})
	end
	local rope = newPart({
		Name = "Rope",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(data.Length, 0.5, 0.5),
		Material = Enum.Material.Fabric,
		Color = Color3.fromRGB(200, 170, 110),
		Parent = model,
	})
	local log = newPart({
		Name = "Log",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(8, H.Log.Radius * 2, H.Log.Radius * 2),
		Material = Enum.Material.Wood,
		Color = Color3.fromRGB(130, 90, 56),
		CastShadow = true,
		Parent = model,
	})
	local item = self:_addItem("Log", model, pivot, { Data = data, Rope = rope, Log = log })
	self:_poseLog(item, 0)
end

function Course:_poseLog(item, t: number)
	local data = item.Data
	local angle = CourseLayout.LogAngle(data, t)
	local head = CourseLayout.LogHead(data, t)
	item.Rope.CFrame = cylinderBetween(data.Pivot, head)
	-- The log lies front-to-back so it sweeps across the lane.
	item.Log.CFrame = CFrame.new(head) * CFrame.Angles(0, 0, angle) * CFrame.Angles(0, math.pi / 2, 0)
end

function Course:_buildGeyser(data)
	local model = Instance.new("Model")
	model.Name = "Geyser"
	local base = data.Position
	newPart({
		Name = "Rim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.4, H.Geyser.Radius * 2 + 2, H.Geyser.Radius * 2 + 2),
		CFrame = CFrame.new(base + Vector3.new(0, 0.5, 0)) * UP,
		Material = Enum.Material.Basalt,
		Color = Color3.fromRGB(46, 40, 42),
		Parent = model,
	})
	local pool = newPart({
		Name = "Pool",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, H.Geyser.Radius * 2 - 1, H.Geyser.Radius * 2 - 1),
		CFrame = CFrame.new(base + Vector3.new(0, 1.15, 0)) * UP,
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 120, 30),
		Parent = model,
	})
	local column = newPart({
		Name = "Column",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1, 7, 7),
		CFrame = CFrame.new(base) * UP,
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 150, 50),
		Transparency = 1,
		Parent = model,
	})
	local fire = Instance.new("Fire")
	fire.Size = 3
	fire.Heat = 6
	fire.Color = Color3.fromRGB(255, 140, 40)
	fire.SecondaryColor = Color3.fromRGB(255, 50, 20)
	fire.Parent = pool
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 120, 40)
	light.Range = 16
	light.Brightness = 1
	light.Parent = pool
	self:_addItem("Geyser", model, base, { Data = data, Column = column, Fire = fire, Light = light })
end

function Course:_buildUpdraft(data)
	local model = Instance.new("Model")
	model.Name = "Updraft"
	local base = data.Position
	local disc = newPart({
		Name = "Base",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, H.Updraft.Radius * 2, H.Updraft.Radius * 2),
		CFrame = CFrame.new(base + Vector3.new(0, 0.2, 0)) * UP,
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(150, 230, 255),
		Transparency = 0.4,
		Parent = model,
	})
	newPart({
		Name = "Column",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(H.Updraft.Height, H.Updraft.Radius * 2, H.Updraft.Radius * 2),
		CFrame = CFrame.new(base + Vector3.new(0, H.Updraft.Height / 2, 0)) * UP,
		Material = Enum.Material.Glass,
		Color = Color3.fromRGB(200, 240, 255),
		Transparency = 0.88,
		Parent = model,
	})
	local streaks = Instance.new("ParticleEmitter")
	streaks.Rate = 14
	streaks.Lifetime = NumberRange.new(1.8, 2.4)
	streaks.Speed = NumberRange.new(34, 44)
	streaks.EmissionDirection = Enum.NormalId.Right -- the base's axis points up
	streaks.Orientation = Enum.ParticleOrientation.VelocityParallel
	streaks.Squash = NumberSequence.new(-1.5)
	streaks.Size = NumberSequence.new(0.5, 0.2)
	streaks.Transparency = NumberSequence.new(0.3, 1)
	streaks.Color = ColorSequence.new(Color3.fromRGB(230, 250, 255))
	streaks.LightEmission = 0.5
	streaks.Parent = disc
	self:_addItem("Updraft", model, base, {})
end

function Course:_buildPad(data)
	local model = Instance.new("Model")
	model.Name = "BouncePad"
	local base = data.Position
	newPart({
		Name = "Rim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, H.Pad.Radius * 2 + 1, H.Pad.Radius * 2 + 1),
		CFrame = CFrame.new(base + Vector3.new(0, 0.3, 0)) * UP,
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(50, 52, 64),
		Parent = model,
	})
	local top = newPart({
		Name = "Top",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, H.Pad.Radius * 2 - 1, H.Pad.Radius * 2 - 1),
		CFrame = CFrame.new(base + Vector3.new(0, 0.6, 0)) * UP,
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(120, 255, 120),
		Parent = model,
	})
	for _, side in { -1, 1 } do
		newPart({
			Name = "Arrow",
			Size = Vector3.new(0.4, 0.2, 3.2),
			CFrame = CFrame.new(base + Vector3.new(side * 1, 0.9, 0)) * CFrame.Angles(0, side * math.rad(35), 0),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 255, 255),
			Parent = model,
		})
	end
	self.Pads[data.Id] = self:_addItem("Pad", model, base, { Top = top, BouncedAt = -10, Base = base })
end

-- Builds everything, yielding now and then so joining doesn't hitch.
function Course:Build()
	local layout = self.Layout
	for index, data in layout.Blocks do
		self:_buildBlock(data)
		if index % 300 == 0 then
			task.wait()
		end
	end
	for _, data in layout.Stars do
		self:_buildStar(data)
	end
	for _, data in layout.Rings do
		self:_buildRing(data)
	end
	for _, data in layout.Pickups do
		self:_buildPickup(data)
	end
	for _, data in layout.Barriers do
		self:_buildBarrier(data)
	end
	for _, data in layout.Logs do
		self:_buildLog(data)
	end
	for _, data in layout.Geysers do
		self:_buildGeyser(data)
	end
	for _, data in layout.Updrafts do
		self:_buildUpdraft(data)
	end
	for _, data in layout.Pads do
		self:_buildPad(data)
	end
	self.Ready = true
	self:SetView(self.ViewCenter)
end

--------------------------------------------------------------------------------
-- View window
--------------------------------------------------------------------------------

function Course:_setBucketVisible(b: number, visible: boolean)
	local parent = if visible then self.Folder else nil
	local blocks = self.BlockBuckets[b]
	if blocks then
		for _, entry in blocks do
			if not entry.Hidden then
				entry.Part.Parent = parent
			end
		end
	end
	local items = self.ItemBuckets[b]
	if items then
		for _, item in items do
			if not item.Hidden then
				item.Instance.Parent = parent
			end
		end
	end
end

function Course:_inView(b: number): boolean
	return self.ViewLow ~= nil and b >= self.ViewLow and b <= self.ViewHigh
end

-- Shows the course from a little behind `distance` to well ahead of it.
function Course:SetView(distance: number)
	self.ViewCenter = distance
	if not self.Ready then
		return
	end
	local q = Quality.Current
	local low = bucketOf(distance - q.ViewBehind)
	local high = bucketOf(distance + q.ViewAhead)
	if low == self.ViewLow and high == self.ViewHigh then
		return
	end
	local oldLow, oldHigh = self.ViewLow, self.ViewHigh
	if oldLow then
		for b = oldLow, oldHigh do
			if b < low or b > high then
				self:_setBucketVisible(b, false)
			end
		end
	end
	for b = low, high do
		if not oldLow or b < oldLow or b > oldHigh then
			self:_setBucketVisible(b, true)
		end
	end
	self.ViewLow, self.ViewHigh = low, high
end

function Course:_applyQuality()
	local shadows = Quality.Current.BlockShadows
	for _, entry in self.BlockList do
		if not entry.Broken then
			entry.Part.CastShadow = shadows
		end
	end
	if self.Ready and self.ViewLow then
		-- Clear the old window, then let SetView draw it at the new distance.
		for b = self.ViewLow, self.ViewHigh do
			self:_setBucketVisible(b, false)
		end
		self.ViewLow, self.ViewHigh = nil, nil
		self:SetView(self.ViewCenter)
	end
end

--------------------------------------------------------------------------------
-- Reacting to RunSim events
--------------------------------------------------------------------------------

function Course:_hideBlock(entry)
	entry.Hidden = true
	entry.Part.Parent = nil
end

-- Flings a smashed block. Returns false when the debris budget was full and
-- the block simply vanished instead.
function Course:Smash(data, velocity: Vector3): boolean
	local entry = self.Blocks[data.Id]
	if not entry or entry.Broken then
		return false
	end
	entry.Broken = true
	local part = entry.Part
	if part.Parent == nil or #self.Flung >= Quality.Current.MaxDebris then
		self:_hideBlock(entry)
		return false
	end
	part.CollisionGroup = "Debris"
	part.CastShadow = false
	part.Anchored = false
	part.AssemblyLinearVelocity = velocity * 0.55
		+ Vector3.new(rng:NextNumber(-18, 18), rng:NextNumber(14, 36), rng:NextNumber(-12, 12))
	part.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-12, 12), rng:NextNumber(-12, 12), rng:NextNumber(-12, 12))
	table.insert(self.Flung, { Entry = entry, Time = os.clock() })
	return true
end

-- Brief colour flash on a block (armor bonks and phasing).
function Course:FlashBlock(data, color: Color3, transparency: number?)
	local entry = self.Blocks[data.Id]
	if not entry or entry.Broken then
		return
	end
	entry.Part.Color = color
	entry.Part.Transparency = transparency or entry.Transparency
	entry.FlashUntil = os.clock() + 0.18
	self.Flashing[entry] = true
end

function Course:CollectStar(id: number)
	local item = self.Stars[id]
	if item then
		item.Hidden = true
		item.Instance.Parent = nil
	end
end

function Course:UseRing(id: number)
	local item = self.Rings[id]
	if item then
		for _, segment in item.Segments do
			segment.Part.Color = Color3.fromRGB(255, 220, 60)
			segment.Part.Transparency = 0.6
		end
	end
end

function Course:TakePickup(id: number)
	local item = self.Pickups[id]
	if item then
		item.Hidden = true
		item.Instance.Parent = nil
	end
end

function Course:HitBarrier(id: number, phased: boolean)
	local item = self.Barriers[id]
	if not item then
		return
	end
	item.Down = true
	item.Wall.Color = if phased then Color3.fromRGB(120, 255, 255) else Color3.fromRGB(90, 20, 30)
	item.Wall.Transparency = 0.85
	for _, line in item.Lines do
		line.Transparency = 1
	end
end

function Course:BouncePad(id: number)
	local item = self.Pads[id]
	if item then
		item.BouncedAt = os.clock()
	end
end

--------------------------------------------------------------------------------
-- Per-frame animation
--------------------------------------------------------------------------------

-- t is the hazard clock: the launch's RunSim time while flying, so what you
-- see matches what you hit.
function Course:Update(_dt: number, focus: Vector3?, t: number)
	local now = os.clock()
	local debrisTime = Quality.Current.DebrisTime
	for i = #self.Flung, 1, -1 do
		local flung = self.Flung[i]
		if now - flung.Time > debrisTime then
			local part = flung.Entry.Part
			part.Anchored = true
			self:_hideBlock(flung.Entry)
			table.remove(self.Flung, i)
		end
	end

	if focus then
		self:SetView(math.max(0, -focus.Z))
	end
	if not self.ViewLow then
		return
	end

	-- Only the few flashing blocks are checked, not every block in view.
	for entry in self.Flashing do
		if now > (entry.FlashUntil or 0) then
			self.Flashing[entry] = nil
			entry.FlashUntil = nil
			if not entry.Broken then
				entry.Part.Color = entry.Color
				entry.Part.Transparency = entry.Transparency
			end
		end
	end

	local bob = math.sin(now * 3)
	for b = self.ViewLow, self.ViewHigh do
		local items = self.ItemBuckets[b]
		if items then
			for _, item in items do
				if not item.Hidden then
					self:_animate(item, t, now, bob)
				end
			end
		end
	end
end

function Course:_animate(item, t: number, now: number, bob: number)
	local kind = item.Kind
	if kind == "Star" then
		item.Part.CFrame = CFrame.new(item.Position + Vector3.new(0, bob * 0.8, 0))
	elseif kind == "Pickup" then
		local offset = Vector3.new(0, math.sin(now * 2.4 + item.Phase) * 0.9, 0)
		local spin = CFrame.Angles(0, now * 1.6 + item.Phase, 0)
		item.Core.CFrame = CFrame.new(item.Position + offset) * spin
		item.Shell.CFrame = CFrame.new(item.Position + offset) * spin:Inverse()
	elseif kind == "Log" then
		self:_poseLog(item, t)
	elseif kind == "Geyser" then
		local active, progress = CourseLayout.GeyserState(item.Data, t)
		local column = item.Column
		if active then
			-- Shoots up fast, then thins out.
			local height = H.Geyser.Height * math.min(1, progress * 4)
			column.Size = Vector3.new(math.max(1, height), 7 - progress * 2, 7 - progress * 2)
			column.CFrame = CFrame.new(item.Position + Vector3.new(0, height / 2, 0)) * UP
			column.Transparency = 0.35 + progress * 0.4
			item.Fire.Size = 22
			item.Fire.Heat = 25
			item.Light.Brightness = 4
		else
			-- Bubbling, and a warning flare just before it erupts.
			local phase = (t + item.Data.Offset) % item.Data.Period
			local warning = phase > item.Data.Period - 0.6
			column.Transparency = 1
			item.Fire.Size = if warning then 9 else 3
			item.Fire.Heat = if warning then 14 else 6
			item.Light.Brightness = if warning then 2.5 else 1
		end
	elseif kind == "Barrier" then
		if not item.Down then
			item.Wall.Transparency = 0.55 + 0.12 * math.sin(now * 23 + item.Position.X)
		end
	elseif kind == "Pad" then
		local since = now - item.BouncedAt
		local squash = if since < 0.35 then math.sin(since / 0.35 * math.pi) * 0.5 else 0
		local glow = 0.5 + 0.5 * math.sin(now * 5 + item.Position.X)
		item.Top.Color = Color3.fromRGB(120, 255, 120):Lerp(Color3.fromRGB(240, 255, 140), glow)
		item.Top.CFrame = CFrame.new(item.Base + Vector3.new(0, 0.6 - squash * 0.4, 0)) * UP
	end
end

--------------------------------------------------------------------------------
-- Reset for the next launch
--------------------------------------------------------------------------------

function Course:Reset()
	local shadows = Quality.Current.BlockShadows
	for _, entry in self.BlockList do
		if entry.Broken or entry.Hidden or entry.FlashUntil then
			local part = entry.Part
			part.Anchored = true
			part.CFrame = entry.CFrame
			part.Color = entry.Color
			part.Transparency = entry.Transparency
			part.CollisionGroup = "Default"
			part.CastShadow = shadows
			entry.Broken = false
			entry.Hidden = false
			entry.FlashUntil = nil
			part.Parent = if self:_inView(entry.Bucket) then self.Folder else nil
		end
	end
	table.clear(self.Flung)
	table.clear(self.Flashing)

	for _, item in self.Items do
		if item.Hidden then
			item.Hidden = false
			item.Instance.Parent = if self:_inView(item.Bucket) then self.Folder else nil
		end
		if item.Kind == "Ring" then
			for _, segment in item.Segments do
				segment.Part.Color = segment.Color
				segment.Part.Transparency = 0
			end
		elseif item.Kind == "Barrier" then
			item.Down = false
			item.Wall.Color = Color3.fromRGB(255, 40, 70)
			for _, line in item.Lines do
				line.Transparency = 0
			end
		end
	end
end

return Course
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--[[
	Client-only juice: sound, camera shake, speed lines, flashes, floating
	numbers, impacts, shockwave rings, lightning, the slingshot charge-up and
	power-up auras.

	Performance rules:
	  * Everything that repeats is pooled (emitters, rings, lightning bolts,
	    afterimages) and nothing is created per frame.
	  * Amounts and caps come from Quality.Current, so phones and Performance
	    Mode do less work.
	  * Only the sparkle texture every ParticleEmitter ships with is used, plus
	    Roblox's built-in Fire and Smoke objects, so nothing needs uploading.
	Everything respects the player's settings (SFX, Camera Effects, Speed Lines).
]]

local ContentProvider = game:GetService("ContentProvider")
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Quality = require(script.Parent.Quality)
local Widgets = require(script.Parent.Widgets)

local Effects = {}

Effects.Settings = table.clone(Config.DefaultSettings)

local rng = Random.new()
local fxFolder: Folder? = nil

local function folder(): Folder
	if fxFolder and fxFolder.Parent then
		return fxFolder
	end
	local created = Instance.new("Folder")
	created.Name = "SlingFX"
	created.Parent = Workspace
	fxFolder = created
	return created
end

local function fxPart(props): BasePart
	local p = Instance.new(props.ClassName or "Part") :: BasePart
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		if key ~= "ClassName" and key ~= "Parent" then
			(p :: any)[key] = value
		end
	end
	p.Parent = props.Parent or folder()
	return p
end

local function emitter(parent: Instance, props): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Rate = 0
	for key, value in props do
		(e :: any)[key] = value
	end
	e.Parent = parent
	return e
end

local function cameraEffectsOn(): boolean
	return Effects.Settings.CameraShake ~= false
end

--------------------------------------------------------------------------------
-- Sound
--------------------------------------------------------------------------------

-- name = { template, pitch, volume, minGap (seconds between plays) }
local SOUND_EVENTS = {
	Launch = { "Launch", 0.9, 0.8, 0 },
	Smash = { "Smash", 1, 0.45, 0.05 },
	Coin = { "Coin", 1, 0.35, 0.03 },
	Click = { "Click", 1.2, 0.25, 0 },
	Nitro = { "Launch", 1.6, 0.9, 0.1 },
	Boom = { "Smash", 0.42, 1, 0.08 },
	Shatter = { "Splash", 1.7, 0.55, 0.06 },
	Clang = { "Smash", 2.1, 0.6, 0.08 },
	Zap = { "Click", 0.45, 0.7, 0.1 },
	Pickup = { "Coin", 0.75, 0.6, 0.1 },
	PowerDown = { "Coin", 0.5, 0.3, 0.1 },
	Eruption = { "Splash", 0.45, 0.9, 0.2 },
	Pad = { "Launch", 1.9, 0.7, 0.1 },
	Shockwave = { "Smash", 0.32, 1, 0.1 },
	Thud = { "Smash", 0.7, 0.55, 0.1 },
	Victory = { "Coin", 1.25, 0.6, 0 },
	GetUp = { "GetUp", 1, 0.5, 0 },
}

local templates = {} -- [templateName] = Sound
local lastPlayed = {} -- [eventName] = os.clock()
local recentVoices = {} -- start times of sounds in the last half second
local MAX_VOICES = 10
local sfxGroup: SoundGroup? = nil
local wind: Sound? = nil
local music: Sound? = nil
local chargeHum: Sound? = nil

local function makeSound(name: string, id: string, volume: number, looped: boolean?, group: SoundGroup?): Sound?
	if id == "" then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = "Sling_" .. name
	sound.SoundId = id
	sound.Volume = volume
	sound.Looped = looped == true
	sound.SoundGroup = group
	sound.Parent = SoundService
	return sound
end

-- Checks every built-in sound loads; swaps in a fallback (or silence) if not.
local function preloadSounds(list: { Sound })
	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync(list, function(contentId: string, status: Enum.AssetFetchStatus)
				if status == Enum.AssetFetchStatus.Success then
					return
				end
				for name, sound in templates do
					if sound.SoundId == contentId then
						local fallback = Config.SoundFallbacks[name]
						sound.SoundId = fallback or ""
					end
				end
			end)
		end)
	end)
end

-- Plays a named sound event. pitchScale and volumeScale tweak it per call.
function Effects.Play(name: string, pitchScale: number?, volumeScale: number?, priority: boolean?)
	if not Effects.Settings.SFX then
		return
	end
	local event = SOUND_EVENTS[name]
	if not event then
		return
	end
	local template = templates[event[1]]
	if not template or template.SoundId == "" then
		return
	end
	local now = os.clock()
	local gap = event[4]
	if gap > 0 and lastPlayed[name] and now - lastPlayed[name] < gap then
		return
	end
	-- Never stack too many sounds at once (protects ears and phones).
	for i = #recentVoices, 1, -1 do
		if now - recentVoices[i] > 0.5 then
			table.remove(recentVoices, i)
		end
	end
	if #recentVoices >= MAX_VOICES and not priority then
		return
	end
	table.insert(recentVoices, now)
	lastPlayed[name] = now

	local sound = template:Clone()
	sound.PlaybackSpeed = event[2] * (pitchScale or 1)
	sound.Volume = event[3] * (volumeScale or 1)
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, 3)
end

-- Looping wind while flying; louder and higher pitched when fast.
function Effects.SetWind(speedFraction: number)
	if not wind then
		return
	end
	if speedFraction <= 0 or not Effects.Settings.SFX then
		if wind.IsPlaying then
			wind:Stop()
		end
		return
	end
	if not wind.IsPlaying then
		wind:Play()
	end
	wind.Volume = math.clamp(speedFraction, 0, 1) * 0.5
	wind.PlaybackSpeed = 0.8 + math.clamp(speedFraction, 0, 1.5) * 0.5
end

--------------------------------------------------------------------------------
-- Camera shake, flash, speed lines
--------------------------------------------------------------------------------

local shakeAmount = 0
local speedGui: ScreenGui? = nil
local speedLines = {}
local flashFrame: Frame? = nil
local abilityTint: ColorCorrectionEffect? = nil

function Effects.Shake(amount: number)
	if cameraEffectsOn() then
		shakeAmount = math.max(shakeAmount, amount)
	end
end

-- Returns a CFrame offset to multiply onto the camera this frame.
function Effects.ShakeOffset(dt: number): CFrame
	if shakeAmount < 0.01 then
		shakeAmount = 0
		return CFrame.identity
	end
	local a = shakeAmount
	shakeAmount *= math.exp(-9 * dt)
	return CFrame.new(rng:NextNumber(-a, a), rng:NextNumber(-a, a), 0) * CFrame.Angles(0, 0, rng:NextNumber(-a, a) * 0.02)
end

-- intensity 0..1 controls how visible the speed lines are.
function Effects.UpdateSpeedLines(dt: number, intensity: number)
	local gui = speedGui
	if not gui then
		return
	end
	if not Effects.Settings.SpeedLines or intensity <= 0.05 then
		gui.Enabled = false
		return
	end
	gui.Enabled = true
	local active = Quality.Current.SpeedLines
	for index, line in speedLines do
		if index > active then
			line.Frame.Visible = false
			continue
		end
		line.Frame.Visible = true
		line.Radius += dt * line.Speed * (0.6 + intensity * 1.4)
		if line.Radius > 0.9 then
			line.Radius = rng:NextNumber(0.25, 0.45)
			line.Angle = rng:NextNumber(0, math.pi * 2)
		end
		local x = 0.5 + math.cos(line.Angle) * line.Radius * 0.62
		local y = 0.5 + math.sin(line.Angle) * line.Radius * 0.62
		line.Frame.Position = UDim2.fromScale(x, y)
		line.Frame.Rotation = math.deg(line.Angle) + 90
		line.Frame.BackgroundColor3 = line.Color
		line.Frame.BackgroundTransparency = 1 - math.clamp(intensity, 0, 1) * 0.55 * math.clamp((line.Radius - 0.2) * 2, 0, 1)
	end
end

-- Tints the speed lines (cyan for Nitro, orange for Meteor...).
function Effects.SetSpeedLineColor(color: Color3)
	for _, line in speedLines do
		line.Color = color
	end
end

function Effects.HideSpeedLines()
	if speedGui then
		speedGui.Enabled = false
	end
end

function Effects.Flash(color: Color3, strength: number?)
	local frame = flashFrame
	if not frame then
		return
	end
	local s = strength or 0.4
	if not cameraEffectsOn() then
		s *= 0.4
	end
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = 1 - s
	TweenService:Create(frame, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { BackgroundTransparency = 1 }):Play()
end

-- A screen-wide colour grade while a power-up is active.
function Effects.SetAbilityTint(color: Color3?, saturation: number?)
	local tint = abilityTint
	if not tint then
		return
	end
	TweenService:Create(tint, TweenInfo.new(0.3), {
		TintColor = color or Color3.new(1, 1, 1),
		Saturation = saturation or 0,
	}):Play()
end

--------------------------------------------------------------------------------
-- Floating text
--------------------------------------------------------------------------------

local floatingCount = 0
local anchorPart: BasePart? = nil
local function floatAnchor(): BasePart
	if anchorPart and anchorPart.Parent then
		return anchorPart
	end
	local created = fxPart({
		Name = "SlingFloatAnchor",
		Size = Vector3.new(0.2, 0.2, 0.2),
		Transparency = 1,
		CFrame = CFrame.new(),
	})
	anchorPart = created
	return created
end

-- Floating text in the world (e.g. "+1.4K") that rises and fades.
function Effects.FloatText(position: Vector3, text: string, color: Color3, size: number?)
	if floatingCount >= Quality.Current.FloatText then
		return
	end
	floatingCount += 1

	local attachment = Instance.new("Attachment")
	attachment.Position = position
	attachment.Parent = floatAnchor()

	local scale = size or 1
	local billboard = Widgets.new("BillboardGui", {
		Size = UDim2.fromOffset(170 * scale, 54 * scale),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 400,
		Adornee = attachment,
		Parent = attachment,
	})
	local label = Widgets.Label({
		Text = text,
		Size = UDim2.fromScale(1, 1),
		TextColor3 = color,
		StrokeThickness = 3,
		Parent = billboard,
	})

	local info = TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(billboard, info, { StudsOffsetWorldSpace = Vector3.new(0, 6, 0) }):Play()
	local fade = TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(label, fade, { TextTransparency = 1 }):Play()
	local stroke = label:FindFirstChildOfClass("UIStroke")
	if stroke then
		TweenService:Create(stroke, fade, { Transparency = 1 }):Play()
	end

	task.delay(0.95, function()
		floatingCount -= 1
		attachment:Destroy()
	end)
end

--------------------------------------------------------------------------------
-- Particles: coloured chips and material impacts
--------------------------------------------------------------------------------

-- Coloured chips. One emitter per colour key so recolouring never repaints
-- sparks that are already flying.
local burstEmitters = {} -- [key] = { Part, Emitter }
local MAX_BURST_EMITTERS = 32

local function burstEmitter(key: string, color: Color3)
	local existing = burstEmitters[key]
	if existing and existing.Part.Parent then
		return existing
	end
	local count = 0
	for _ in burstEmitters do
		count += 1
	end
	if count >= MAX_BURST_EMITTERS then
		return nil
	end
	local holder = fxPart({ Name = "SlingBurst", Size = Vector3.new(1, 1, 1), Transparency = 1 })
	local e = emitter(holder, {
		Lifetime = NumberRange.new(0.35, 0.7),
		Speed = NumberRange.new(16, 34),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 3,
		Acceleration = Vector3.new(0, -40, 0),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new(0, 0.4),
		LightEmission = 0.7,
		Color = ColorSequence.new(color),
	})
	local entry = { Part = holder, Emitter = e }
	burstEmitters[key] = entry
	return entry
end

function Effects.Burst(position: Vector3, key: string, color: Color3, amount: number)
	local entry = burstEmitter(key, color)
	if not entry then
		return
	end
	entry.Part.CFrame = CFrame.new(position)
	entry.Emitter:Emit(Quality.Amount(amount))
end

